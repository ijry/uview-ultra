				<view class="u-page__tag-item">
					<up-count-to
						:endVal="value"
						color="#909399"
						:fontSize="fontSize"
						:bold="true"
					></up-count-to>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	defineOptions({
		styleIsolation: 'app-and-page'
	})

	import { ref } from 'vue'

	const uCountToRef = ref<ComponentPublicInstance | null>(null)
	const value = ref(3000)
	const startVal1 = ref(300)
	const startVal2 = ref(100.00)
	const endVal = ref(10.55)
	const decimals = ref(2)
	const startVal3 = ref(2000)
	const endVal2 = ref(1542)
	const endVal3 = ref(3000)
	const autoplay = ref(false)
	const color = ref('#FF0000')
	const fontSize = ref(40)

	function start() {
		uCountToRef.value?.$callMethod('start')
	}

	function paused() {
		uCountToRef.value?.$callMethod('stop')
	}

	function resume() {
		uCountToRef.value?.$callMethod('resume')
	}

	function end() {
		console.log('end')
	}
</script>

