<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
	<view class="u-page">
		<view class="u-demo-block">
			<view class="u-demo-block__title">
				<text class="text">演示效果</text>
			</view>
			<view class="u-demo-block__content">
				
				<up-table :align="align" :borderColor="borderColor">
					<up-tr class="up-tr">
						<up-th class="up-th">姓名</up-th>
						<up-th class="up-th">年龄</up-th>
						<up-th class="up-th">籍贯</up-th>
						<up-th class="up-th">性别</up-th>
					</up-tr>
					<up-tr class="up-tr">
						<up-td class="up-td">吕布</up-td>
						<up-td class="up-td">22</up-td>
						<up-td class="up-td">楚河</up-td>
						<up-td class="up-td">男</up-td>
					</up-tr>
					<up-tr class="up-tr">
						<up-td class="up-td">项羽</up-td>
						<up-td class="up-td">28</up-td>
						<up-td class="up-td">汉界</up-td>
						<up-td class="up-td">男</up-td>
					</up-tr>
					<up-tr class="up-tr">
						<up-td class="up-td">木兰</up-td>
						<up-td class="up-td">24</up-td>
						<up-td class="up-td">南国</up-td>
						<up-td class="up-td">女</up-td>
					</up-tr>
				</up-table>
			</view>
		</view>
		<view class="u-demo-block">
			<view class="u-demo-block__content">
				<view class="u-demo-block__title">
					<text class="text">边框颜色</text>
				</view>   
				<up-subsection :list="['gray', 'primary', 'warning']" @change="borderColorChange"></up-subsection>
			</view>
		</view>
		<view class="u-demo-block">
			<view class="u-demo-block__content">
				<view class="u-demo-block__title">
					<text class="text">对齐方式</text>
				</view>
				<up-subsection current="1" :list="['左', '中', '右']" @change="alignChange"></up-subsection>
			</view>
		</view>
	</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	defineOptions({
		styleIsolation: 'app-and-page'
	})

	import { ref } from 'vue'

	const mode = ref(false)
	const borderColor = ref('#e4e7ed')
	const align = ref('center')
	const key = ref(0)

	function modeChange(index: number) {
		// #ifdef MP-WEIXIN
		uni.showToast({
			title: '微信小程序暂不支持单元格合并'
		})
		return
		// #endif
		mode.value = index == 0 ? true : false
		key.value++
	}

	function borderColorChange(index: number) {
		borderColor.value = index == 0 ? '#e4e7ed' : index == 1 ? '#2979ff' : '#ff9900'
	}

	function alignChange(index: number) {
		align.value = index == 0 ? 'left' : index == 1 ? 'center' : 'right'
	}
</script>

<style lang="scss" scoped>
	.wrap {
		padding: 24rpx;
	}
</style>
