  methods: {
    getData() {
      let index = 0;
      this.status = 'loading';
      setTimeout(() => {
        for (let i = 0; i < 10; i++) {
          index = random(0, this.data.length - 1);
          this.list.push({ src: this.data[index].src });
        }
        this.status = 'loadmore';
      }, 1500);
    },
