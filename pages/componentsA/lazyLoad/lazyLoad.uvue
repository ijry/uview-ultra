const LAZY_LOAD_DATA = createLazyLoadData()

export default {
  data() {
    return {
      list: [] as LazyLoadItem[],
      status: 'loadmore'
    };
  },
  onLoad() {
    this.getData();
  },
  onReachBottom() {
    this.getData();
  },
  methods: {
    getData() {
      let index = 0;
      this.status = 'loading';
      setTimeout(() => {
        for (let i = 0; i < 10; i++) {
          index = random(0, LAZY_LOAD_DATA.length - 1);
          this.list.push({ src: LAZY_LOAD_DATA[index].src });
        }
        this.status = 'loadmore';
      }, 1500);
    },
    statusChange(status: string) {
    },
    clickImg(img: string) {
    }
  }
}
