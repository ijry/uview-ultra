			iconUrl: 'https://uview-plus.jiangruyi.com/uview/demo/empty/list.png'
		}, {
			imgName: 'message',
			title: '消息列表为空',
			iconUrl: 'https://uview-plus.jiangruyi.com/uview/demo/empty/message.png'
		}, {
			imgName: 'news',
