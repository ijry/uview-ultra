<template>
	<view class="u-wrap">
		<view class="u-search-box">
			<view class="u-search-inner">
				<up-icon name="search" color="#909399" :size="28"></up-icon>
				<text class="u-search-text">搜索</text>
			</view>
		</view>
		<view class="u-menu-wrap">
			<scroll-view scroll-y scroll-with-animation class="u-tab-view menu-scroll-view" :scroll-top="scrollTop"
			 :scroll-into-view="itemId">
				<view v-for="(item,index) in getTabbar()" :key="index" class="u-tab-item" :class="[current == index ? 'u-tab-item-active' : '']"
				 @tap.stop="swichMenu(index)">
					<text class="u-line-1">{{ getItemName(item) }}</text>
				</view>
			</scroll-view>
			<scroll-view :scroll-top="scrollRightTop" scroll-y scroll-with-animation class="right-box" @scroll="rightScroll">
				<view class="page-view">
					<view class="class-item" :id="'item' + index" v-for="(item , index) in getTabbar()" :key="index">
						<view class="item-title">
							<text>{{ getItemName(item) }}</text>
						</view>
						<view class="item-container">
							<view class="thumb-box" v-for="(item1, index1) in getFoods(item)" :key="index1">
								<image class="item-menu-image" :src="getFoodIcon(item1)" mode=""></image>
								<view class="item-menu-name">{{ getItemName(item1) }}</view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>
	</view>
</template>
<script setup lang="uts">
	defineOptions({
		styleIsolation: 'app-and-page'
	})

	import { getCurrentInstance, nextTick, onBeforeUnmount, ref } from 'vue'
	import { onReady } from '@dcloudio/uni-app'
	import { createClassifyData } from '@/common/classify.data'

	const instance = getCurrentInstance()!.proxy!
	const scrollTop = ref(0)
	const oldScrollTop = ref(0)
	const current = ref(0)
	const menuHeight = ref(0)
	const menuItemHeight = ref(0)
	const itemId = ref('')
	const tabbar = createClassifyData()
	const menuItemPos = ref([] as number[])
	const arr = ref([] as number[])
	const scrollRightTop = ref(0)
	const timer = ref(null as number | null)

	onBeforeUnmount(() => {
		if (timer.value != null) {
			clearTimeout(timer.value)
			timer.value = null
		}
	})

	function getTabbar(): Array<UTSJSONObject> {
		return tabbar as Array<UTSJSONObject>
	}

	function getItemName(item: UTSJSONObject): string {
		return item['name'] as string
	}

	function getFoodIcon(item: UTSJSONObject): string {
		return item['icon'] as string
	}

	function getFoods(item: UTSJSONObject): UTSJSONObject[] {
		return item['foods'] as UTSJSONObject[]
	}

	function setRectValue(dataVal: string, height: number) {
		if (dataVal == 'menuHeight') {
			menuHeight.value = height
		} else if (dataVal == 'menuItemHeight') {
			menuItemHeight.value = height
		}
	}

	function getElRect(elClass: string, dataVal: string): Promise<void> {
		return new Promise((resolve, reject) => {
			const query = uni.createSelectorQuery().in(instance)
			query.select('.' + elClass).fields({
				size: true
			}, (res: any | null) => {
				if (res == null) {
					setTimeout(() => {
						getElRect(elClass, dataVal)
					}, 10)
					return
				}
				const rect = res as UTSJSONObject
				setRectValue(dataVal, rect['height'] as number)
				resolve()
			}).exec()
		})
	}

	async function leftMenuStatus(index: number) {
		current.value = index
		if (menuHeight.value == 0 || menuItemHeight.value == 0) {
			await getElRect('menu-scroll-view', 'menuHeight')
			await getElRect('u-tab-item', 'menuItemHeight')
		}
		scrollTop.value = index * menuItemHeight.value + menuItemHeight.value / 2 - menuHeight.value / 2
	}

	function getMenuItemTop(): Promise<void> {
		return new Promise(resolve => {
			const selectorQuery = uni.createSelectorQuery()
			selectorQuery.selectAll('.class-item').boundingClientRect((rects: any | null) => {
				const rectList = rects as UTSJSONObject[]
				if (rectList.length == 0) {
					setTimeout(() => {
						getMenuItemTop()
					}, 10)
					return
				}
				arr.value = [] as number[]
				rectList.forEach((rect: UTSJSONObject) => {
					arr.value.push((rect['top'] as number) - (rectList[0]['top'] as number))
				})
				resolve()
			}).exec()
		})
	}

	onReady(() => {
		getMenuItemTop()
	})

	async function swichMenu(index: number) {
		if (arr.value.length == 0) {
			await getMenuItemTop()
		}
		if (index == current.value) return
		scrollRightTop.value = oldScrollTop.value
		nextTick(() => {
			scrollRightTop.value = arr.value[index]
			current.value = index
			leftMenuStatus(index)
		})
	}

	async function rightScroll(e: ScrollEvent) {
		oldScrollTop.value = e.detail.scrollTop
		if (arr.value.length == 0) {
			await getMenuItemTop()
		}
		if (timer.value != null) return
		if (menuHeight.value == 0) {
			await getElRect('menu-scroll-view', 'menuHeight')
		}
		timer.value = setTimeout(() => {
			timer.value = null
			const scrollHeight = e.detail.scrollTop + menuHeight.value / 2
			for (let i = 0; i < arr.value.length; i++) {
				const height1 = arr.value[i]
				const height2 = arr.value[i + 1]
				if (height2 == null || scrollHeight >= height1 && scrollHeight < height2) {
					leftMenuStatus(i)
					return
				}
			}
		}, 10) as number
	}
</script>

<style lang="scss" scoped>
	.u-wrap {
		height: 100%;
		/* #ifdef H5 */
		height: 100%;
		/* #endif */
		display: flex;
		flex-direction: column;
	}

	.u-search-box {
		padding: 18rpx 30rpx;
	}

	.u-menu-wrap {
		flex: 1;
		display: flex;
		overflow: hidden;
	}

	.u-search-inner {
		background-color: rgb(234, 234, 234);
		border-radius: 100rpx;
		display: flex;
		align-items: center;
		padding: 10rpx 16rpx;
	}

	.u-search-text {
		font-size: 26rpx;
		color: $u-tips-color;
		margin-left: 10rpx;
	}

	.u-tab-view {
		width: 200rpx;
		height: 100%;
	}

	.u-tab-item {
		height: 110rpx;
		background: #f6f6f6;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 26rpx;
		color: #444;
		font-weight: 400;
		line-height: 1;
	}

	.u-tab-item-active {
		position: relative;
		color: #000;
		font-size: 30rpx;
		font-weight: 600;
		background: #fff;
	}

	.u-tab-view {
		height: 100%;
	}

	.right-box {
		background-color: rgb(250, 250, 250);
	}

	.page-view {
		padding: 16rpx;
	}

	.class-item {
		margin-bottom: 30rpx;
		background-color: #fff;
		padding: 16rpx;
		border-radius: 8rpx;
	}

	.class-item:last-child {
		min-height: 100px;
	}

	.item-title {
		font-size: 26rpx;
		color: $u-main-color;
		font-weight: bold;
	}

	.item-menu-name {
		font-weight: normal;
		font-size: 24rpx;
		color: $u-main-color;
	}

	.item-container {
		display: flex;
		flex-wrap: wrap;
	}

	.thumb-box {
		width: 33.333333%;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		margin-top: 20rpx;
	}

	.item-menu-image {
		width: 120rpx;
		height: 120rpx;
	}
</style>
