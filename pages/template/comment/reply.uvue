<template>
	<view class="wrap">
		<view class="comment">
			<view class="top">
				<view class="left">
					<view class="heart-photo"><image :src="getCommentUrl(comment)" mode=""></image></view>
					<view class="user-info">
						<view class="name">{{ getCommentName(comment) }}</view>
						<view class="date">06-25 13:58</view>
					</view>
				</view>
				<view class="right" :class="{ highlight: isCommentLiked(comment) }">
					{{ getCommentLikeNum(comment) }}
					<up-icon v-if="!isCommentLiked(comment)" name="thumb-up" class="like" color="#9a9a9a" :size="30" @click="getLike()"></up-icon>
					<up-icon v-if="isCommentLiked(comment)" name="thumb-up-fill" class="like" :size="30" @click="getLike()"></up-icon>
				</view>
			</view>
			<view class="content">{{ getCommentContent(comment) }}</view>
		</view>
		<view class="all-reply">
			<view class="all-reply-top">全部回复（{{ getCommentAllReply(comment) }}）</view>
			<view class="item" v-for="(item, index) in commentList" :key="index">
				<view class="comment">
					<view class="top">
						<view class="left">
							<view class="heart-photo"><image :src="getCommentUrl(item)" mode=""></image></view>
							<view class="user-info">
								<view class="name">{{ getCommentName(item) }}</view>
								<view class="date">{{ getCommentDate(item) }}</view>
							</view>
						</view>
						<view class="right"  :class="{ highlight: isCommentLiked(item) }">
							<view class="num">{{ getCommentLikeNum(item) }}</view>
							<up-icon v-if="!isCommentLiked(item)" name="thumb-up" class="like" :size="30" color="#9a9a9a" @click="getLike(index)"></up-icon>
							<up-icon v-if="isCommentLiked(item)" name="thumb-up-fill" class="like" :size="30" @click="getLike(index)"></up-icon>
						</view>
					</view>
					<view class="reply" v-if="hasReply(item)">
						<view class="username">{{ getReplyName(item) }}</view>
						<view class="text">{{ getReplyContent(item) }}</view>
					</view>
					<view class="content">{{ getCommentContent(item) }}</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
defineOptions({
	styleIsolation: 'app-and-page'
})

import { ref } from 'vue'

const commentList = ref([] as UTSJSONObject[])
const comment = ref({} as UTSJSONObject)

function getCommentName(item: UTSJSONObject): string { return item['name'] as string }
function getCommentDate(item: UTSJSONObject): string { return item['date'] as string }
function getCommentContent(item: UTSJSONObject): string { return item['contentText'] as string }
function getCommentUrl(item: UTSJSONObject): string { return item['url'] as string }
function getCommentLikeNum(item: UTSJSONObject): number { return item['likeNum'] as number }
function getCommentAllReply(item: UTSJSONObject): number { return item['allReply'] as number }
function isCommentLiked(item: UTSJSONObject): boolean { return item['isLike'] as boolean }

function getReplyData(item: UTSJSONObject): UTSJSONObject | null {
	return item['reply'] == null ? null : item['reply'] as UTSJSONObject
}

function hasReply(item: UTSJSONObject): boolean { return getReplyData(item) != null }

function getReplyName(item: UTSJSONObject): string {
	const reply = getReplyData(item)
	return reply == null ? '' : reply['name'] as string
}

function getReplyContent(item: UTSJSONObject): string {
	const reply = getReplyData(item)
	return reply == null ? '' : reply['contentStr'] as string
}

function toggleLike(item: UTSJSONObject): void {
	item['isLike'] = !(item['isLike'] as boolean)
	if (item['isLike'] == true) {
		item['likeNum'] = (item['likeNum'] as number) + 1
	} else {
		item['likeNum'] = (item['likeNum'] as number) - 1
	}
}

function getLike(index: number | null = null) {
	if (index != null) {
		toggleLike(commentList.value[index])
	} else {
		toggleLike(comment.value)
	}
}

function getReply() {
	comment.value = {
		id: 1,
		name: '叶轻眉',
		date: '12-25 18:58',
		contentText: '我不信伊朗会没有后续反应，美国肯定会为今天的事情付出代价的',
		url: 'https://cdn.uviewui.com/uview/template/SmilingDog.jpg',
		allReply: 12,
		likeNum: 33,
		isLike: false
	}
	commentList.value = [
		{
			name: '新八几',
			date: '12-25 18:58',
			contentText: '不要乱打广告啊喂！虽然是真的超好用',
			url: 'https://cdn.uviewui.com/uview/template/SmilingDog.jpg',
			likeNum: 33,
			isLike: false,
			reply: {
				name: 'uview',
				contentStr: 'uview是基于uniapp的一个UI框架，代码优美简洁，宇宙超级无敌彩虹旋转好用，用它！'
			}
		},
		{
			name: '叶轻眉1',
			date: '01-25 13:58',
			url: 'https://cdn.uviewui.com/uview/template/SmilingDog.jpg',
			contentText: '我不信伊朗会没有后续反应，美国肯定会为今天的事情付出代价的',
			allReply: 0,
			likeNum: 11,
			isLike: false,
			reply: {
				name: '粘粘',
				contentStr: '今天吃什么，明天吃什么，晚上吃什么，我只是一只小猫咪为什么要烦恼这么多'
			}
		},
		{
			name: '叶轻眉2',
			date: '03-25 13:58',
			contentText: '我不信伊朗会没有后续反应，美国肯定会为今天的事情付出代价的',
			allReply: 2,
			likeNum: 21,
			url: 'https://cdn.uviewui.com/uview/template/SmilingDog.jpg',
			isLike: false,
			reply: {
				name: '豆包',
				contentStr: '想吃冰糖葫芦粘豆包，但没钱5555.........'
			}
		},
		{
			name: '叶轻眉3',
			date: '06-20 13:58',
			contentText: '我不信伊朗会没有后续反应，美国肯定会为今天的事情付出代价的',
			allReply: 0,
			likeNum: 150,
			url: 'https://cdn.uviewui.com/uview/template/SmilingDog.jpg',
			isLike: false
		}
	]
}

onLoad((_options: OnLoadOptions) => {
	getReply()
})
</script>

<style lang="scss" scoped>
