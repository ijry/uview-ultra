<template>
	<up-popup :show="modelValue" mode="bottom" :popup="false"
		:mask="true" :closeable="true" :safe-area-inset-bottom="true"
		close-icon-color="#ffffff" :z-index="uZIndex"
		:maskCloseAble="maskCloseAble" @close="close">
		<up-tabs v-if="modelValue" :list="genTabsList"
			:scrollable="true" :current="tabsIndex" @change="tabsChange" ref="tabs"></up-tabs>
		<view class="area-box">
			<view class="u-flex" :class="{ 'change':isChange }">
				<view class="area-item">
					<view class="u-padding-10 u-bg-gray" style="height: 100%;">
						<scroll-view :scroll-y="true" style="height: 100%">
							<up-cell-group>
								<up-cell v-for="(item,index) in getProvinces()"
									:title="getRegionLabel(item)" :arrow="false"
									:index="index" :key="index"
									@click="provinceChange(index)">
									<template v-slot:right-icon>
										<up-icon v-if="isChooseP&&province===index"
											size="17" name="checkbox-mark"></up-icon>
									</template>
								</up-cell>
							</up-cell-group>
						</scroll-view>
					</view>
				</view>
				<view class="area-item">
					<view class="u-padding-10 u-bg-gray" style="height: 100%;">
						<scroll-view :scroll-y="true" style="height: 100%">
							<up-cell-group v-if="isChooseP">
								<up-cell v-for="(item,index) in getCitys()"
									:title="getRegionLabel(item)" :arrow="false"
									:index="index" :key="index"
									@click="cityChange(index)">
									<template v-slot:right-icon>
										<up-icon v-if="isChooseC&&city===index"
											size="17" name="checkbox-mark"></up-icon>
									</template>
								</up-cell>
							</up-cell-group>
						</scroll-view>
					</view>
				</view>
				<view class="area-item">
					<view class="u-padding-10 u-bg-gray" style="height: 100%;">
						<scroll-view :scroll-y="true" style="height: 100%">
							<up-cell-group v-if="isChooseC">
								<up-cell v-for="(item,index) in getAreas()"
									:title="getRegionLabel(item)" :arrow="false"
									:index="index" :key="index"
									@click="areaChange(index)">
									<template v-slot:right-icon>
										<up-icon v-if="isChooseA&&area===index"
											size="17" name="checkbox-mark"></up-icon>
									</template>
								</up-cell>
							</up-cell-group>
						</scroll-view>
					</view>
				</view>
			</view>
		</view>
	</up-popup>
</template>

<script>
	import { createProvinceData } from "@/common/province";
	import { createCityData } from "@/common/city";
	import { createAreaData } from "@/common/area";
	/**
	 * city-select 省市区级联选择器
	 * @property {String Number} z-index 弹出时的z-index值（默认1075）
	 * @property {Boolean} mask-close-able 是否允许通过点击遮罩关闭Picker（默认true）
	 * @property {String} default-region 默认选中的地区，中文形式
	 * @property {String} default-code 默认选中的地区，编号形式
	 */
	export default {
		name: 'u-city-select',
		props: {
			// 通过双向绑定控制组件的弹出与收起
			modelValue: {
				type: Boolean,
				default: false
			},
			// 默认显示的地区，可传类似["河北省", "秦皇岛市", "北戴河区"]
			defaultRegion: {
				type: Array,
				default(): string[] {
					return [] as string[];
				}
			},
			// 默认显示地区的编码，defaultRegion和areaCode同时存在，areaCode优先，可传类似["13", "1303", "130304"]
			areaCode: {
				type: Array,
				default(): string[] {
					return [] as string[];
				}
			},
			// 是否允许通过点击遮罩关闭Picker
			maskCloseAble: {
				type: Boolean,
				default: true
			},
			// 弹出的z-index值
			zIndex: {
				type: [String, Number],
				default: 0
			}
		},
		data() {
			const provinceList = createProvinceData();
			const cityList = createCityData();
			const areaList = createAreaData();
			return {
				cityValue: "",
				isChooseP: false, //是否已经选择了省
				province: 0, //省级下标
				provinces: provinceList,
				cityData: cityList,
				isChooseC: false, //是否已经选择了市
				city: 0, //市级下标
				citys: cityList[0],
				areaData: areaList,
				isChooseA: false, //是否已经选择了区
				area: 0, //区级下标
				areas: areaList[0][0],
				tabsIndex: 0,
			}
		},
		mounted() {
			this.init();
		},
		computed: {
			isChange(): boolean {
				return this.tabsIndex > 1;
			},
			genTabsList(): UTSJSONObject[] {
				let tabsList = [{
					name: "请选择"
				}] as UTSJSONObject[];
				if (this.isChooseP) {
					console.log(this.province)
					tabsList[0]['name'] = this.getRegionLabel(this.getProvinces()[this.province]);
					tabsList[1] = {
						name: "请选择"
					};
				}
				if (this.isChooseC) {
					tabsList[1]['name'] = this.getRegionLabel(this.getCitys()[this.city]);
					tabsList[2] = {
						name: "请选择"
					};
				}
				if (this.isChooseA) {
					tabsList[2]['name'] = this.getRegionLabel(this.getAreas()[this.area]);
				}
				return tabsList;
			},
			uZIndex(): number {
				// 如果用户有传递z-index值，优先使用
				return this.zIndex != 0 && this.zIndex != '0' ? parseInt(this.zIndex.toString()) : 1075;
			}
		},
		emits: ['city-change'],
		methods: {
			getProvinces(): UTSJSONObject[] {
				return this.provinces as Array<UTSJSONObject>;
			},
			getCitys(): UTSJSONObject[] {
				return this.citys as UTSJSONObject[];
			},
			getAreas(): UTSJSONObject[] {
				return this.areas as UTSJSONObject[];
			},
			getRegionLabel(item: UTSJSONObject): string {
				return item['label'] as string;
			},
			getRegionValue(item: UTSJSONObject): string {
				return item['value'] as string;
			},
			init() {
				const areaCode = this.areaCode as string[];
				const defaultRegion = this.defaultRegion as string[];
				if (areaCode.length == 3) {
					this.setProvince("", areaCode[0]);
					this.setCity("", areaCode[1]);
					this.setArea("", areaCode[2]);
				} else if (defaultRegion.length == 3) {
					this.setProvince(defaultRegion[0], "");
					this.setCity(defaultRegion[1], "");
					this.setArea(defaultRegion[2], "");
				};
			},
			setProvince(label: string = "", value: string = "") {
				const provinceList = this.getProvinces();
				for (let k = 0; k < provinceList.length; k++) {
					const item = provinceList[k];
					if (value != "" ? this.getRegionValue(item) == value : this.getRegionLabel(item) == label) {
						this.provinceChange(k);
					}
				}
			},
			setCity(label: string = "", value: string = "") {
				const cityList = this.getCitys();
				for (let k = 0; k < cityList.length; k++) {
					const item = cityList[k];
					if (value != "" ? this.getRegionValue(item) == value : this.getRegionLabel(item) == label) {
						this.cityChange(k);
					}
				}
			},
			setArea(label: string = "", value: string = "") {
				const areaList = this.getAreas();
				for (let k = 0; k < areaList.length; k++) {
					const item = areaList[k];
					if (value != "" ? this.getRegionValue(item) == value : this.getRegionLabel(item) == label) {
						this.isChooseA = true;
						this.area = k;
					}
				}
			},
			close() {
				this.$emit('update:modelValue', false);
			},
			tabsChange(index: number) {
				this.tabsIndex = index;
			},
			provinceChange(index: number) {
				this.isChooseP = true;
				this.isChooseC = false;
				this.isChooseA = false;
				this.province = index;
				const cityData = this.cityData as Array<Array<UTSJSONObject>>;
				this.citys = cityData[index];
				this.tabsIndex = 1;
			},
			cityChange(index: number) {
				this.isChooseC = true;
				this.isChooseA = false;
				this.city = index;
				const areaData = this.areaData as Array<Array<Array<UTSJSONObject>>>;
				this.areas = areaData[this.province][index];
				this.tabsIndex = 2;
			},
			areaChange(index: number) {
				this.isChooseA = true;
				this.area = index;
				let result = {} as UTSJSONObject;
				result['province'] = this.getProvinces()[this.province];
				result['city'] = this.getCitys()[this.city];
				result['area'] = this.getAreas()[this.area];
				this.$emit('city-change', result);
				this.close();
			}
		}

	}
</script>
<style lang="scss">
	.area-box {
		width: 100%;
		overflow: hidden;
		height: 800rpx;

		.area-item {
			width: 33.3333333%;
			height: 800rpx;
		}
	}
</style>
