<template>
	<view>
		<view class="item" v-for="(res, index) in siteList" :key="getSiteId(res)">
			<view class="top">
				<view class="name">{{ getSiteName(res) }}</view>
				<view class="phone">{{ getSitePhone(res) }}</view>
				<view class="tag">
					<text v-for="(item, index) in getSiteTags(res)" :key="index" :class="{red:isDefaultTag(item)}">{{ getTagText(item) }}</text>
				</view>
			</view>
			<view class="bottom">
				广东省深圳市宝安区 自由路66号
				<up-icon name="edit-pen" :size="40" color="#999999"></up-icon>
			</view>
		</view>
		<view class="addSite" @tap="toAddSite">
			<view class="add">
				<up-icon name="plus" color="#ffffff" class="icon" :size="30"></up-icon>新建收货地址
			</view>
		</view>
	</view>
</template>

<script>
export default {
	data() {
		return {
			siteList: [] as UTSJSONObject[]
		};
	},
	onLoad() {
		this.getData();
	},
	methods: {
		getData() {
			this.siteList = [
				{
					id: 1,
					name: '游X',
					phone: '183****5523',
					tag: [
						{
							tagText: '默认'
						},
						{
							tagText: '家'
						}
					],
					site: '广东省深圳市宝安区 自由路66号'
				},
				{
					id: 2,
					name: '李XX',
					phone: '183****5555',
					tag: [
						{
							tagText: '公司'
						}
					],
					site: '广东省深圳市宝安区 翻身路xx号'
				},
				{
					id: 3,
					name: '王YY',
					phone: '153****5555',
					tag: [] as UTSJSONObject[],
					site: '广东省深圳市宝安区 平安路13号'
				}
			];
		},
		getSiteId(item: UTSJSONObject): number {
			return item['id'] as number;
		},
		getSiteName(item: UTSJSONObject): string {
			return item['name'] as string;
		},
		getSitePhone(item: UTSJSONObject): string {
			return item['phone'] as string;
		},
		getSiteTags(item: UTSJSONObject): UTSJSONObject[] {
			return item['tag'] as UTSJSONObject[];
		},
		getTagText(item: UTSJSONObject): string {
			return item['tagText'] as string;
		},
		isDefaultTag(item: UTSJSONObject): boolean {
			return this.getTagText(item) == '默认';
		},
		toAddSite(){
			uni.navigateTo({
			    url: '/pages/template/address/addSite'
			});
		}
	}
};
</script>

