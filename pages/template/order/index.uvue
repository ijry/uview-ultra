							type: '一打',
							deliveryTime: '口感好',
							price: '120',
							number: 1
						}
					]
				},
				{
					id: 5,
					store: '三星旗舰店',
					deal: '交易成功',
					goodsList: [
						{
							goodsUrl: '//img12.360buyimg.com/n7/jfs/t1/52408/35/3554/78293/5d12e9cfEfd118ba1/ba5995e62cbd747f.jpg!q90.jpg',
							title: '企业微信 中控人脸指纹识别考勤机刷脸机 无线签到异地多店打卡机WX108',
							type: '识别效率高',
							deliveryTime: '使用方便',
							price: '451',
							number: 9
						}
					]
				}
			] as UTSJSONObject[],
			list: [
				{
					name: '待付款'
				},
				{
					name: '待发货'
				},
				{
					name: '待收货'
				},
				{
					name: '待评价',
					count: 12
				}
			] as UTSJSONObject[],
			current: 0,
			swiperCurrent: 0,
			tabsHeight: 0,
			dx: 0,
			loadStatus: ['loadmore','loadmore','loadmore','loadmore'] as string[],
		};
	},
	onLoad() {
		this.getOrderList(0);
		this.getOrderList(1);
		this.getOrderList(3);
	},
	methods: {
		getOrderId(item: UTSJSONObject): string { return item['id'].toString(); },
		getOrderPage(index: number): UTSJSONObject[] {
			if (index == 0) return this.orderPage0;
			if (index == 1) return this.orderPage1;
			if (index == 2) return this.orderPage2;
			return this.orderPage3;
		},
		getOrderStore(item: UTSJSONObject): string { return item['store'] as string; },
		getOrderDeal(item: UTSJSONObject): string { return item['deal'] as string; },
		getGoodsList(item: UTSJSONObject): UTSJSONObject[] { return item['goodsList'] as UTSJSONObject[]; },
		getGoodsUrl(item: UTSJSONObject): string { return item['goodsUrl'] as string; },
		getGoodsTitle(item: UTSJSONObject): string { return item['title'] as string; },
		getGoodsType(item: UTSJSONObject): string { return item['type'] as string; },
		getGoodsDeliveryTime(item: UTSJSONObject): string { return item['deliveryTime'] as string; },
		getGoodsPrice(item: UTSJSONObject): string { return item['price'] as string; },
		getGoodsNumber(item: UTSJSONObject): number { return item['number'] as number; },
		priceDecimal(val: string): string {
			if (val.indexOf('.') >= 0) {
				return val.split('.')[1];
			}
			return '00';
		},
		priceInt(val: string): string {
			return val.split('.')[0];
		},
		reachBottom() {
			// 此tab为空数据
			if(this.current != 2) {
				this.loadStatus.splice(this.current,1,"loading")
				setTimeout(() => {
					this.getOrderList(this.current);
				}, 1200);
			}
		},
		// 页面数据
		getOrderList(idx: number) {
			for(let i = 0; i < 5; i++) {
				let index = Math.floor(Math.random() * this.dataList.length);
				let data = JSON.parse<UTSJSONObject>(JSON.stringify(this.dataList[index])) as UTSJSONObject;
				data['id'] = Date.now().toString() + '-' + idx.toString() + '-' + i.toString();
				const target = this.getOrderPage(idx);
				target.push(data);
			}
			this.loadStatus.splice(this.current,1,"loadmore")
		},
		// 总价
		totalPrice(item: UTSJSONObject[]): string {
			let price = 0;
			item.map((val: UTSJSONObject) => {
				price += parseFloat(val['price'] as string);
			});
			return price.toFixed(2);
		},
		// 总件数
		totalNum(item: UTSJSONObject[]): number {
			let num = 0;
			item.map((val: UTSJSONObject) => {
				num += val['number'] as number;
			});
			return num;
		},
		// tab栏切换
		change(e: UTSJSONObject) {
			const index = e['index'] as number;
			this.swiperCurrent = index;
			this.getOrderList(index);
		},
		transition(e: SwiperTransitionEvent) {
			// this.$refs.tabs.setDx(dx);
		},
		animationfinish(e: SwiperAnimationFinishEvent) {
			const current = e.detail.current;
			this.swiperCurrent = current;
			this.current = current;
		}
	}
};
</script>

