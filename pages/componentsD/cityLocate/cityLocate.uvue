<template>
  <view class="u-page">
    <!-- #ifdef APP -->
    <scroll-view style="flex:1">
    <!-- #endif -->
    <view class="u-page__item">
      <text class="u-page__item__title" style="margin-top: 0;">基础用法</text>
      <view class="u-page__item__content">
        <up-city-locate
          :currentCity="currentCity"
          locationType="wgs84"
          :indexList="indexList"
          :cityList="cityList"
          @location-success="locationSuccess"
          @select-city="selectCity">
        </up-city-locate>
      </view>
    </view>
    <!-- #ifdef APP -->
    </scroll-view>
    <!-- #endif -->
  </view>
</template>

<script>
export default {
  data() {
    return {
      currentCity: '',
      indexList: ['热', '全'] as Array<string>,
      cityList: [[{
        name: '北京',
        value: 'beijing'
      }, {
        name: '上海',
        value: 'shanghai'
      }, {
        name: '广州',
        value: 'guangzhou'
      }] as Array<UTSJSONObject>, [{
        name: '北京',
        value: 'beijing'
      }, {
        name: '上海',
        value: 'shanghai'
      }, {
        name: '广州',
        value: 'guangzhou'
      }, {
        name: '深圳',
        value: 'shenzhen'
      }, {
        name: '杭州',
        value: 'hangzhou'
      }] as Array<UTSJSONObject>] as Array<Array<UTSJSONObject>>
    };
  },
  methods: {
    locationSuccess(_e: UTSJSONObject): void {
      this.currentCity = '南京';
    },
    selectCity(e: UTSJSONObject): void {
      const city = e['locationCity']
      this.currentCity = city == null ? '' : city.toString()
    }
  }
};
</script>

<style lang="scss" scoped>
  .u-page__item {
      margin-bottom: 15px;
  }
  .u-page__item__title {
      margin-bottom: 10px;
  }
</style>
