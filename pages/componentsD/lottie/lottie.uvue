<template>
	<view class="page">
		<view class="u-page__item">
			<text class="u-page__item__title">Lottie 动画</text>
			<view class="u-page__item__content">
				<view
					class="lottie-stage"
					:style="stageStyle"
				>
					<up-lottie
						ref="lottieRef"
						class="lottie-stage__canvas"
						:animation-data="animationData"
						:content-model="contentModel"
						:loop="loop"
						@statechange="onStateChange"
					/>
				</view>

				<view class="lottie-group">
					<text class="lottie-group__title">填充模式</text>
					<view class="lottie-group__actions">
						<up-button
							v-for="model in contentModels"
							:key="model"
							size="small"
							:type="contentModel == model ? 'primary' : 'info'"
							:plain="contentModel != model"
							:text="model"
							custom-style="margin: 0 8px 8px 0"
							@click="changeContentModel(model)"
						></up-button>
					</view>
				</view>

				<view class="lottie-group">
					<text class="lottie-group__title">播放控制</text>
					<view class="lottie-group__actions">
						<up-button size="small" type="primary" text="播放" custom-style="margin: 0 8px 8px 0" @click="play"></up-button>
						<up-button size="small" text="暂停" custom-style="margin: 0 8px 8px 0" @click="pause"></up-button>
						<up-button size="small" text="恢复" custom-style="margin: 0 8px 8px 0" @click="resume"></up-button>
						<up-button size="small" type="error" text="取消" custom-style="margin: 0 8px 8px 0" @click="cancel"></up-button>
						<up-button
							size="small"
							:type="loop ? 'success' : 'info'"
							:text="loop ? '循环：开' : '循环：关'"
							custom-style="margin: 0 8px 8px 0"
							@click="toggleLoop"
						></up-button>
					</view>
				</view>

				<view class="lottie-group">
					<text class="lottie-group__title">状态日志</text>
					<view class="lottie-log">
						<text
							v-for="(item, index) in stateLog"
							:key="index"
							class="lottie-log__item"
						>{{ item }}</text>
						<text v-if="stateLog.length == 0" class="lottie-log__empty">暂无状态</text>
					</view>
				</view>

				<text class="lottie-note">uni-app x（.uvue）端由原生 canvas 承载 Lottie canvas 渲染器（无 DOM，不走 SVG 渲染器）。若当前端的 canvas 2D 覆盖度不足，会通过 statechange 的 error 类型给出具体缺失的 API 名称，不会静默白屏。H5 / App-Vue / 微信小程序请使用 .vue 实现（SVG 渲染）。</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import loadingData from '@/static/lottie/loading.json'

const lottieRef = ref<any>(null)
const animationData = loadingData as UTSJSONObject
const contentModels: string[] = ['ScaleToFill', 'AspectFill', 'Center']
const contentModel = ref('AspectFill')
const stageSize = ref(300)
const loop = ref(true)
const stateLog = ref<string[]>([])

const stageStyle = (): string => {
	return `width: ${stageSize.value}px; height: ${stageSize.value}px;`
}

function onStateChange(event: any) {
	const detail: any = event != null && event.detail != null ? event.detail : event
	if (detail == null || detail.type == null) return
	const message = detail.message != null ? ` - ${detail.message}` : ''
	const time = new Date().toLocaleTimeString()
	const next: string[] = [`${time}  ${detail.type}${message}`]
	const current = stateLog.value
	for (let i = 0; i < current.length && i < 5; i++) {
		next.push(current[i])
	}
	stateLog.value = next
}

function changeContentModel(model: string) {
	contentModel.value = model
}

function play() {
	if (lottieRef.value != null) lottieRef.value!.$callMethod('playAnimation')
}

function pause() {
	if (lottieRef.value != null) lottieRef.value!.$callMethod('pauseAnimation')
}

function resume() {
	if (lottieRef.value != null) lottieRef.value!.$callMethod('resumeAnimation')
}

function cancel() {
	if (lottieRef.value != null) lottieRef.value!.$callMethod('cancelAnimation')
}

function toggleLoop() {
	loop.value = !loop.value
}
</script>

<style lang="scss" scoped>
	.lottie-stage {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
		overflow: hidden;
		border: 1px dashed #dcdfe6;
		background-color: #f8f8f8;
	}

	.lottie-stage__canvas {
		width: 100%;
		height: 100%;
	}

	.lottie-group {
		margin-top: 20px;
	}

	.lottie-group__title {
		margin-bottom: 10px;
		font-size: 14px;
		color: #303133;
	}

	.lottie-group__actions {
		display: flex;
		flex-wrap: wrap;
	}

	.lottie-log {
		min-height: 120px;
		padding: 12px;
		border-radius: 8px;
		background-color: #f5f6f7;
	}

	.lottie-log__item {
		padding: 2px 0;
		font-size: 12px;
		color: #606266;
	}

	.lottie-log__empty {
		font-size: 12px;
		color: #909399;
	}

	.lottie-note {
		margin-top: 20px;
		font-size: 12px;
		line-height: 1.6;
		color: #909399;
	}
</style>
