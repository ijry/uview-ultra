<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
	<view class="u-page">
		<up-navbar
			title="表单"
			@leftClick="navigateBack"
			safeAreaInsetTop
			fixed
			placeholder
		></up-navbar>
		<view class="u-demo-block">
			<view class="u-demo-block__title">
				<text class="text">基础使用</text>
			</view>
			<view class="u-demo-block__content">
				<!-- 注意，如果需要兼容微信小程序，最好通过setRules方法设置rules规则 -->
				<up-form
					labelPosition="left"
					errorType="message"
					:model="model1"
					:rules="rules"
					ref="formRef1"
				>
					<up-form-item
						label="姓名"
						prop="userInfo.name"
						borderBottom
						ref="item1"
					>
						<up-input
							v-model="model1.userInfo.name"
							border="none"
							placeholder="姓名,只能为中文"
						></up-input>
					</up-form-item>
					<up-form-item
						label="性别"
						prop="userInfo.sex"
						borderBottom
						@click="showSex = true; "
						ref="item1"
					>
						<up-input
							v-model="model1.userInfo.sex"
							disabled
							disabledColor="#ffffff"
							placeholder="请选择性别"
							border="none"
						></up-input>
						<template #right>
							<up-icon
								name="arrow-right"
							></up-icon>
						</template>
					</up-form-item>
					<up-form-item
						label="水果"
						prop="radiovalue1"
						borderBottom
						ref="item2"
					>
						<up-radio-group v-model="model1.radiovalue1">
							<up-radio
								:customStyle="{marginRight: '16px'}"
								v-for="(item, index) in radiolist1"
								:key="index"
								:label="item['name']"
								:name="item['name']"
							>
							</up-radio>
						</up-radio-group>
					</up-form-item>
					<up-form-item
						label="兴趣爱好"
						prop="checkboxValue1"
						borderBottom
						labelWidth="80"
						ref="item3"
					>
						<up-checkbox-group
							v-model="model1.checkboxValue1"
							shape="square"
							@change="change"
						>
							<up-checkbox
								:customStyle="{marginRight: '16px'}"
								v-for="(item, index) in checkboxList1"
								:key="index"
								:label="item['name']"
								:name="item['name']"
							>
							</up-checkbox>
						</up-checkbox-group>
					</up-form-item>
					<up-form-item
						label="简介"
						prop="intro"
						borderBottom
						ref="item3"
					>
						<up-textarea
							placeholder="不低于3个字"
							v-model="model1.intro"
							count
						></up-textarea>
					</up-form-item>
					<up-form-item
						label="住店时间"
						prop="hotel"
						labelWidth="80"
						borderBottom
						@click="zhudian"
					>
						<up-input
							v-model="model1.hotel"
							disabled
							disabledColor="#ffffff"
							placeholder="请选择住店和离店时间"
							border="none"
						></up-input>
						<template #right>
							<up-icon
								name="arrow-right"
							></up-icon>
						</template>
					</up-form-item>
					<up-form-item
						label="验证码"
						prop="code"
						labelWidth="80"
						borderBottom
					>
						<up-input
							v-model="model1.code"
							border="none"
							placeholder="请填写验证码"
						></up-input>
						<up-button
							#right
							@tap="getCode"
							:text="tips"
							type="success"
							size="mini"
							style="flex: 0.5;"
							:disabled="disabled1"
						></up-button>
					</up-form-item>
					<up-form-item
						label="生日"
						prop="userInfo.birthday"
						borderBottom
						@click="showBirthday = true; hideKeyboard()"
						ref="item1"
					>
						<up-input
							v-model="model1.userInfo.birthday"
							disabled
							disabledColor="#ffffff"
							placeholder="请选择生日"
							border="none"
						></up-input>
						<template #right>
							<up-icon
								name="arrow-right"
							></up-icon>
						</template>
					</up-form-item>
				</up-form>
				<up-button
					type="primary"
					text="提交"
					customStyle="margin-top: 50px"
					@click="submit"
				></up-button>
				<up-button
					type="error"
					text="重置"
					customStyle="margin-top: 10px"
					@click="reset"
				></up-button>
				<up-action-sheet
					:show="showSex"
					:actions="actions"
					title="请选择性别"
					description="如果选择保密会报错"
					@close="showSex = false"
					@select="sexSelect"
				>
				</up-action-sheet>
				<up-calendar
					:show="showCalendar"
					mode="range"
					@confirm="calendarConfirm"
					@close="calendarClose"
					startText="住店"
					endText="离店"
					confirmDisabledText="请选择离店日期"
					:formatter="formatter"
				></up-calendar>
				<up-code
					ref="upCodeRef"
					@change="codeChange"
					seconds="20"
					@start="disabled1 = true"
					@end="disabled1 = false"
				></up-code>
				<up-datetime-picker
					:show="showBirthday"
					:value="birthday"
					mode="date"
					closeOnClickOverlay
					@confirm="birthdayConfirm"
					@cancel="birthdayClose"
					@close="birthdayClose"
				></up-datetime-picker>
			</view>
		</view>
	</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="ts">
	defineOptions({
		styleIsolation: 'app-and-page'
	})

	import { ref, reactive, onMounted } from 'vue';
	import { toast, timeFormat } from '@/uni_modules/uview-ultra/libs/function/index.uts'
	import { UPFormRuleItem, UPCalendarMonthsItemDate } from '@/uni_modules/uview-ultra/types/index.uts'
	type UserInfoType = {
		name: string,
		sex: string,
		birthday: string,
	}
	type ModelType = {
		userInfo: UserInfoType,
		radiovalue1: string,
		checkboxValue1: any[],
		intro: string,
		code: string,
		hotel: string
	}
	
	// 响应式数据
	const disabled1 = ref(false);
	const tips = ref('');
	const value = ref('');
	const showCalendar = ref(false);
	const showBirthday = ref(false);
	const showSex = ref(false);
	const birthday = ref(new Date().getTime());
	
	const model1 = reactive<ModelType>({
		userInfo: {
			name: '楼兰',
			sex: '',
			birthday: ''
		},
		radiovalue1: '苹果',
		checkboxValue1: [],
		intro: '',
		code: '',
		hotel: ''
	});
	
	const actions = ref([{
			name: '男',
		},
		{
			name: '女',
		},
		{
			name: '保密',
		},
	]);
	
	const rules = {
		'userInfo.name': [{
			type: 'string',
			required: true,
			message: '请填写姓名',
			trigger: ['blur', 'change']
		}, {
			// 此为同步验证，可以直接返回true或者false，如果是异步验证，稍微不同，见下方说明
			validator: function(rule: UPFormRuleItem, value: any|null, callback: UTSJSONObject[]|string|null|Error) {
				// 调用uiew-plus自带的js验证规则
				// return testChinese(value);
			},
			message: "姓名必须为中文",
			// 触发器可以同时用blur和change，二者之间用英文逗号隔开
			trigger: ["change", "blur"],
		}],
		code: {
			type: 'string',
			required: true,
			len: 4,
			message: '请填写4位验证码',
			trigger: ['blur']
		},
		'userInfo.sex': {
			type: 'string',
			max: 1,
			required: true,
			message: '请选择男或女',
			trigger: ['blur', 'change']
		},
		radiovalue1: {
			type: 'string',
			min: 1,
			max: 2,
			message: '橙子有毒',
			trigger: ['change']
		},
		checkboxValue1: {
			type: 'array',
			min: 2,
			required: true,
			message: '不能太宅，至少选两项',
			trigger: ['change']
		},
		intro: {
			type: 'string',
			min: 3,
			required: true,
			message: '不低于3个字',
			trigger: ['change']
		},
		hotel: {
			type: 'string',
			min: 2,
			required: true,
			message: '请选择住店时间',
			trigger: ['change']
		},
		'userInfo.birthday': {
			type: 'string',
			required: true,
			message: '请选择生日',
			trigger: ['change']
		},
	};
	
	const radiolist1 = ref([{
			name: '苹果',
			disabled: false
		},
		{
			name: '香蕉',
			disabled: false
		},
		{
			name: '毒橙子',
			disabled: false
		}
	]);
	
	const checkboxList1 = ref([{
			name: '羽毛球',
			disabled: false
		},
		{
			name: '跑步',
			disabled: false
		},
		{
			name: '爬山',
			disabled: false
		}
	]);
	
	// 表单引用
	const formRef1 = ref<ComponentPublicInstance | null>(null)
	const upCodeRef = ref<ComponentPublicInstance | null>(null)
	
	// 在组件准备就绪时设置规则
	onMounted(() => {
		(formRef1.value as ComponentPublicInstance)?.$callMethod('setRules', rules)
	});
	
	// 方法定义
	const zhudian = () => {
		showCalendar.value = true
		uni.hideKeyboard()
	};
	
	const navigateBack = () => {
		uni.navigateBack()
	};
	
	const sexSelect = (e: UTSJSONObject) => {
		model1.userInfo.sex = e['name'] as string;
		showSex.value = false;
		(formRef1.value as ComponentPublicInstance)?.$callMethod('validateField','userInfo.sex')
	};
	
	const change = (e: any) => {
		// console.log(e);
	};
	
	const formatter = (day: UPCalendarMonthsItemDate) => {
		const d = new Date()
		let month = d.getMonth() + 1
		const date = d.getDate()
		if (day.month == month && day.day == (date + 3).toString()) {
			day.bottomInfo = '有优惠'
			day.dot = true
		}
		return day
	};
	
	const calendarConfirm = (e: Array<string>) => {
		showCalendar.value = false;
		model1.hotel = `${e[0]} / ${e[e.length - 1]}`;
		(formRef1.value as ComponentPublicInstance)?.$callMethod('validateField', 'hotel')
	};
	
	const codeChange = (text: string) => {
		tips.value = text;
	};
	
	const getCode = () => {
		let upCodeRefIns = upCodeRef.value as ComponentPublicInstance
		if ((upCodeRefIns.$callMethod('canGetCode') as boolean)) {
			// 模拟向后端请求验证码
			uni.showLoading({
				title: '正在获取验证码'
			})
			setTimeout(() => {
				uni.hideLoading();
				// 这里此提示会被this.start()方法中的提示覆盖
				toast('验证码已发送');
				// 通知验证码组件内部开始倒计时
				upCodeRefIns.$callMethod('start')
			}, 2000);
		} else {
			toast('倒计时结束后再发送');
		}
	};
	
	const calendarClose = () => {
		showCalendar.value = false;
		(formRef1.value as ComponentPublicInstance)?.$callMethod('validateField', 'hotel')
	};
	
	const birthdayClose = () => {
		showBirthday.value = false;
		(formRef1.value as ComponentPublicInstance)?.$callMethod('validateField', 'userInfo.birthday')
	};
	
	const birthdayConfirm = (e: UTSJSONObject) => {
		showBirthday.value = false;
		model1.userInfo.birthday = timeFormat(e['value'], 'yyyy-mm-dd');
		(formRef1.value as ComponentPublicInstance)?.$callMethod('validateField', 'userInfo.birthday')
	};
	
	const submit = () => {
		// 如果有错误，会在catch中返回报错信息数组，校验通过则在then中返回true
		const formIns = formRef1.value as ComponentPublicInstance | null;
		console.log('submit-click', formIns != null);
		if (formIns == null) {
			toast('表单未就绪');
			return;
		}
		const validateRes = formIns.$callMethod('validate') as Promise<any>;
		validateRes.then((res: any): void => {
			toast('校验通过');
		}, (errors: any): void => {
			toast('校验失败');
		});
	};
	
	const reset = () => {
		const validateList: string[] = ['userInfo.name', 'userInfo.sex', 'radiovalue1', 'checkboxValue1', 'intro',
		'hotel', 'code', 'userInfo.birthday'];
		(formRef1.value as ComponentPublicInstance)?.$callMethod('resetFields');
		(formRef1.value as ComponentPublicInstance)?.$callMethod('clearValidate');
		setTimeout(()=>{
			(formRef1.value as ComponentPublicInstance)?.$callMethod('clearValidate', validateList);
		},10);
	};
	
	const hideKeyboard = () => {
		uni.hideKeyboard()
	};
</script>

<style lang="scss">

</style>
