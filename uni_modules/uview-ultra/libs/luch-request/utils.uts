'use strict'

// uni-app x (uts) 兼容的通用工具（原 axios/luch-request utils 的 uts 重写）
// 保持导出函数名与语义不变；内部改用 UTSJSONObject / Array.isArray / instanceof 等 uts 支持的写法

export function isArray(val: any | null): boolean {
    return Array.isArray(val)
}

export function isObject(val: any | null): boolean {
    return val != null && typeof val === 'object'
}

export function isDate(val: any | null): boolean {
    return val instanceof Date
}

export function isUndefined(val: any | null): boolean {
    return val == null
}

export function isBoolean(val: any | null): boolean {
    return typeof val === 'boolean'
}

export function isPlainObject(obj: any | null): boolean {
    return obj != null && typeof obj === 'object' && !Array.isArray(obj) && !(obj instanceof Date)
}

// PLACEHOLDER_UTILS
// 遍历数组或 UTSJSONObject，回调签名 (val, key, obj)
export function forEach(obj: any | null, fn: (val: any | null, key: any, obj: any | null) => void): void {
    if (obj == null) {
        return
    }
    if (Array.isArray(obj)) {
        const arr = obj as Array<any>
        for (let i = 0; i < arr.length; i++) {
            fn(arr[i], i, obj)
        }
    } else if (typeof obj === 'object') {
        const o = obj as UTSJSONObject
        UTSJSONObject.keys(o).forEach((key: string) => {
            fn(o[key], key, obj)
        })
    } else {
        fn(obj, 0, obj)
    }
}

// 深合并两个 UTSJSONObject（source 覆盖 target），不保留原引用
export function deepMerge(target: UTSJSONObject, source: UTSJSONObject): UTSJSONObject {
    const result: UTSJSONObject = UTSJSONObject.assign({} as UTSJSONObject, target)
    UTSJSONObject.keys(source).forEach((key: string) => {
        const sv = source[key]
        const rv = result[key]
        const svObj = sv != null && typeof sv === 'object' && !Array.isArray(sv) && !(sv instanceof Date)
        const rvObj = rv != null && typeof rv === 'object' && !Array.isArray(rv) && !(rv instanceof Date)
        if (svObj && rvObj) {
            result[key] = deepMerge(rv as UTSJSONObject, sv as UTSJSONObject)
        } else {
            result[key] = sv
        }
    })
    return result
}
