import { deepMerge, isUndefined } from '../utils'

// 局部优先：局部有则用局部，否则用全局
function mergeKeys(keys: string[], globalsConfig: UTSJSONObject, config2: UTSJSONObject): UTSJSONObject {
    const config: UTSJSONObject = {} as UTSJSONObject
    keys.forEach((prop: string) => {
        if (!isUndefined(config2[prop])) {
            config[prop] = config2[prop]
        } else if (!isUndefined(globalsConfig[prop])) {
            config[prop] = globalsConfig[prop]
        }
    })
    return config
}

// 移除 content-type 头（uts 无 delete 运算符）
function removeContentTypeHeaders(header: UTSJSONObject): UTSJSONObject {
    const newHeader: UTSJSONObject = {} as UTSJSONObject
    UTSJSONObject.keys(header).forEach((key: string) => {
        if (key.toLowerCase() !== 'content-type') {
            newHeader[key] = header[key]
        }
    })
    return newHeader
}

function asObj(v: any | null): UTSJSONObject {
    if (v != null && typeof v === 'object' && !Array.isArray(v)) {
        return v as UTSJSONObject
    }
    return {} as UTSJSONObject
}

// PLACEHOLDER_MERGE
export default function mergeConfig(globalsConfig: UTSJSONObject, config2: UTSJSONObject = {} as UTSJSONObject): UTSJSONObject {
    let method: any | null = config2['method']
    if (method == null) method = globalsConfig['method']
    if (method == null) method = 'GET'
    const ms: string = `${method}`

    const config: UTSJSONObject = {} as UTSJSONObject
    config['baseURL'] = globalsConfig['baseURL'] != null ? globalsConfig['baseURL'] : ''
    config['method'] = method
    config['url'] = config2['url'] != null ? config2['url'] : ''
    config['params'] = config2['params'] != null ? config2['params'] : ({} as UTSJSONObject)
    config['custom'] = UTSJSONObject.assign({} as UTSJSONObject, asObj(globalsConfig['custom']), asObj(config2['custom']))
    config['header'] = deepMerge(asObj(globalsConfig['header']), asObj(config2['header']))

    const defaultToConfig2Keys = ['getTask', 'validateStatus']
    const dc = mergeKeys(defaultToConfig2Keys, globalsConfig, config2)
    UTSJSONObject.keys(dc).forEach((k: string) => { config[k] = dc[k] })

    if (ms === 'DOWNLOAD') {
        // #ifdef H5 || APP-PLUS
        if (!isUndefined(config2['timeout'])) {
            config['timeout'] = config2['timeout']
        } else if (!isUndefined(globalsConfig['timeout'])) {
            config['timeout'] = globalsConfig['timeout']
        }
        // #endif
    } else if (ms === 'UPLOAD') {
        config['header'] = removeContentTypeHeaders(asObj(config['header']))
        const uploadKeys = [
            // #ifdef APP-PLUS || H5
            'files',
            // #endif
            // #ifdef MP-ALIPAY
            'fileType',
            // #endif
            // #ifdef H5
            'file',
            // #endif
            'filePath',
            'name',
            // #ifdef H5 || APP-PLUS
            'timeout',
            // #endif
            'formData'
        ]
        uploadKeys.forEach((prop: string) => {
            if (!isUndefined(config2[prop])) {
                config[prop] = config2[prop]
            }
        })
        // #ifdef H5 || APP-PLUS
        if (isUndefined(config['timeout']) && !isUndefined(globalsConfig['timeout'])) {
            config['timeout'] = globalsConfig['timeout']
        }
        // #endif
    } else {
        const defaultsKeys = [
            'data',
            // #ifdef H5 || APP-PLUS || MP-ALIPAY || MP-WEIXIN
            'timeout',
            // #endif
            'dataType',
            // #ifndef MP-ALIPAY
            'responseType',
            // #endif
            // #ifdef APP-PLUS
            'sslVerify',
            // #endif
            // #ifdef H5
            'withCredentials',
            // #endif
            // #ifdef APP-PLUS
            'firstIpv4'
            // #endif
        ]
        const dk = mergeKeys(defaultsKeys, globalsConfig, config2)
        UTSJSONObject.keys(dk).forEach((k: string) => { config[k] = dk[k] })
    }

    return config
}
