<template>
	<view
		class="up-novel-reader__toolbar"
		:class="'up-novel-reader__toolbar--' + position"
		:style="toolbarStyle"
		@tap.stop="handleToggleControls"
	>
		<view v-if="position == 'top'" class="up-novel-reader__toolbar-row">
			<view class="up-novel-reader__toolbar-group">
				<view v-if="showBack" class="up-novel-reader__toolbar-button" @tap.stop="handleBack">
					<up-icon :name="backIcon" size="21" :color="textColor"></up-icon>
				</view>
				<text class="up-novel-reader__toolbar-title">{{ titleText }}</text>
			</view>
			<view class="up-novel-reader__toolbar-group">
				<slot name="top"></slot>
				<view class="up-novel-reader__toolbar-button" @tap.stop="handleToggleCatalog">
					<up-icon name="list" size="20" :color="textColor"></up-icon>
				</view>
				<view class="up-novel-reader__toolbar-button" @tap.stop="handleToggleBookmark">
					<up-icon name="bookmark" size="20" :color="isBookmarked ? activeColor : textColor" :bold="isBookmarked"></up-icon>
				</view>
				<slot name="toolbar-extra"></slot>
				<view class="up-novel-reader__toolbar-button" @tap.stop="handleToggleControls">
					<up-icon name="close" size="19" :color="textColor"></up-icon>
				</view>
			</view>
		</view>
		<view v-else class="up-novel-reader__toolbar-row up-novel-reader__toolbar-row--bottom">
			<view class="up-novel-reader__progress">
				<text class="up-novel-reader__progress-label">{{ progressLabel }}</text>
				<view class="up-novel-reader__progress-track">
					<view class="up-novel-reader__progress-value" :style="{ width: progressPercent + '%' }"></view>
				</view>
			</view>
			<view class="up-novel-reader__toolbar-group">
				<slot name="bottom"></slot>
				<view class="up-novel-reader__toolbar-button" :class="previousDisabled ? 'is-disabled' : ''" @tap.stop="handlePrevious">
					<up-icon name="arrow-left" size="18" :color="previousDisabled ? disabledColor : textColor"></up-icon>
				</view>
				<view class="up-novel-reader__toolbar-button" :class="nextDisabled ? 'is-disabled' : ''" @tap.stop="handleNext">
					<up-icon name="arrow-right" size="18" :color="nextDisabled ? disabledColor : textColor"></up-icon>
				</view>
				<view class="up-novel-reader__toolbar-button" @tap.stop="handleToggleSettings">
					<up-icon name="setting" size="20" :color="textColor"></up-icon>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'

defineOptions({ styleIsolation: 'app-and-page', name: 'up-novel-reader-toolbar' })

const props = defineProps({
	position: { type: String, default: 'top' },
	title: { type: String, default: '' },
	showBack: { type: Boolean, default: true },
	backIcon: { type: String, default: 'arrow-left' },
	isBookmarked: { type: Boolean, default: false },
	progress: { type: UTSJSONObject, default: () => ({}) },
	pageCount: { type: Number, default: 0 },
	currentChapterIndex: { type: Number, default: -1 },
	chapterCount: { type: Number, default: 0 },
	hasPrevious: { type: Boolean, default: false },
	hasNext: { type: Boolean, default: false },
	themeTokens: { type: UTSJSONObject, default: () => ({}) }
})

const emit = defineEmits(['back', 'toggle-catalog', 'toggle-settings', 'toggle-bookmark', 'previous', 'next', 'toggle-controls'])
const theme = computed((): UTSJSONObject => props.themeTokens == null ? ({} as UTSJSONObject) : props.themeTokens as UTSJSONObject)
const progress = computed((): UTSJSONObject => props.progress == null ? ({} as UTSJSONObject) : props.progress as UTSJSONObject)
const textColor = computed((): string => (theme.value['text'] == null ? '#303133' : theme.value['text']).toString())
const activeColor = computed((): string => (theme.value['active'] == null ? '#2979ff' : theme.value['active']).toString())
const disabledColor = computed((): string => (theme.value['disabled'] == null ? '#c8c9cc' : theme.value['disabled']).toString())
const titleText = computed((): string => props.title.length > 0 ? props.title : '小说阅读')
const pageIndex = computed((): number => {
	const value = progress.value['pageIndex']
	if (value == null) return 0
	const number = parseFloat(value.toString())
	return isNaN(number) ? 0 : number
})
const progressPercent = computed((): number => {
	const chapterProgress = progress.value['chapterProgress']
	if (chapterProgress != null) return Math.min(100, Math.max(0, parseFloat(chapterProgress.toString()) * 100))
	if (props.pageCount > 0) return Math.min(100, Math.max(0, (pageIndex.value + 1) / props.pageCount * 100))
	return 0
})
const progressLabel = computed((): string => {
	const current = props.currentChapterIndex >= 0 ? props.currentChapterIndex + 1 : 0
	const chapterText = props.chapterCount > 0 ? current.toString() + '/' + props.chapterCount.toString() : '阅读进度'
	return chapterText + ' · ' + Math.round(progressPercent.value).toString() + '%'
})
const previousDisabled = computed((): boolean => !props.hasPrevious)
const nextDisabled = computed((): boolean => !props.hasNext)
const toolbarStyle = computed((): UTSJSONObject => {
	return {
		backgroundColor: (theme.value['toolbar'] == null ? '#ffffff' : theme.value['toolbar']).toString(),
		borderColor: (theme.value['border'] == null ? 'rgba(48, 49, 51, 0.12)' : theme.value['border']).toString()
	} as UTSJSONObject
})

const handleBack = (): void => emit('back')
const handleToggleCatalog = (): void => emit('toggle-catalog')
const handleToggleSettings = (): void => emit('toggle-settings')
const handleToggleBookmark = (): void => emit('toggle-bookmark')
const handlePrevious = (): void => { if (!previousDisabled.value) emit('previous') }
const handleNext = (): void => { if (!nextDisabled.value) emit('next') }
const handleToggleControls = (): void => emit('toggle-controls')
</script>

<style lang="scss" scoped>
.up-novel-reader__toolbar { box-sizing: border-box; width: 100%; padding: 10px 14px; border-bottom-width: 1px; border-bottom-style: solid; }
.up-novel-reader__toolbar--bottom { border-top-width: 1px; border-top-style: solid; border-bottom: 0; padding-top: 8px; padding-bottom: 8px; }
.up-novel-reader__toolbar-row { display: flex; align-items: center; justify-content: space-between; min-height: 36px; }
.up-novel-reader__toolbar-row--bottom { gap: 12px; }
.up-novel-reader__toolbar-group { display: flex; align-items: center; min-width: 0; gap: 6px; }
.up-novel-reader__toolbar-title { max-width: 44vw; overflow: hidden; color: inherit; font-size: 16px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.up-novel-reader__toolbar-button { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 18px; }
.up-novel-reader__toolbar-button.is-disabled { opacity: 0.5; }
.up-novel-reader__progress { flex: 1; min-width: 0; }
.up-novel-reader__progress-label { display: block; margin-bottom: 5px; color: inherit; font-size: 11px; line-height: 16px; opacity: 0.78; }
.up-novel-reader__progress-track { width: 100%; height: 3px; overflow: hidden; border-radius: 3px; background-color: rgba(127, 127, 127, 0.22); }
.up-novel-reader__progress-value { height: 100%; border-radius: inherit; background-color: var(--up-novel-reader-active, #2979ff); }
</style>
