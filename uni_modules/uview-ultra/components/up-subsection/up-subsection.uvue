<template>
    <view
        class="up-subsection"
        ref="up-subsection"
        :class="[`up-subsection--${mode}`]"
        :style="rootStyle"
    >
        <view
            class="up-subsection__bar cursor-pointer"
            ref="up-subsection__bar"
            :style="[barStyle]"
            :class="{
				'up-subsection--button__bar': mode === 'button',
				'up-subsection__bar--first': (innerCurrent == 0 && mode === 'subsection'),
				'up-subsection__bar--center': (innerCurrent > 0 && innerCurrent < list.length - 1 && mode === 'subsection'),
				'up-subsection__bar--last': (innerCurrent == list.length - 1 && mode === 'subsection')
			}"
        ></view>
        <view
            class="up-subsection__item cursor-pointer"
	            :class="[
	                `up-subsection__item--${index.toString()}`,
	                index < list.length - 1 ? 
	                    'up-subsection__item--no-border-right' : '',
	                index == 0 ? 'up-subsection__item--first' : '',
	                index == list.length - 1 ? 'up-subsection__item--last' : '',
					disabled ? 'up-subsection__item--disabled' : ''
	            ]"
            :ref="`up-subsection__item--${index.toString()}`"
            :style="[itemStyle(index)]"
            @tap="clickHandler(index)"
            v-for="(item, index) in list"
            :key="index"
        >
				<slot name="item" :item="item" :index="index">
					<text
					    class="up-subsection__item__text"
						:class="[disabled ? 'up-subsection__item__text--disabled' : '']"
					    :style="[textStyle(index)]"
					    >{{ getText(item) }}</text
					>
				</slot>
        </view>
    </view>
</template>

<script setup lang="uts">
import { computed, getCurrentInstance, onBeforeUnmount, onMounted, ref, watch } from 'vue'
import defProps from './subsection.uts'
import { addStyle, addUnit, sleep, upGetRect } from '../../libs/function/index.uts';
/**
 * Subsection 分段器
 * @description 该分段器一般用于用户从几个选项中选择某一个的场景
 * @tutorial https://ijry.github.io/uview-plus/components/subsection.html
 * @property {Array}			list			tab的数据
 * @property {String ｜ Number}	current			当前活动的tab的index（默认 0 ）
 * @property {String}			activeColor		激活时的颜色（默认 '#3c9cff' ）
 * @property {String}			inactiveColor	未激活时的颜色（默认 '#303133' ）
 * @property {String}			mode			模式选择，mode=button为按钮形式，mode=subsection时为分段模式（默认 'button' ）
 * @property {String ｜ Number}	fontSize		字体大小，单位px（默认 12px ）
 * @property {Boolean}			bold			激活选项的字体是否加粗（默认 true ）
 * @property {String}			bgColor			组件背景颜色，mode为button时有效（默认 '#eeeeef' ）
 * @property {Object}			customStyle		定义需要用到的外部样式
 * @property {String}	        keyName	        从`list`元素对象中读取的键名（默认 'name' ）
 *
 * @event {Function} change		分段器选项发生改变时触发  回调 index：选项的index索引值，从0开始
 * @example <up-subsection :list="list" :current="curNow" @change="sectionChange"></up-subsection>
 */
defineOptions({
    name: 'up-subsection'
})

const props = defineProps({
    // tab的数据
    list: {
        type: Array,
        default: defProps.getAny('subsection.list')
    },
    // 当前活动的tab的index
    current: {
        type: [String, Number],
        default: defProps.getAny('subsection.current')
    },
    // 激活的颜色
    activeColor: {
        type: String,
        default: defProps.getString('subsection.activeColor')
    },
    // 未激活的颜色
    inactiveColor: {
        type: String,
        default: defProps.getString('subsection.inactiveColor')
    },
    // 模式选择，mode=button为按钮形式，mode=subsection时为分段模式
    mode: {
        type: String,
        default: defProps.getString('subsection.mode')
    },
    // 字体大小
    fontSize: {
        type: [String, Number],
        default: defProps.getAny('subsection.fontSize')
    },
    // 激活tab的字体是否加粗
    bold: {
        type: Boolean,
        default: defProps.getBoolean('subsection.bold')
    },
    // mode = button时，组件背景颜色
    bgColor: {
        type: String,
        default: defProps.getString('subsection.bgColor')
    },
	// 从list元素对象中读取的键名
	keyName: {
		type: String,
		default: defProps.getString('subsection.keyName')
	},
	// 从list元素对象中读取激活时的颜色  如果存在字段 优先级大于 activeColor
	activeColorKeyName: {
		type: String,
		default: defProps.getString('subsection.activeColorKeyName')
	},
	// 从list元素对象中读取未激活时的颜色 如果存在字段 优先级大于 inactiveColor
	inactiveColorKeyName: {
		type: String,
		default: defProps.getString('subsection.inactiveColorKeyName')
	},
	// 是否禁用
	disabled: {
		type: Boolean,
		default: defProps.getBoolean('subsection.disabled')
	},
    customStyle: {
        type: [Object, String],
        default: () => ({})
    }
})

const emit = defineEmits(['change'])
const instance = getCurrentInstance()!.proxy!
// 组件尺寸
const itemRect = ref({
    width: 0,
    height: 0,
} as NodeInfo)
const innerCurrent = ref(0)
const windowResizeCallback = ref({})

const wrapperStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject;
    // button模式时，设置背景色
    if (props.mode === 'button') {
        style['backgroundColor'] = props.bgColor;
    }
    return style;
})

const rootStyle = computed((): UTSJSONObject => {
    const style = addStyle(props.customStyle) as UTSJSONObject;
    if (props.mode === 'button') {
        style['backgroundColor'] = props.bgColor;
    }
    return style;
})

// 滑块的样式
const barStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject;
    style['width'] = `${itemRect.value['width']}px`;
    style['height'] = `${itemRect.value['height']}px`;
	// 通过translateX移动滑块，其移动的距离为索引*item的宽度
	// #ifndef APP-NVUE
	if (itemRect.value.width != null) {
		style['transform'] = `translateX(${
		    innerCurrent.value * (itemRect.value['width'] as Number)
		}px)`;
	}
	// #endif
    if (props.mode === 'subsection') {
        // 在subsection模式下，需要动态设置滑块的圆角，因为移动滑块使用的是translateX，无法通过父元素设置overflow: hidden隐藏滑块的直角
        style['backgroundColor'] = props.activeColor;
    }
    return style;
})

// 获取组件的尺寸
const getRect = (): void => {
    // #ifndef APP-NVUE
    upGetRect('.up-subsection__item--0', false, instance).then((res: NodeInfo) => {
        itemRect.value = res;
    });
    // #endif
}

const init = async (): Promise<void> => {
    innerCurrent.value = parseInt(props.current.toString())
	await sleep(30);
	getRect();
}

const itemStyle = (_index: number): UTSJSONObject => {
	const style = {} as UTSJSONObject;
	if (props.mode === 'subsection') {
		// 设置border的样式
		style['borderColor'] = props.activeColor;
		style['borderWidth'] = '1px';
		style['borderStyle'] = 'solid';
	}
	return style;
}

const textStyle = (index: number): UTSJSONObject => {
	const style = {} as UTSJSONObject;
	if (props.disabled) {
		style['fontWeight'] = 'normal';
		style['fontSize'] = addUnit(props.fontSize);
		style['color'] = '#c8c9cc';
		return style;
	}
	style['fontWeight'] =
		props.bold && innerCurrent.value === index ? 'bold' : 'normal';
	style['fontSize'] = addUnit(props.fontSize);
	const item = props.list[index];
	const activeColorTemp =
		typeof item == 'object' && item != null
			? ((item as UTSJSONObject)[props.activeColorKeyName] as string)
			: '';
	const inactiveColorTemp =
		typeof item === 'object' && item != null
			? ((item as UTSJSONObject)[props.inactiveColorKeyName] as string)
			: '';
	// subsection模式下，激活时默认为白色的文字
	if (props.mode === 'subsection') {
		style['color'] =
			innerCurrent.value === index ? (activeColorTemp != '' ? activeColorTemp : '#fff') : (inactiveColorTemp != '' ? inactiveColorTemp : props.inactiveColor);
	} else {
		// button模式下，激活时文字颜色默认为activeColor
		style['color'] =
			innerCurrent.value == index
				? (activeColorTemp != '' ? activeColorTemp :  props.activeColor)
				: (inactiveColorTemp != '' ? inactiveColorTemp : props.inactiveColor);
	}
	return style;
}

// 判断展示文本
const getText = (item: any|null): string|null => {
	if (typeof item === 'string') {
		return item;
	} else if (typeof item === 'object') {
		let temp = JSON.parse(JSON.stringify(item)) as UTSJSONObject;
		return temp.getString(props.keyName);
	} else {
		return 'error';
	}
}

const clickHandler = (index: number): void => {
	if (props.disabled) return
    innerCurrent.value = index
    emit('change', index);
}

watch((): any => props.list, () => {
    init();
})

watch((): any => props.current, (n: any) => {
	let nn = parseInt(n.toString())
    if (nn !== innerCurrent.value) {
        innerCurrent.value = nn
    }
}, { immediate: true })

onMounted(() => {
    init();
    // windowResizeCallback.value = (res) => {
    //     init();
    // }
    // uni.onWindowResize(windowResizeCallback.value)
})

onBeforeUnmount(() => {
    // uni.offWindowResize(windowResizeCallback.value)
})

defineExpose({
    itemRect,
    innerCurrent,
    windowResizeCallback,
    wrapperStyle,
    rootStyle,
    barStyle,
    init,
	itemStyle,
	textStyle,
	getText,
    getRect,
    clickHandler
})
</script>

<style lang="scss" scoped>
@import "../../libs/css/components.scss";

.up-subsection {
    @include flex;
    position: relative;
    overflow: hidden;
	/* #ifndef APP-NVUE */
	width: 100%;
	box-sizing: border-box;
	/* #endif */

    &--button {
        height: 34px;
        background-color: rgb(238, 238, 239);
        padding: 3px;
        border-radius: 4px;
        align-items: stretch;

        &__bar {
            background-color: #ffffff;
            border-radius: 4px !important;
        }
    }

    &--subsection {
        height: 32px;
    }

    &__bar {
        position: absolute;
        /* #ifndef APP-NVUE */
        transition-property: transform, color;
        transition-duration: 0.3s;
        transition-timing-function: ease-in-out;
        /* #endif */

        &--first {
            border-top-left-radius: 4px;
            border-bottom-left-radius: 4px;
            border-top-right-radius: 0px;
            border-bottom-right-radius: 0px;
        }

        &--center {
            border-top-left-radius: 0px;
            border-bottom-left-radius: 0px;
            border-top-right-radius: 0px;
            border-bottom-right-radius: 0px;
        }

        &--last {
            border-top-left-radius: 0px;
            border-bottom-left-radius: 0px;
            border-top-right-radius: 4px;
            border-bottom-right-radius: 4px;
        }
    }

    &__item {
        @include flex;
        flex: 1;
        justify-content: center;
        align-items: center;
        // vue环境下，需要设置相对定位，因为滑块为绝对定位，item需要在滑块的上面
        position: relative;

        &--no-border-right {
            border-right-width: 0 !important;
        }

        &--first {
            border-top-left-radius: 4px;
            border-bottom-left-radius: 4px;
        }

	        &--last {
	            border-top-right-radius: 4px;
	            border-bottom-right-radius: 4px;
	        }

			&--disabled {
			}

	        &__text {
	            font-size: 12px;
	            line-height: 14px;
	            // @include flex;
	            // align-items: center;
	            transition-property: color;
	            transition-duration: 0.3s;

				&--disabled {
					color: #c8c9cc !important;
				}
	        }
	    }
	}
</style>
