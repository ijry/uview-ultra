<template>
    <view
        class="up-text"
        :class="[customClass]"
        v-if="show"
        :style="rootStyle"
        @tap="clickHandler"
    >
        <text
            :class="['up-text__price', `up-text__value--${type}`]"
            v-if="mode === 'price'"
            :style="[valueStyle]"
            >￥</text
        >
        <view class="up-text__prefix-icon" v-if="prefixIcon">
            <up-icon
                :name="prefixIcon"
                :customStyle="iconCustomStyle"
            ></up-icon>
        </view>
        <up-link
            v-if="mode === 'link'" class="up-text__value"
            :style="linkStyle"
            :class="[`up-text__value--${type}`,	`up-line-${lines}`]" :text="value"
            :href="href"
            underLine
        ></up-link>
        <template v-else-if="openType != '' && isMp">
            <button
                class="up-reset-button up-text__value"
                :style="[valueStyle]"
                data-index="index"
                :openType="openType"
                @getuserinfo="onGetUserInfo"
                @contact="onContact"
                @getphonenumber="onGetPhoneNumber"
                @error="onError"
                @launchapp="onLaunchApp"
                @opensetting="onOpenSetting"
                :lang="lang"
                :session-from="sessionFrom"
                :send-message-title="sendMessageTitle"
                :send-message-path="sendMessagePath"
                :send-message-img="sendMessageImg"
                :show-message-card="showMessageCard"
                :app-parameter="appParameter"
            >
                {{ value }}
            </button>
        </template>
        <text
            v-else
            class="up-text__value"
            :style="[valueStyle]"
            :class="[
                `up-text__value--${type}`,
                `up-line-${lines}`
            ]"
            >{{ value }}</text
        >
        <view class="up-text__suffix-icon" v-if="suffixIcon != ''">
            <up-icon
                :name="suffixIcon"
                :customStyle="iconCustomStyle"
            ></up-icon>
        </view>
    </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import defProps from './text.uts'
import { addStyle, addUnit, deepMerge } from '../../libs/function/index.uts';
import { error, priceFormat, timeFormat } from '../../libs/function/index.uts';
import {
	date as testDate,
	url as testUrl,
} from '../../libs/function/test.uts';
/**
 * Text 文本
 * @description 此组件集成了文本类在项目中的常用功能，包括状态，拨打电话，格式化日期，*替换，超链接...等功能。 您大可不必在使用特殊文本时自己定义，text组件几乎涵盖您能使用的大部分场景。
 * @tutorial https://ijry.github.io/uview-plus/components/loading.html
 * @property {String} 					type		主题颜色
 * @property {Boolean} 					show		是否显示（默认 true ）
 * @property {String | Number}			text		显示的值
 * @property {String}					prefixIcon	前置图标
 * @property {String} 					suffixIcon	后置图标
 * @property {String} 					mode		文本处理的匹配模式 text-普通文本，price-价格，phone-手机号，name-姓名，date-日期，link-超链接
 * @property {String} 					href		mode=link下，配置的链接
 * @property {String | Function} 		format		格式化规则
 * @property {Boolean} 					call		mode=phone时，点击文本是否拨打电话（默认 false ）
 * @property {String} 					openType	小程序的打开方式
 * @property {Boolean} 					bold		是否粗体，默认normal（默认 false ）
 * @property {Boolean} 					block		是否块状（默认 false ）
 * @property {String | Number} 			lines		文本显示的行数，如果设置，超出此行数，将会显示省略号
 * @property {String} 					color		文本颜色（默认 '#303133' ）
 * @property {String | Number} 			size		字体大小（默认 15px ）
 * @property {Object | String} 			iconStyle	图标的样式 （默认 {fontSize: '15px'} ）
 * @property {String} 					decoration	文字装饰，下划线，中划线等，可选值 none|underline|line-through（默认 'none' ）
 * @property {Object | String | Number}	margin		外边距，对象、字符串，数值形式均可（默认 0px ）
 * @property {String | Number} 			lineHeight	文本行高
 * @property {String} 					align		文本对齐方式，可选值left|center|right（默认 'left' ）
 * @property {String} 					wordWrap	文字换行，可选值break-word|normal|anywhere（默认 'normal' ）
 * @event {Function} click  点击触发事件
 * @example <up-text text="我用十年青春,赴你最后之约"></up-text>
 */
defineOptions({
    styleIsolation: 'app-and-page',
    name: 'up-text'
})

const props = defineProps({
    // 主题颜色
    type: {
        type: String,
        default: defProps.getString('text.type')
    },
    // 是否显示
    show: {
        type: Boolean,
        default: defProps.getBoolean('text.show')
    },
    // 显示的值
    text: {
        type: [String, Number],
        default: defProps.getAny('text.text')
    },
    // 前置图标
    prefixIcon: {
        type: String,
        default: defProps.getString('text.prefixIcon')
    },
    // 后置图标
    suffixIcon: {
        type: String,
        default: defProps.getString('text.suffixIcon')
    },
    // 文本处理的匹配模式
    // text-普通文本，price-价格，phone-手机号，name-姓名，date-日期，link-超链接
    mode: {
        type: String,
        default: defProps.getString('text.mode')
    },
    // mode=link下，配置的链接
    href: {
        type: String,
        default: defProps.getString('text.href')
    },
    // 格式化规则
    format: {
        type: [String, Function],
        default: defProps.getAny('text.format')
    },
    // mode=phone时，点击文本是否拨打电话
    call: {
        type: Boolean,
        default: defProps.getBoolean('text.call')
    },
    // 小程序的打开方式
    openType: {
        type: String,
        default: defProps.getString('text.openType')
    },
    // 是否粗体，默认normal
    bold: {
        type: Boolean,
        default: defProps.getBoolean('text.bold')
    },
    // 是否块状
    block: {
        type: Boolean,
        default: defProps.getBoolean('text.block')
    },
    // 文本显示的行数，如果设置，超出此行数，将会显示省略号
    lines: {
        type: [String, Number],
        default: defProps.getAny('text.lines')
    },
    // 文本颜色
    color: {
        type: String,
        default: defProps.getString('text.color')
    },
    // 字体大小
    size: {
        type: [String, Number],
        default: defProps.getAny('text.size')
    },
    // 图标的样式
    iconStyle: {
        type: [Object, String],
        default: defProps.getAny('text.iconStyle')
    },
    // 文字装饰，下划线，中划线等，可选值 none|underline|line-through
    decoration: {
        tepe: String,
        default: defProps.getString('text.decoration')
    },
    // 外边距，对象、字符串，数值形式均可
    margin: {
        type: [Object, String, Number],
        default: defProps.getAny('text.margin')
    },
    // 文本行高
    lineHeight: {
        type: [String, Number],
        default: defProps.getAny('text.lineHeight')
    },
    // 文本对齐方式，可选值left|center|right
    align: {
        type: String,
        default: defProps.getString('text.align')
    },
    // 文字换行，可选值break-word|normal|anywhere
    wordWrap: {
        type: String,
        default: defProps.getString('text.wordWrap')
    },
    // 指定返回用户信息的语言，zh_CN 简体中文，zh_TW 繁体中文，en 英文。只微信小程序有效
    lang: {
        type: String,
        default: defProps.getString('text.lang')
    },
    // 会话来源，open-type="contact"时有效。只微信小程序有效
    sessionFrom: {
        type: String,
        default: defProps.getString('text.sessionFrom')
    },
    // 会话内消息卡片标题，open-type="contact"时有效
    // 默认当前标题，只微信小程序有效
    sendMessageTitle: {
        type: String,
        default: defProps.getString('text.sendMessageTitle')
    },
    // 会话内消息卡片点击跳转小程序路径，open-type="contact"时有效
    // 默认当前分享路径，只微信小程序有效
    sendMessagePath: {
        type: String,
        default: defProps.getString('text.sendMessagePath')
    },
    // 会话内消息卡片图片，open-type="contact"时有效
    // 默认当前页面截图，只微信小程序有效
    sendMessageImg: {
        type: String,
        default: defProps.getString('text.sendMessageImg')
    },
    // 是否显示会话内消息卡片，设置此参数为 true，用户进入客服会话会在右下角显示"可能要发送的小程序"提示，
    // 用户点击后可以快速发送小程序消息，open-type="contact"时有效
    showMessageCard: {
        type: Boolean,
        default: defProps.getBoolean('text.showMessageCard')
    },
    // 打开 APP 时，向 APP 传递的参数，open-type=launchApp时有效
    // 只微信小程序、QQ小程序有效
    appParameter: {
        type: String,
        default: defProps.getString('text.appParameter')
    },
    formType: {
        type: String,
        default: ''
    },
    customStyle: {
        type: [Object, String],
        default: () => ({})
    },
    customClass: {
        type: String,
        default: ''
    }
})

const emit = defineEmits(['click'])

const rootStyle = computed((): UTSJSONObject => {
    return {
        margin: props.margin,
        justifyContent: props.align === 'left' ? 'flex-start' : props.align === 'center' ? 'center' : 'flex-end'
    } as UTSJSONObject
})

const iconCustomStyle = computed((): UTSJSONObject => {
    return addStyle(props.iconStyle) as UTSJSONObject
})

// 默认的姓名脱敏规则
const formatName = (name: string): string => {
    let value = ''
    if (name.length == 2) {
        value = name.substring(0, 1) + '*'
    } else if (name.length > 2) {
        let char = ''
        for (let i = 0, len = name.length - 2; i < len; i++) {
            char += '*'
        }
        value = name.substring(0, 1) + char + name.substring(-1, 1)
    } else {
        value = name
    }
    return value
}

const valueStyle = computed((): UTSJSONObject => {
    let style = {
        textDecoration: props.decoration,
        fontWeight: props.bold ? 'bold' : 'normal',
        wordWrap: props.wordWrap,
        fontSize: addUnit(props.size)
    } as UTSJSONObject
	if (props.type == '') {
		style['color'] = props.color
	}
	if (props.lines != '') {
		style['lines'] = props.lines
	}
	if (props.lineHeight != '') {
		style['lineHeight'] = addUnit(props.lineHeight)
	}
	if (props.block) {
		style['display'] = 'block'
	}
	return deepMerge(style, addStyle(props.customStyle)) as UTSJSONObject
})

const linkStyle = computed((): UTSJSONObject => {
    return {
        fontWeight: valueStyle.value['fontWeight'],
        wordWrap: valueStyle.value['wordWrap'],
        fontSize: valueStyle.value['fontSize']
    } as UTSJSONObject
})

// 经处理后需要显示的值
const value = computed((): string => {
    let textStr = props.text.toString()

    // 价格类型
    if (props.mode === 'price') {
        // 如果text不为金额进行提示
        if (!/^\d+(\.\d+)?$/.test(textStr)) {
            error('金额模式下，text参数需要为金额格式');
        }
        // 进行格式化，判断用户传入的format参数为正则，或者函数，如果没有传入format，则使用默认的金额格式化处理
        // todo
		// if (testFunc(format)) {
        //     // 如果用户传入的是函数，使用函数格式化
        //     return format(text)
        // }
        // 如果format非正则，非函数，则使用默认的金额格式化方法进行操作
        return priceFormat(textStr, 2)
    } if (props.mode === 'date') {
        // 判断是否合法的日期或者时间戳
		if (!testDate(textStr)) {
			error('日期模式下，text参数需要为日期或时间戳格式' + textStr)
		}
        // 进行格式化，判断用户传入的format参数为正则，或者函数，如果没有传入format，则使用默认的格式化处理
        // todo
        // if (testFunc(format)) {
        //     // 如果用户传入的是函数，使用函数格式化
        //     return format(textStr)
        // }
		if (props.format != '') {
            // 如果format非正则，非函数，则使用默认的时间格式化方法进行操作
            return timeFormat(textStr, props.format.toString())
        }
        // 如果没有设置format，则设置为默认的时间格式化形式
        return timeFormat(textStr, 'yyyy-mm-dd')
    } if (props.mode === 'phone') {
        // 判断是否合法的手机号
        // !testMobile(text) && error('手机号模式下，text参数需要为手机号码格式')
        // todo
        // if (testFunc(format)) {
        //     // 如果用户传入的是函数，使用函数格式化
        //     return format(text)
        // }
		if (props.format === 'encrypt') {
            // 如果format为encrypt，则将手机号进行星号加密处理
            return `${textStr.substring(0, 3)}****${textStr.substring(7)}`
        }
        return textStr
    } if (props.mode === 'name') {
        // 判断是否合法的字符粗
		if (!(typeof (textStr) === 'string')) {
			error('姓名模式下，text参数需要为字符串格式')
		}
        // if (testFunc(format)) {
        //     // 如果用户传入的是函数，使用函数格式化
        //     return format(textStr)
        // }
		if (props.format === 'encrypt') {
            // 如果format为encrypt，则将姓名进行星号加密处理
            return formatName(textStr)
        }
        return textStr
    } if (props.mode === 'link') {
        // 判断是否合法的字符粗
		if (!testUrl(props.href)) {
			error('超链接模式下，href参数需要为URL格式')
		}
        return textStr
    }
    return textStr
})

const isMp = computed((): Boolean => {
    let mp = false
    // #ifdef MP
    mp = true
    // #endif
    return mp
})

const clickHandler = (): void => {
    // 如果为手机号模式，拨打电话
    if (props.call && props.mode === 'phone') {
		// todo
        // uni.makePhoneCall({
        //     phoneNumber: props.text
        // })
    }
    emit('click')
}

const onGetUserInfo = (): void => {
}
const onContact = (): void => {
}
const onGetPhoneNumber = (): void => {
}
const onError = (): void => {
}
const onLaunchApp = (): void => {
}
const onOpenSetting = (): void => {
}

defineExpose({
    rootStyle,
    iconCustomStyle,
    valueStyle,
    linkStyle,
    value,
    isMp,
    clickHandler,
    formatName,
	onGetUserInfo,
	onContact,
	onGetPhoneNumber,
	onError,
	onLaunchApp,
	onOpenSetting
})
</script>

<style lang="scss" scoped>
@import '../../libs/css/components.scss';

.up-text {
    @include flex(row);
    align-items: center;
    flex-wrap: nowrap;
    flex: 1;
	width: 100%;

    &__price {
        font-size: 14px;
        color: $up-content-color;
    }

    &__value {
        font-size: 14px;
        color: $up-content-color;
        text-overflow: ellipsis;

        &--primary {
            color: $up-primary;
        }

        &--warning {
            color: $up-warning;
        }

        &--success {
            color: $up-success;
        }

        &--info {
            color: $up-info;
        }

        &--error {
            color: $up-error;
        }

        &--main {
            color: $up-main-color;
        }

        &--content {
            color: $up-content-color;
        }

        &--tips {
            color: $up-tips-color;
        }

        &--light {
            color: $up-light-color;
        }
    }
}
</style>
