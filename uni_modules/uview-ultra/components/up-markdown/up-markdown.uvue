<template>
  <view class="up-markdown" :class="theme">
    <up-parse :content="parsedContent" :previewImg="previewImg"></up-parse>
  </view>
</template>

<script lang="uts">
import { useMarked } from '../../libs/marked-uts/utssdk/app-android'

const marked = useMarked()

async function renderMarkdown(content: string): Promise<string> {
  const parsed = await marked.parse(content, null) as string
  return parsed
}

export default {
  name: 'up-markdown',
  props: {
    // markdown内容
    content: {
      type: String,
      default: ''
    },
    // 是否启用图片预览
    previewImg: {
      type: Boolean,
      default: true
    },
    // 是否显示代码块行号
    showLineNumber: {
      type: Boolean,
      default: false
    },
    // 主题样式 'light' | 'dark'
    theme: {
      type: String,
      default: 'light'
    }
  },
  data() {
    return {
      parsedContent: ''
    };
  },
  watch: {
    content: {
      handler(newVal: string) {
        this.parseMarkdown(newVal);
      },
      immediate: true
    }
  },
  methods: {
    // 解析markdown内容
    async parseMarkdown(content: string): Promise<void> {
      if (content.length == 0) {
        this.parsedContent = '';
        return;
      }

      const parsed = await renderMarkdown(content)
      this.parsedContent = parsed;
    }
  }
};
</script>

