export default {
    // switch组件
    switch: {
        value: false,
        modelValue: false,
        loading: false,
        disabled: false,
        size: 25,
        // 与 switch.js 对齐：走主题变量（uvue 端 background 支持 var()，样式隔离 2.0 下变量可继承）
        activeColor: 'var(--up-switch-active-color, var(--up-primary, #2979ff))',
        inactiveColor: '#ffffff',
        activeValue: true,
        inactiveValue: false,
        asyncChange: false,
        space: 0,
        iconSize: 16,
        beforeChange: null
    }
} as UTSJSONObject