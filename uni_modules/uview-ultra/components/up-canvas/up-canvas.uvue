<template>
    <view
        class="up-canvas"
        :id="rootId"
        :style="rootStyle"
    >
        <canvas
            class="up-canvas__canvas"
            :id="canvasId"
            :canvas-id="canvasId"
            :style="canvasStyle"
            @touchstart="onTouchStart"
            @touchmove="onTouchMove"
            @touchend="onTouchEnd"
            @touchcancel="onTouchEnd"
        ></canvas>
    </view>
</template>

<script setup lang="uts">
import { computed, getCurrentInstance, onMounted, ref } from 'vue'

function normalizeSize(value: any | null, fallback: number): number {
    if (typeof value === 'number') {
        return value
    }
    if (value == null) {
        return fallback
    }
    const parsed = parseFloat(value.toString())
    return isNaN(parsed) ? fallback : parsed
}

function makeId(prefix: string): string {
    return prefix + Date.now().toString()
}

defineOptions({
    styleIsolation: 'app-and-page',
    name: 'up-canvas'
})

const props = defineProps({
        canvasId: {
            type: String,
            default(): string {
                return 'up-canvas-' + Date.now().toString()
            }
        },
        width: {
            type: [String, Number],
            default: 300
        },
        height: {
            type: [String, Number],
            default: 300
        },
        unit: {
            type: String,
            default: 'px'
        },
        useRootHeightAndWidth: {
            type: Boolean,
            default: false
        },
        bgColor: {
            type: String,
            default: '#ffffff'
        }
})

const emit = defineEmits(['touchstart', 'touchmove', 'touchend'])
const instance = getCurrentInstance()!.proxy!
const rootId = makeId('rootId-')
const widthLocal = ref(normalizeSize(props.width, 300))
const heightLocal = ref(normalizeSize(props.height, 300))
const canvasContext = ref<CanvasContext | null>(null)
const ctx = ref<CanvasRenderingContext2D | null>(null)
const isReady = ref(false)

const actualWidth = computed((): number => {
    return props.useRootHeightAndWidth ? normalizeSize(widthLocal.value, 300) : normalizeSize(props.width, 300)
})

const actualHeight = computed((): number => {
    return props.useRootHeightAndWidth ? normalizeSize(heightLocal.value, 300) : normalizeSize(props.height, 300)
})

const rootStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject
    style['width'] = props.useRootHeightAndWidth ? '100%' : actualWidth.value.toString() + props.unit
    style['height'] = props.useRootHeightAndWidth ? '100%' : actualHeight.value.toString() + props.unit
    return style
})

const canvasStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject
    style['width'] = actualWidth.value.toString() + props.unit
    style['height'] = actualHeight.value.toString() + props.unit
    return style
})

const onTouchStart = (e: UniTouchEvent): void => {
    emit('touchstart', e)
}

const onTouchMove = (e: UniTouchEvent): void => {
    emit('touchmove', e)
}

const onTouchEnd = (e: UniTouchEvent): void => {
    emit('touchend', e)
}

const getCanvasContext = (): CanvasRenderingContext2D | null => {
    return ctx.value
}

const clearRect = (x: number, y: number, width: number, height: number): void => {
    const context = ctx.value
    if (context != null) {
        context.clearRect(x, y, width, height)
    }
}

const setFillStyle = (color: string): void => {
    const context = ctx.value
    if (context != null) {
        context.fillStyle = color
    }
}

function fillCanvasBackground(): void {
    clearRect(0, 0, actualWidth.value, actualHeight.value)
    setFillStyle(props.bgColor)
    const context = ctx.value
    if (context != null) {
        context.fillRect(0, 0, actualWidth.value, actualHeight.value)
        context.draw()
    }
}

const initCanvas = (): void => {
    uni.createCanvasContextAsync({
        id: props.canvasId.toString() as string.IDString,
        component: instance,
        success: (context: CanvasContext) => {
            canvasContext.value = context
            ctx.value = context.getContext('2d')
            isReady.value = ctx.value != null
            fillCanvasBackground()
        },
        fail: (error: UniError) => {
            isReady.value = false
            console.error('初始化Canvas失败:', error)
        }
    })
}

const ensureContext = (): boolean => {
    if (ctx.value != null) {
        return true
    }
    if (!isReady.value) {
        initCanvas()
    }
    return ctx.value != null
}

function clearCanvas(): void {
    if (!ensureContext()) {
        return
    }
    fillCanvasBackground()
}

const rect = (x: number, y: number, width: number, height: number): void => {
    const context = ctx.value
    if (context != null) {
        context.rect(x, y, width, height)
    }
}

const fill = (): void => {
    const context = ctx.value
    if (context != null) {
        context.fill('nonzero')
    }
}

function setLineCap(lineCap: string = 'round'): void {
    const context = ctx.value
    if (context != null) {
        context.lineCap = lineCap
    }
}

function setLineJoin(lineJoin: string = 'round'): void {
    const context = ctx.value
    if (context != null) {
        context.lineJoin = lineJoin
    }
}

const setStrokeStyle = (color: string): void => {
    const context = ctx.value
    if (context != null) {
        context.strokeStyle = color
    }
}

const setLineWidth = (width: number): void => {
    const context = ctx.value
    if (context != null) {
        context.lineWidth = width
    }
}

const setLineStyle = (lineColor: string, lineWidth: number): void => {
    setLineCap('round')
    setLineJoin('round')
    setStrokeStyle(lineColor)
    setLineWidth(lineWidth)
}

const beginPath = (): void => {
    const context = ctx.value
    if (context != null) {
        context.beginPath()
    }
}

const moveTo = (x: number, y: number): void => {
    const context = ctx.value
    if (context != null) {
        context.moveTo(x, y)
    }
}

const lineTo = (x: number, y: number): void => {
    const context = ctx.value
    if (context != null) {
        context.lineTo(x, y)
    }
}

const stroke = (): void => {
    const context = ctx.value
    if (context != null) {
        context.stroke()
    }
}

const closePath = (): void => {
    const context = ctx.value
    if (context != null) {
        context.closePath()
    }
}

function draw(_isLastDraw: boolean = false): void {
    const context = ctx.value
    if (context != null) {
        context.draw()
    }
}

function exportImage(fileType: string = 'png', quality: number = 1): Promise<string> {
    return new Promise((resolve, reject) => {
        const canvas = canvasContext.value
        if (canvas == null) {
            reject(new Error('Canvas is not ready'))
            return
        }
        const mime = fileType == 'jpg' || fileType == 'jpeg' ? 'image/jpeg' : 'image/png'
        resolve(canvas.toDataURL(mime, quality))
    })
}

const setNewSize = (): void => {
    widthLocal.value = normalizeSize(props.width, 300)
    heightLocal.value = normalizeSize(props.height, 300)
}

onMounted(() => {
    if (props.useRootHeightAndWidth) {
        setNewSize()
    }
    initCanvas()
})

defineExpose({
    rootId,
    widthLocal,
    heightLocal,
    canvasContext,
    ctx,
    isReady,
    actualWidth,
    actualHeight,
    rootStyle,
    canvasStyle,
    onTouchStart,
    onTouchMove,
    onTouchEnd,
    getCanvasContext,
    initCanvas,
    ensureContext,
    clearCanvas,
    rect,
    clearRect,
    fill,
    setFillStyle,
    setLineStyle,
    setLineCap,
    setLineJoin,
    setStrokeStyle,
    setLineWidth,
    beginPath,
    moveTo,
    lineTo,
    stroke,
    closePath,
    draw,
    exportImage,
    setNewSize
})
</script>

<style lang="scss" scoped>
    .up-canvas {
        position: relative;
        overflow: hidden;
    }

    .up-canvas__canvas {
        display: flex;
    }
</style>
