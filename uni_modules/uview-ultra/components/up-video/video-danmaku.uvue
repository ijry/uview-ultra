<template>
	<view class="up-video-danmaku" :style="{ opacity: opacity }">
		<view
			v-for="item in items"
			:key="item['id']"
			class="up-video-danmaku__item"
			:style="itemStyle(item)"
		>
			<text class="up-video-danmaku__text" :style="{ color: item.color, fontSize: fontSizePx }">{{ item.text }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, getCurrentInstance, onBeforeUnmount, onMounted, ref, watch } from 'vue'
	import { upGetRect } from '../../libs/function/index.uts'
	import {
		acquireDanmuTrack,
		createDanmuState,
		estimateDanmuWidth,
		findDanmuCursor,
		normalizeDanmuItem,
		normalizeDanmuList,
		resetDanmuState
	} from './danmaku.uts'
	import { toNumber } from './video-utils.uts'
	import { UPVideoDanmu, UPVideoDanmuState, UPVideoTrackOptions } from './types.uts'

	defineOptions({
		styleIsolation: 'app-and-page',
		name: 'video-danmaku'
	})

	// 顶部/底部固定弹幕的停留毫秒数
	const STATIC_HOLD = 4000

	const props = defineProps({
		list: {
			type: Array,
			default: [] as Array<any>
		},
		open: {
			type: Boolean,
			default: true
		},
		color: {
			type: String,
			default: '#ffffff'
		},
		fontSize: {
			type: [Number, String],
			default: 14
		},
		duration: {
			type: [Number, String],
			default: 8
		},
		// full 全屏 / half 上半屏 / top 顶部三行
		area: {
			type: String,
			default: 'full'
		},
		opacity: {
			type: [Number, String],
			default: 1
		},
		max: {
			type: [Number, String],
			default: 30
		}
	})

	// up-video 的弹幕层。父组件在 timeupdate 里调用 sync(currentTime) 投放弹幕，
	// 发送弹幕走 push()。文件名不以 up- 开头，避免被 easycom 当成公开组件。
	const instance = getCurrentInstance()?.proxy

	const items = ref<Array<UTSJSONObject>>([] as Array<UTSJSONObject>)
	const containerWidth = ref(0)
	const containerHeight = ref(0)
	const cursor = ref(0)
	const lastTime = ref(0)
	const seq = ref(0)
	const state = ref<UPVideoDanmuState>(createDanmuState())
	let timers: number[] = [] as number[]

	const fontSizeNumber = computed((): number => {
		const value = toNumber(props.fontSize, 0)
		return value > 0 ? value : 14
	})
	const fontSizePx = computed((): string => fontSizeNumber.value.toString() + 'px')
	const trackHeight = computed((): number => Math.round(fontSizeNumber.value * 1.6))
	const sortedList = computed((): UPVideoDanmu[] => normalizeDanmuList(props.list))

	const measure = async (): Promise<void> => {
		const rect = await upGetRect('.up-video-danmaku', false, instance)
		if (rect != null && (rect.width ?? 0) > 0) {
			containerWidth.value = rect.width ?? 0
			containerHeight.value = rect.height ?? 0
		}
	}

	const trackCount = (): number => {
		const height = containerHeight.value > 0 ? containerHeight.value : 0
		let usable = height
		if (props.area == 'half') usable = height / 2
		if (props.area == 'top') usable = trackHeight.value * 3
		const count = Math.floor(usable / trackHeight.value)
		return count > 1 ? count : 1
	}

	const clear = (): void => {
		timers.forEach((timer: number) => {
			clearTimeout(timer)
		})
		timers = [] as number[]
		items.value = [] as Array<UTSJSONObject>
		resetDanmuState(state.value)
	}

	// 拖动进度条、切集后调用，清空在屏弹幕并把游标移到新时间点
	const reset = (time: any): void => {
		clear()
		lastTime.value = toNumber(time, 0)
		cursor.value = findDanmuCursor(sortedList.value, lastTime.value)
	}

	const remove = (id: number): void => {
		const index = items.value.findIndex((item: UTSJSONObject): boolean => (item['id'] ?? 0) == id)
		if (index > -1) {
			items.value.splice(index, 1)
		}
	}

	const replaceItem = (id: number, x: number, moving: boolean): void => {
		const index = items.value.findIndex((item: UTSJSONObject): boolean => (item['id'] ?? 0) == id)
		if (index < 0) return
		// 整体替换而不是改字段，保证数组元素变更一定能触发重新渲染
		const old = items.value[index]
		items.value[index] = {
			id: old['id'],
			text: old['text'],
			color: old['color'],
			width: old['width'],
			type: old['type'],
			offset: old['offset'],
			x: x,
			moving: moving,
			life: old['life']
		} as UTSJSONObject
	}

	const mount = (danmu: UPVideoDanmu, track: number, width: number, isStatic: boolean): void => {
		seq.value += 1
		const durationNumber = toNumber(props.duration, 0)
		const life = isStatic ? STATIC_HOLD : (durationNumber > 0 ? durationNumber : 8) * 1000
		const startX = isStatic ? Math.max(0, (containerWidth.value - width) / 2) : containerWidth.value
		const id = seq.value
		items.value.push({
			id: id,
			text: danmu.text,
			color: danmu.color != '' ? danmu.color : props.color,
			width: width,
			type: danmu.type,
			offset: track * trackHeight.value,
			x: startX,
			moving: false,
			life: life
		} as UTSJSONObject)
		if (!isStatic) {
			// 必须等节点带着初始 transform 上屏，再改终点值，transition 才会跑起来
			timers.push(setTimeout(() => {
				replaceItem(id, -width, true)
			}, 20))
		}
		timers.push(setTimeout(() => {
			remove(id)
		}, life + 200))
	}

	const spawn = (danmu: UPVideoDanmu): void => {
		if (!props.open || danmu == null || danmu.text == '') return
		if (items.value.length >= toNumber(props.max, 30)) return
		if (containerWidth.value <= 0) measure()
		const width = estimateDanmuWidth(danmu.text, fontSizeNumber.value)
		const isStatic = danmu.type == 'top' || danmu.type == 'bottom'
		const options = {
			now: Date.now(),
			itemWidth: width,
			containerWidth: containerWidth.value,
			duration: toNumber(props.duration, 8) > 0 ? toNumber(props.duration, 8) : 8,
			trackCount: trackCount(),
			hold: isStatic ? STATIC_HOLD : 0
		} as UPVideoTrackOptions
		const track = acquireDanmuTrack(state.value, options)
		if (track < 0) return
		mount(danmu, track, width, isStatic)
	}

	// 播放进度推进时投放到点的弹幕，跳转超过 2 秒视为 seek
	const sync = (currentTime: any): void => {
		const time = toNumber(currentTime, 0)
		if (!props.open) {
			lastTime.value = time
			return
		}
		if (time < lastTime.value || time - lastTime.value > 2) {
			reset(time)
		}
		lastTime.value = time
		const list = sortedList.value
		// 宽度还没量到（首帧或隐藏中）时先不投放，避免弹幕从左边冒出来
		if (containerWidth.value <= 0) {
			measure()
			return
		}
		while (cursor.value < list.length && list[cursor.value].time <= time) {
			spawn(list[cursor.value])
			cursor.value += 1
		}
	}

	// 主动发送一条弹幕（输入框、外部调用）
	const push = (danmu: any): UPVideoDanmu | null => {
		const item = normalizeDanmuItem(danmu)
		if (item.text == '') return null
		item.time = lastTime.value
		spawn(item)
		return item
	}

	const itemStyle = (item: UTSJSONObject): UTSJSONObject => {
		const x = toNumber(item['x'], 0)
		const offset = toNumber(item['offset'], 0)
		const style = {
			transform: 'translateX(' + x.toString() + 'px)'
		} as UTSJSONObject
		if ((item['type'] ?? '') == 'bottom') {
			style['bottom'] = offset.toString() + 'px'
		} else {
			style['top'] = offset.toString() + 'px'
		}
		if (item['moving'] == true) {
			style['transitionProperty'] = 'transform'
			style['transitionDuration'] = toNumber(item['life'], 0).toString() + 'ms'
			style['transitionTimingFunction'] = 'linear'
		}
		return style
	}

	watch((): number => sortedList.value.length, () => {
		// 换集/换弹幕源后重新对齐游标
		reset(lastTime.value)
	})

	watch((): boolean => props.open, (value: boolean) => {
		if (!value) clear()
	})

	onMounted(() => {
		measure()
	})

	onBeforeUnmount(() => {
		clear()
	})

	defineExpose({
		reset,
		sync,
		push,
		clear
	})
</script>

<style lang="scss" scoped>
	@import "../../libs/css/components.scss";

	.up-video-danmaku {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		overflow: hidden;
	}

	.up-video-danmaku__item {
		position: absolute;
		left: 0;
		flex-direction: row;
	}

	.up-video-danmaku__text {
		line-height: 1.6;
	}
</style>
