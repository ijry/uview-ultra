<template>
	<view class="up-tabbar">
		<view
		    class="up-tabbar__content"
		    ref="up-tabbar__content"
		    @touchmove.stop.prevent="stopTabbarTouchMove"
		    :class="[border ? 'up-border-top' : '', fixed ? 'up-tabbar--fixed' : '']"
		    :style="[tabbarStyle]"
		>
			<view class="up-tabbar__content__item-wrapper">
				<slot />
			</view>
			<up-safe-bottom v-if="safeAreaInsetBottom"></up-safe-bottom>
		</view>
		<view
		    class="up-tabbar__placeholder"
			v-if="placeholder"
		    :style="{
				height: placeholderHeight + 'px',
			}"
		></view>
	</view>
</template>

<script setup lang="uts">
	import { computed, getCurrentInstance, onMounted, ref, watch } from 'vue';
	import defProps from './tabbar.uts';
	import { addStyle, deepMerge, sleep, upGetRect } from '../../libs/function/index.uts';
	import { useUltraUI } from '../../libs/composable/useUltraUI.uts';
	
	/**
	 * Tabbar 底部导航栏
	 * @description 此组件提供了自定义tabbar的能力。
	 * @tutorial https://uview-plus.jiangruyi.com/components/tabbar.html
	 * @property {String | Number}	value				当前匹配项的name
	 * @property {Boolean}			safeAreaInsetBottom	是否为iPhoneX留出底部安全距离（默认 true ）
	 * @property {Boolean}			border				是否显示上方边框（默认 true ）
	 * @property {String | Number}	zIndex				元素层级z-index（默认 1 ）
	 * @property {String}			activeColor			选中标签的颜色（默认 '#1989fa' ）
	 * @property {String}			inactiveColor		未选中标签的颜色（默认 '#7d7e80' ）
	 * @property {Boolean}			fixed				是否固定在底部（默认 true ）
	 * @property {Boolean}			placeholder			fixed定位固定在底部时，是否生成一个等高元素防止塌陷（默认 true ）
	 * @property {String}			backgroundColor		背景色（默认 '#ffffff' ）
	 * @property {Object}			customStyle			定义需要用到的外部样式
	 * 
	 * @example <up-tabbar :value="value2" :placeholder="false" @change="name => value2 = name" :fixed="false" :safeAreaInsetBottom="false"><up-tabbar-item text="首页" icon="home" dot ></up-tabbar-item></up-tabbar>
	 */
	const { children, getChildren, addChild } = useUltraUI()
	const instance = getCurrentInstance()!.proxy!

	defineOptions({
		styleIsolation: 'app-and-page',
		name: 'up-tabbar'
	})

	const props = defineProps({
		// 当前匹配项的name
		value: {
			type: [String, Number],
			default: (defProps['tabbar'] as UTSJSONObject)['value']
		},
		// 是否为iPhoneX留出底部安全距离
		safeAreaInsetBottom: {
			type: Boolean,
			default: (defProps['tabbar'] as UTSJSONObject)['safeAreaInsetBottom']
		},
		// 是否显示上方边框
		border: {
			type: Boolean,
			default: (defProps['tabbar'] as UTSJSONObject)['border']
		},
		// 上方边框颜色
		borderColor: {
			type: String,
			default: (defProps['tabbar'] as UTSJSONObject)['borderColor']
		},
		// 元素层级z-index
		zIndex: {
			type: [String, Number],
			default: (defProps['tabbar'] as UTSJSONObject)['zIndex']
		},
		// 选中标签的颜色
		activeColor: {
			type: String,
			default: (defProps['tabbar'] as UTSJSONObject)['activeColor']
		},
		// 未选中标签的颜色
		inactiveColor: {
			type: String,
			default: (defProps['tabbar'] as UTSJSONObject)['inactiveColor']
		},
		// 是否固定在底部
		fixed: {
			type: Boolean,
			default: (defProps['tabbar'] as UTSJSONObject)['fixed']
		},
		// fixed定位固定在底部时，是否生成一个等高元素防止塌陷
		placeholder: {
			type: Boolean,
			default: (defProps['tabbar'] as UTSJSONObject)['placeholder']
		},
		// 背景色
		backgroundColor: {
			type: String,
			default: (defProps['tabbar'] as UTSJSONObject)['backgroundColor']
		},
		customStyle: {
			type: [Object, String],
			default: () => ({})
		}
	})

	const emit = defineEmits(['change'])
	const placeholderHeight = ref(0)
	const tabbarContentTop = ref(0)
	const tabbarContentMeasured = ref(false)
	const midButtonBorderTopOffset = computed((): number => props.border ? 0.25 : 0)

	const parentDataSelf = computed((): UTSJSONObject => {
		return {
			value: props.value,
			activeColor: props.activeColor,
			inactiveColor: props.inactiveColor,
			borderColor: props.borderColor,
			border: props.border,
			midButtonBorderTopOffset: midButtonBorderTopOffset.value,
			tabbarContentTop: tabbarContentTop.value,
			tabbarContentMeasured: tabbarContentMeasured.value
		} as UTSJSONObject
	})

	const tabbarStyle = computed((): any => {
		const style = {
			zIndex: props.zIndex
		} as UTSJSONObject
		if (props.borderColor != '') {
			style['borderColor'] = props.borderColor + ' !important'
		}
		if (props.backgroundColor != '') {
			style['backgroundColor'] = props.backgroundColor
		}
		// 合并来自父组件的customStyle样式
		return deepMerge(style, addStyle(props.customStyle))
	})

	// 监听多个参数的变化，通过在computed执行对应的操作
	const updateChild = computed((): Array<any | null> => {
		return [props.value, props.activeColor, props.inactiveColor, props.borderColor, props.border, tabbarContentTop.value, tabbarContentMeasured.value] as Array<any | null>
	})

	const updatePlaceholder = computed((): Array<any> => {
		return [props.fixed, props.placeholder, props.border, props.customStyle] as Array<any>
	})

	const updateChildren = (): void => {
		// 如果存在子元素，则执行子元素的updateFromParent进行更新数据
		if (children.value.length > 0) {
			children.value.map((child: ComponentPublicInstance) => {
				child?.$callMethod('updateFromParent')
			})
		}
	}

	// 测量 tabbar 顶部，并在需要时同步防塌陷元素高度
	const setPlaceholderHeight = async (): Promise<void> => {
		// 延时一定时间
		await sleep(20)
		const size = await upGetRect('.up-tabbar__content', false, instance)
		const height = size.height ?? 50
		if (!isFinite(height) || height <= 0) return
		if (props.fixed && props.placeholder) {
			placeholderHeight.value = height
		}
		const top = size.top
		if (top == null || !isFinite(top)) return
		tabbarContentTop.value = top
		tabbarContentMeasured.value = true
		updateChildren()
	}

	const stopTabbarTouchMove = (_event: UniEvent): void => {}

	const emitChange = (name: any | null): void => {
		emit('change', name)
	}

	const getProps = (): UTSJSONObject => {
		return parentDataSelf.value
	}

	const getRefs = (): UTSJSONObject => {
		return {} as UTSJSONObject
	}

	watch(updateChild, () => {
		// 如果updateChildren中的元素发生了变化，则执行子元素初始化操作
		updateChildren()
	})

	watch(updatePlaceholder, () => {
		// 如果fixed，placeholder等参数发生变化，重新计算占位元素的高度
		setPlaceholderHeight()
	})

	onMounted(() => {
		setPlaceholderHeight()
	})

	defineExpose({
		placeholderHeight,
		tabbarContentTop,
		tabbarContentMeasured,
		midButtonBorderTopOffset,
		tabbarStyle,
		updateChild,
		updatePlaceholder,
		updateChildren,
		setPlaceholderHeight,
		stopTabbarTouchMove,
		emitChange,
		getChildren,
		addChild,
		getProps,
		getRefs
	})
</script>

<style lang="scss" scoped>
	@import '../../libs/css/components.scss';

	.up-tabbar {
		@include flex(column);
		flex: 1;
		justify-content: center;
		
		&__content {
			@include flex(column);
			background-color: #fff;
			
			&__item-wrapper {
				height: 50px;
				@include flex(row);
				justify-content: space-around;
			}
		}

		&--fixed {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
		}
	}
</style>
