<template>
	<view class="up-number-box">
		<view
		    class="up-number-box__slot cursor-pointer"
		    @tap.stop="clickHandler('minus')"
		    @touchstart="onTouchStart('minus')"
		    @touchend.stop="clearLongPressTimeout"
		    v-if="showMinus && !hideMinus && $slots['minus'] != null"
		>
			<slot name="minus" />
		</view>
		<view
		    v-else-if="showMinus && !hideMinus"
		    class="up-number-box__minus cursor-pointer"
		    @tap.stop="clickHandler('minus')"
		    @touchstart="onTouchStart('minus')"
		    @touchend.stop="clearLongPressTimeout"
		    hover-class="up-number-box__minus--hover"
		    hover-stay-time="150"
		    :class="{'up-number-box__minus--disabled': isDisabled('minus') }"
		    :style="[buttonStyle('minus')]"
		>
			<up-icon
			    name="minus"
			    :color="isDisabled('minus') ? '#c8c9cc' : '#323233'"
			    size="15"
			    bold
				:customStyle="iconStyle"
			></up-icon>
		</view>

		<template v-if="!hideMinus">
			<slot name="input">
				<!-- #ifdef MP-WEIXIN -->
				<input
					:disabled="disabledInput || disabled"
					:cursor-spacing="getCursorSpacing"
					:class="{ 'up-number-box__input--disabled': disabled || disabledInput }"
					:value="currentValue"
					class="up-number-box__input"
					@blur="onBlur"
					@focus="onFocus"
					@input="onInput"
					:type="integer ? 'number' : 'digit'"
					:style="[inputStyle]"
				/>
				<!-- #endif -->
				<!-- #ifndef MP-WEIXIN -->
				<input
					:disabled="disabledInput || disabled"
					:cursor-spacing="getCursorSpacing"
					:class="{ 'up-number-box__input--disabled': disabled || disabledInput }"
					v-model="currentValue"
					class="up-number-box__input"
					@blur="onBlur"
					@focus="onFocus"
					@input="onInput"
					:type="integer ? 'number' : 'digit'"
					:style="[inputStyle]"
				/>
				<!-- #endif -->
			</slot>
		</template>
		<view
		    class="up-number-box__slot cursor-pointer"
		    @tap.stop="clickHandler('plus')"
		    @touchstart="onTouchStart('plus')"
		    @touchend.stop="clearLongPressTimeout"
		    v-if="showPlus && $slots['plus'] != null"
		>
			<slot name="plus" />
		</view>
		<view
		    v-else-if="showPlus"
		    class="up-number-box__plus cursor-pointer"
		    @tap.stop="clickHandler('plus')"
		    @touchstart="onTouchStart('plus')"
		    @touchend.stop="clearTimeout"
		    hover-class="up-number-box__plus--hover"
		    hover-stay-time="150"
		    :class="{ 'up-number-box__minus--disabled': isDisabled('plus') }"
		    :style="[buttonStyle('plus')]"
		>
			<up-icon
			    name="plus"
			    :color="isDisabled('plus') ? '#c8c9cc' : '#323233'"
			    size="15"
			    bold
				:customStyle="iconStyle"
			></up-icon>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, nextTick, onMounted, ref, watch } from 'vue';
	import defProps from './numberBox.uts';
	import { getPx, addUnit } from '../../libs/function/index.uts';
	/**
	 * numberBox 步进器
	 * @description 该组件一般用于商城购物选择物品数量的场景。
	 * @tutorial https://uview-plus.jiangruyi.com/components/numberBox.html
	 * @property {String | Number}	name			步进器标识符，在change回调返回
	 * @property {String | Number}	value			用于双向绑定的值，初始化时设置设为默认min值(最小值)  （默认 0 ）
	 * @property {String | Number}	min				最小值 （默认 1 ）
	 * @property {String | Number}	max				最大值 （默认 Number.MAX_SAFE_INTEGER ）
	 * @property {String | Number}	step			加减的步长，可为小数 （默认 1 ）
	 * @property {Boolean}			integer			是否只允许输入整数 （默认 false ）
	 * @property {Boolean}			disabled		是否禁用，包括输入框，加减按钮 （默认 false ）
	 * @property {Boolean}			disabledInput	是否禁用输入框 （默认 false ）
	 * @property {Boolean}			asyncChange		是否开启异步变更，开启后需要手动控制输入值 （默认 false ）
	 * @property {String | Number}	inputWidth		输入框宽度，单位为px （默认 35 ）
	 * @property {Boolean}			showMinus		是否显示减少按钮 （默认 true ）
	 * @property {Boolean}			showPlus		是否显示增加按钮 （默认 true ）
	 * @property {String | Number}	decimalLength	显示的小数位数
	 * @property {Boolean}			longPress		是否开启长按加减手势 （默认 true ）
	 * @property {String}			color			输入框文字和加减按钮图标的颜色 （默认 '#323233' ）
	 * @property {String | Number}	buttonSize		按钮大小，宽高等于此值，单位px，输入框高度和此值保持一致 （默认 30 ）
	 * @property {String}			bgColor			输入框和按钮的背景颜色 （默认 '#EBECEE' ）
	 * @property {String | Number}	cursorSpacing	指定光标于键盘的距离，避免键盘遮挡输入框，单位px （默认 100 ）
	 * @property {Boolean}			disablePlus		是否禁用增加按钮 （默认 false ）
	 * @property {Boolean}			disableMinus	是否禁用减少按钮 （默认 false ）
	 * @property {Object ｜ String}	iconStyle		加减按钮图标的样式
	 *
	 * @event {Function}	onFocus	输入框活动焦点
	 * @event {Function}	onBlur	输入框失去焦点
	 * @event {Function}	onInput	输入框值发生变化
	 * @event {Function}	onChange
	 * @example <up-number-box v-model="value" @change="valChange"></up-number-box>
	 */
	defineOptions({
		styleIsolation: 'app-and-page',
		name: 'up-number-box'
	})

	const props = defineProps({
		// 步进器标识符，在change回调返回
		name: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['name']
		},
		// 用于双向绑定的值，初始化时设置设为默认min值(最小值)
		modelValue: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['value']
		},
		// 最小值
		min: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['min']
		},
		// 最大值
		max: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['max']
		},
		// 加减的步长，可为小数
		step: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['step']
		},
		// 是否只允许输入整数
		integer: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['integer']
		},
		// 是否禁用，包括输入框，加减按钮
		disabled: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['disabled']
		},
		// 是否禁用输入框
		disabledInput: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['disabledInput']
		},
		// 是否开启异步变更，开启后需要手动控制输入值
		asyncChange: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['asyncChange']
		},
		// 输入框宽度，单位为px
		inputWidth: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['inputWidth']
		},
		// 是否显示减少按钮
		showMinus: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['showMinus']
		},
		// 是否显示增加按钮
		showPlus: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['showPlus']
		},
		// 显示的小数位数
		decimalLength: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['decimalLength']
		},
		// 是否开启长按加减手势
		longPress: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['longPress']
		},
		// 输入框文字和加减按钮图标的颜色
		color: {
			type: String,
			default: (defProps['numberBox'] as UTSJSONObject)['color']
		},
		// 按钮宽度
		buttonWidth: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['buttonWidth']
		},
		// 按钮大小，宽高等于此值，单位px，输入框高度和此值保持一致
		buttonSize: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['buttonSize']
		},
		// 按钮圆角
		buttonRadius: {
			type: [String],
			default: (defProps['numberBox'] as UTSJSONObject)['buttonRadius']
		},
		// 输入框和按钮的背景颜色
		bgColor: {
			type: String,
			default: (defProps['numberBox'] as UTSJSONObject)['bgColor']
		},
		// 按钮禁用背景色
		disabledBgColor: {
			type: String,
			default: (defProps['numberBox'] as UTSJSONObject)['disabledBgColor']
		},
		// 输入框背景颜色
		inputBgColor: {
			type: String,
			default: (defProps['numberBox'] as UTSJSONObject)['inputBgColor']
		},
		// 指定光标于键盘的距离，避免键盘遮挡输入框，单位px
		cursorSpacing: {
			type: [String, Number],
			default: (defProps['numberBox'] as UTSJSONObject)['cursorSpacing']
		},
		// 是否禁用增加按钮
		disablePlus: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['disablePlus']
		},
		// 是否禁用减少按钮
		disableMinus: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['disableMinus']
		},
		// 加减按钮图标的样式
		iconStyle: {
			type: [UTSJSONObject, String],
			default: (defProps['numberBox'] as UTSJSONObject)['iconStyle']
		},
		// 迷你模式
		miniMode: {
			type: Boolean,
			default: (defProps['numberBox'] as UTSJSONObject)['miniMode']
		},
	})

	const emit = defineEmits(['update:modelValue', 'focus', 'blur', 'overlimit', 'change', 'plus', 'minus'])

	const type = ref('')
	// 输入框实际操作的值
	const currentValue = ref<string | number>('' as (string | number))
	// 定时器
	const longPressTimer = ref<number | null>(null)

	const hideMinus = computed((): boolean => {
		return currentValue.value.toString() == '0' && props.miniMode == true
	})

	const getCursorSpacing = computed((): number => {
		// 判断传入的单位，如果为px单位，需要转成px
		return parseFloat(getPx(props.cursorSpacing).toString())
	})

	// 输入框的样式
	const inputStyle = computed((): UTSJSONObject => {
		const style = {
			color: props.color,
			backgroundColor: props.inputBgColor != '' ? props.inputBgColor : props.bgColor,
			height: addUnit(props.buttonSize),
			width: addUnit(props.inputWidth)
		} as UTSJSONObject
		return style
	})

	// 用于监听多个值发生变化
	const watchChange = computed((): Array<any> => {
		return [props.integer, props.decimalLength, props.min, props.max] as Array<any>
	})

	const filter = (value: string | number): string => {
		value = value.toString()
		// 只允许0-9之间的数字，"."为小数点，"-"为负数时候使用
		value = value.replace(/[^0-9.-]/g, '')
		// 如果只允许输入整数，则过滤掉小数点后的部分
		if (props.integer && value.indexOf('.') != -1) {
			value = value.split('.')[0]
		}
		return value
	}

	// 格式化整理数据，限制范围
	function formatValue(value: string): number {
		value = filter(value)
		// 如果为空字符串，那么设置为0，同时将值转为Number类型
		let valueNum: number = value == '' ? 0 : parseFloat(value)
		// 对比最大最小值，取在min和max之间的值
		// @ts-ignore
		valueNum = Math.max(Math.min(parseFloat(props.max.toString()), parseFloat(value.toString())), parseFloat(props.min.toString()))
		// 如果设定了最大的小数位数，使用toFixed去进行格式化
		// @ts-ignore
		let decimalLength = parseInt(props.decimalLength.toString())
		if (decimalLength != 0 && valueNum != 0) {
			valueNum = parseFloat(valueNum.toFixed(decimalLength))
		}
		return valueNum
	}

	const init = (): void => {
		currentValue.value = formatValue(props.modelValue != null ? props.modelValue.toString() : '0')
	}

	const isDisabled = (type: string): boolean => {
		if (type === 'plus') {
			// 在点击增加按钮情况下，判断整体的disabled，是否单独禁用增加按钮，以及当前值是否大于最大的允许值
			return (
				props.disabled ||
				props.disablePlus
				// || parseFloat(currentValue.value.toString()) >= parseFloat(props.max.toString())
			)
		}
		// 点击减少按钮同理
		return (
			props.disabled ||
			props.disableMinus ||
			parseFloat(currentValue.value.toString()) <= parseFloat(props.min.toString())
		)
	}

	// 按钮的样式
	const buttonStyle = (type: string): UTSJSONObject => {
		const style = {
			backgroundColor: props.bgColor,
			width: addUnit(props.buttonWidth),
			height: addUnit(props.buttonSize),
			color: props.color,
			borderRadius: props.buttonRadius
		} as UTSJSONObject
		if (isDisabled(type)) {
			style['backgroundColor'] = props.disabledBgColor
		}
		return style
	}

	function emitChange(value: string | number, type: string): void {
		// 如果开启了异步变更值，则不修改内部的值，需要用户手动在外部通过v-model变更
		if (!props.asyncChange) {
			nextTick(() => {
				emit('update:modelValue', value)
				currentValue.value = value
			})
		}
		emit('change', {
			value: parseFloat(value.toString()),
			name: props.name,
			type: type // 当前变更类型
		})
	}

	const check = (): void => {
		// 格式化了之后，如果前后的值不相等，那么设置为格式化后的值
		const val = formatValue(currentValue.value.toString())
		if (val !== currentValue.value) {
			currentValue.value = val
			emitChange(val, '')
		}
	}

	// 输入框活动焦点
	const onFocus = (event: UniInputFocusEvent): void => {
		emit('focus', {
			...event.detail,
			name: props.name,
		})
	}

	// 输入框失去焦点
	const onBlur = (event: UniInputBlurEvent): void => {
		// 对输入值进行格式化
		const value = formatValue(event.detail.value)
		// 失焦时再执行边界修正，避免最小值场景下无法先清空再输入
		emitChange(value, '')
		// 发出blur事件
		emit(
			'blur', {
				...event.detail,
				name: props.name,
			}
		)
	}

	// 输入框值发生变化
	const onInput = (e: UniInputEvent): any | null => {
		let value = e.detail.value
		// 为空返回
		if (value === '') {
			// 允许输入过程中临时清空，失焦后在onBlur统一修正
			currentValue.value = ''
			return null
		}
		let formatted = filter(value.toString())
		// https://github.com/ijry/uview-plus/issues/613
		emitChange(value, '')
		// 最大允许的小数长度
		if (formatted.indexOf('.') != -1) {
			const pair = formatted.split('.')
			// @ts-ignore
			formatted = `${pair[0]}.${pair[1].slice(0, parseInt(props.decimalLength.toString()))}`
		}
		let formatted2 = formatValue(formatted)
		emitChange(formatted2, '')
		// #ifdef MP-WEIXIN
		return formatted2
		// #endif
		return null
	}

	// 对值扩大后进行四舍五入，再除以扩大因子，避免出现浮点数操作的精度问题
	function addValue(num1: number, num2: number): number {
		const cardinal = Math.pow(10, 10)
		return Math.round((num1 + num2) * cardinal) / cardinal
	}

	const onChange = (): void => {
		const currentType = type.value
		if (isDisabled(currentType)) {
			emit('overlimit', currentType)
			return
		}
		// @ts-ignore
		const diff = currentType === 'minus' ? 0 - parseFloat(props.step.toString()) : 0 + parseFloat(props.step.toString())
		const value = formatValue(addValue(0 + parseFloat(currentValue.value.toString()), diff).toString())
		emitChange(value, currentType)
		if (currentType == 'plus') {
			emit('plus')
		} else if (currentType == 'minus') {
			emit('minus')
		}
	}

	// 点击加减按钮
	const clickHandler = (typeParam: string): void => {
		type.value = typeParam
		onChange()
	}

	// 清除定时器
	const clearLongPressTimeout = (): void => {
		clearTimeout(longPressTimer.value ?? 0)
		longPressTimer.value = null
	}

	function longPressStep(): void {
		// 每隔一段时间，重新调用longPressStep方法，实现长按加减
		clearLongPressTimeout()
		longPressTimer.value = setTimeout(() => {
			onChange()
			longPressStep()
		}, 250)
	}

	const onTouchStart = (typeParam: string): void => {
		if (!props.longPress) return
		clearLongPressTimeout()
		type.value = typeParam
		// 一定时间后，默认达到长按状态
		longPressTimer.value = setTimeout(() => {
			onChange()
			longPressStep()
		}, 600)
	}

	// 触摸结束，清除定时器，停止长按加减
	const onTouchEnd = (): void => {
		if (!props.longPress) return
		clearLongPressTimeout()
	}

	watch(watchChange, () => {
		check()
	})

	watch((): string | number => props.modelValue, (newV: string | number) => {
		if (newV !== currentValue.value) {
			currentValue.value = formatValue(newV.toString())
		}
	}, { immediate: true })

	onMounted(() => {
		init()
	})

	defineExpose({
		type,
		currentValue,
		longPressTimer,
		hideMinus,
		getCursorSpacing,
		inputStyle,
		watchChange,
		init,
		buttonStyle,
		isDisabled,
		format: formatValue,
		filter,
		check,
		onFocus,
		onBlur,
		onInput,
		emitChange,
		onChange,
		add: addValue,
		clickHandler,
		longPressStep,
		onTouchStart,
		onTouchEnd,
		clearLongPressTimeout,
		clearTimeout: clearLongPressTimeout
	})
</script>

<style lang="scss" scoped>
	$up-numberBox-hover-bgColor: #E6E6E6 !default;
	$up-numberBox-disabled-color: #c8c9cc !default;
	$up-numberBox-disabled-bgColor: #f7f8fa !default;
	$up-numberBox-plus-radius: 4px !default;
	$up-numberBox-minus-radius: 4px !default;
	$up-numberBox-input-text-align: center !default;
	$up-numberBox-input-font-size: 15px !default;
	$up-numberBox-input-padding: 0 !default;
	$up-numberBox-input-margin: 0 2px !default;
	$up-numberBox-input-disabled-color: #c8c9cc !default;
	$up-numberBox-input-disabled-bgColor: #f2f3f5 !default;

	.up-number-box {
		@include flex(row);
		align-items: center;

		&__slot {
			/* #ifndef APP-NVUE */
			// touch-action: none;
			/* #endif */
		}

		&__plus,
		&__minus {
			width: 35px;
			@include flex;
			justify-content: center;
			align-items: center;
			/* #ifndef APP-NVUE */
			// touch-action: none;
			/* #endif */

			&--hover {
				background-color: $up-numberBox-hover-bgColor !important;
			}

			&--disabled {
				color: $up-numberBox-disabled-color;
				background-color: $up-numberBox-disabled-bgColor;
			}
		}

		&__plus {
			border-top-right-radius: $up-numberBox-plus-radius;
			border-bottom-right-radius: $up-numberBox-plus-radius;
		}

		&__minus {
			border-top-left-radius: $up-numberBox-minus-radius;
			border-bottom-left-radius: $up-numberBox-minus-radius;
		}

		&__input {
			position: relative;
			text-align: $up-numberBox-input-text-align;
			font-size: $up-numberBox-input-font-size;
			padding: $up-numberBox-input-padding;
			margin: $up-numberBox-input-margin;
			@include flex;
			align-items: center;
			justify-content: center;

			&--disabled {
				color: $up-numberBox-input-disabled-color;
				background-color: $up-numberBox-input-disabled-bgColor;
			}
		}
	}
</style>
