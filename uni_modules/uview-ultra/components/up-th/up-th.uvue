<template>
	<view class="up-th" :style="[thStyle]">
		<slot></slot>
	</view>
</template>

<script>
	import { propsTh } from './props';
	import { mpMixin } from '../../libs/mixin/mpMixin';
	import { mixin } from '../../libs/mixin/mixin';
	import { addUnit, getParent, deepMerge } from '../../libs/function/index';
	/** 
	 * Td 表格中的单元格
	 * @description 
	 * @tutorial url
	 * @property {String | Number} 
	 * @event {Function}
	 * @example
	 */
	export default {
		name: 'up-th',
		mixins: [mpMixin, mixin, propsTh],
		props: {
			// 宽度，百分比或者具体带单位的值，如30%， 200rpx等，一般使用百分比
			width: {
				type: [String],
				default: ''
			}
		},
		data() {
			return {
				thStyle: {}
			}
		},
		created() {
			// this.parent = null;
		},
		mounted() {
			// @ts-ignore
			this.getParentData('up-table')
			if (this.parent != null) {
				// 将父组件的相关参数，合并到本组件
				let style = {};
				if (this.width != '') style.flex = `0 0 ${this.width}`;
				// @ts-ignore
				style['textAlign'] = this.parent.$props['align'];
				// @ts-ignore
				style['padding'] = this.parent.$props['padding'];
				// @ts-ignore
				style['borderBottom'] = `solid 1px ${this.parent.$props['borderColor']}`;
				// @ts-ignore
				style['borderRight'] = `solid 1px ${this.parent.$props['borderColor']}`;
				// @ts-ignore
				style = deepMerge(style, this.parent!.$props['thStyle'] ?? {});
				this.thStyle = style;
			}
		}
	}
</script>

<style lang="scss" scoped>
	.up-th {
		@include flex;
		flex-direction: column;
		flex: 1;
		justify-content: center;
		font-size: 28rpx;
		color: $up-main-color;
		font-weight: bold;
		background-color: rgb(245, 246, 248);
	}
</style>
