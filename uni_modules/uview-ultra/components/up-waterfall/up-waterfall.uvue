<template>
    <view class="up-waterfall">
        <!-- 新增支持多列布局 -->
        <view 
            v-for="(column, index) in columnList" 
            :key="index"
            :ref="`up-column-${index}`"
            :id="`up-column-${index}`"
            class="up-column"
            :style="getColumnStyle(index)"
        >
            <slot name="column"
                :colIndex="index" 
                :colList="column">
            </slot>
            <slot name="left"
                :colIndex="index" 
                :leftList="column">
            </slot>
            <template v-if="$slots['left'] == null && $slots['column'] == null"
				v-for="(item, itemIndex) in column" :key="itemIndex">
                <slot :item="item" :itemIndex="itemIndex"></slot>
            </template>
        </view>
    </view>
</template>

<script setup lang="uts">
    /**
     * waterfall 瀑布流
     * @description 这是一个瀑布流形式的组件，对原组件进行升级已经支持自定义列数模式，便于适配不同屏幕。搭配loadMore 加载更多组件，让您开箱即用，眼前一亮。
     * @tutorial https://uview-plus.jiangruyi.com/components/waterfall.html
     * @property {Array} flow-list 用于渲染的数据
     * @property {String Number} add-time 单条数据添加到队列的时间间隔，单位ms，见上方注意事项说明（默认200）
     * @property {String Number} columns 瀑布流列数，默认为2，设置为auto时自动根据屏幕宽度调整列数
     * @example <up-waterfall :flowList="flowList"></up-waterfall>
     */
    import { computed, getCurrentInstance, nextTick, onMounted, ref, watch, watchEffect } from 'vue';
    import defProps from './waterfall.uts';
    import { sleep, upGetRect } from '../../libs/function/index.uts';

    defineOptions({
        styleIsolation: 'app-and-page',
        name: 'up-waterfall'
    })

    const props = defineProps({
        modelValue: {
            // 瀑布流数据
            type: Array<UTSJSONObject>,
            required: true,
            default: (defProps['waterfall'] as UTSJSONObject)['value']
        },
        // 每次向结构插入数据的时间间隔，单位ms
        addTime: {
            type: [Number, String],
            default: (defProps['waterfall'] as UTSJSONObject)['addTime']
        },
        // id值，用于清除某一条数据时，根据此idKey名称找到并移除，如数据为{idx: 22, name: 'lisa'}
        idKey: {
            type: String,
            default: (defProps['waterfall'] as UTSJSONObject)['idKey']
        },
        // 瀑布流列数
        columns: {
            type: [Number, String],
            default: (defProps['waterfall'] as UTSJSONObject)['columns']
        },
        // 瀑布流最小列数
        columnsMin: {
            type: [Number, String],
            default: (defProps['waterfall'] as UTSJSONObject)['columnsMin']
        },
        // 最小列宽
        minColumnWidth: {
            type: Number,
            default: (defProps['waterfall'] as UTSJSONObject)['minColumnWidth']
        }
    })

    const emit = defineEmits(['update:modelValue', 'update:value', 'after-add-one', 'after-add-all'])
    const instance = getCurrentInstance()!.proxy!

    const columnList = ref<UTSJSONObject[][]>([[], []] as UTSJSONObject[][])
    // 用于标记是否已经初始化
    const initialized = ref(false)
    const windowWidth = ref(375)
    const windowHeight = ref(0)
    const resizeTimer = ref(0)
	const distributionQueue = ref<UTSJSONObject[]>([] as UTSJSONObject[])
	const distributionRunning = ref(false)
	const distributionGeneration = ref(0)
	const safeModelValue = (): UTSJSONObject[] => props.modelValue != null ? props.modelValue : [] as UTSJSONObject[]
	const safeColumnsMin = (): number => {
		const value = props.columnsMin != null ? parseInt(props.columnsMin.toString()) : 2
		return isNaN(value) ? 2 : value
	}
	const safeColumns = (): number => {
		const value = props.columns != null ? parseInt(props.columns.toString()) : 2
		return isNaN(value) ? 2 : value
	}
	const safeMinColumnWidth = (): number => props.minColumnWidth != null ? props.minColumnWidth : 230

    // 复制而不是引用对象和数组
    const cloneData = (data: UTSJSONObject[]): UTSJSONObject[] => {
        return JSON.parse(JSON.stringify(data)) as UTSJSONObject[]
    }

    // 破坏flowList变量的引用，否则watch的结果新旧值是一样的
    const copyFlowList = computed((): UTSJSONObject[] => {
        // @ts-ignore
        if (safeModelValue().length == 0) {
            return [] as UTSJSONObject[]
        }
        return cloneData(safeModelValue())
    })

    // 获取列数，支持auto模式
    const getColumnsCount = (): number => {
        if (props.columns === 'auto') {
            // 列间距为10rpx(约等于7px)
            const columnGap = 7
            // 计算可容纳的列数
            let columnCount = Math.max(1, Math.floor(windowWidth.value / (safeMinColumnWidth() + columnGap)))
			const minColumns = safeColumnsMin()
            if (columnCount < minColumns) {
                columnCount = minColumns
            }
            return columnCount
        }
		return safeColumns()
    }

    // 初始化列数据数组
    const initColumnList = (): void => {
        windowWidth.value = uni.getSystemInfoSync().windowWidth
        const cols = getColumnsCount()
        columnList.value = [] as UTSJSONObject[][]
        for (var index = 0; index < cols; index++) {
            columnList.value.push([] as UTSJSONObject[])
        }
    }

    // 清空数据列表
    function clear(bak: boolean = true): void {
        distributionGeneration.value += 1
        distributionQueue.value = [] as UTSJSONObject[]
        initColumnList()
        // 同时清除父组件列表中的数据
        if (bak) {
            emit('update:modelValue', [] as UTSJSONObject[])
        }
    }

    // 窗口大小变化处理函数
    const getColumnStyle = (index: number): UTSJSONObject => {
        const style = {} as UTSJSONObject
        if (index > 0) {
            style['marginLeft'] = '10rpx'
        }
        return style
    }

    // 判断新数据是否只在原数组末尾追加
    const isPureAppend = (newData: UTSJSONObject[], oldData: UTSJSONObject[]): boolean => {
        if (oldData.length == 0) return true
        if (newData.length < oldData.length) return false
        for (let index = 0; index < oldData.length; index++) {
            if (JSON.stringify(oldData[index]) != JSON.stringify(newData[index])) {
                return false
            }
        }
        return true
    }

    // 获取最短列；高度相同或暂不可测时按列数据量打散
    const getMinHeightColumnIndex = (columnHeights: Array<number>): number => {
        let minIndex = 0
        for (let index = 1; index < columnHeights.length; index++) {
            const currentHeight = columnHeights[index]
            const minHeight = columnHeights[minIndex]
            if (currentHeight < minHeight) {
                minIndex = index
            } else if (currentHeight == minHeight) {
                const currentLength = columnList.value[index].length
                const minLength = columnList.value[minIndex].length
                if (currentLength < minLength) {
                    minIndex = index
                }
            }
        }
        return minIndex
    }

    // 获取当前所有列的真实高度
    const getColumnHeights = async (): Promise<Array<number>> => {
        const columnHeights = [] as Array<number>
        for (let index = 0; index < columnList.value.length; index++) {
            columnHeights.push(0)
        }
        for (let index = 0; index < columnList.value.length; index++) {
            try {
                // @ts-ignore
                const rect: NodeInfo = await upGetRect(`#up-column-${index}`, false, instance)
                columnHeights[index] = rect.height ?? 0
            } catch (e) {
                columnHeights[index] = 0
            }
        }
        return columnHeights
    }

    // 逐项测量并分配数据，代数变化时立即退出
    const distributeData = async (newData: UTSJSONObject[], generation: number): Promise<void> => {
        let columnHeights = [] as Array<number>
        for (let dataIndex = 0; dataIndex < newData.length; dataIndex++) {
            if (generation != distributionGeneration.value) return
            columnHeights = await getColumnHeights()
            if (generation != distributionGeneration.value) return

            const item = newData[dataIndex]
            const minHeightIndex = getMinHeightColumnIndex(columnHeights)
            columnList.value[minHeightIndex].push(item)

            await sleep(props.addTime as number)
            if (generation != distributionGeneration.value) return
            await nextTick()
            if (generation != distributionGeneration.value) return
            try {
                // @ts-ignore
                const rect: NodeInfo = await upGetRect(`#up-column-${minHeightIndex}`, false, instance)
                if (generation != distributionGeneration.value) return
                if (rect.height != null) {
                    columnHeights[minHeightIndex] = rect.height ?? 0
                    emit('after-add-one', {
                        ...item,
                        height: rect.height
                    })
                }
            } catch (e) {
            }
        }
        if (generation != distributionGeneration.value) return
        emit('after-add-all', {
            columnHeights: columnHeights,
            newData: newData
        })
    }

    // 串行消费所有待分配数据
    async function runDistributionQueue(): Promise<void> {
        if (distributionRunning.value) return
        distributionRunning.value = true
        while (distributionQueue.value.length > 0) {
            const task = distributionQueue.value.shift()
            if (task == null) continue
            const generation = task['generation'] as number
            if (generation != distributionGeneration.value) continue
            const data = task['data'] as UTSJSONObject[]
            await distributeData(data, generation)
        }
        distributionRunning.value = false
        if (distributionQueue.value.length > 0) {
            runDistributionQueue()
        }
    }

    // 将新增数据加入共享队列，确保只有一个分配循环运行
    const handleData = (newData: UTSJSONObject[]): void => {
        if (newData.length == 0) return
        const task = {} as UTSJSONObject
        task['generation'] = distributionGeneration.value
        task['data'] = cloneData(newData)
        distributionQueue.value.push(task)
        if (!distributionRunning.value) {
            runDistributionQueue()
        }
    }

    // 重新分配所有数据
    function redistributeData(data: UTSJSONObject[] | null = null): void {
        clear(false)
        const allData = cloneData(data != null ? data : copyFlowList.value)
        handleData(allData)
    }

    const handleWindowResize = (res: UTSJSONObject): void => {
        const size = res['size'] as UTSJSONObject | null
        if (size != null) {
            const width = size['windowWidth']
            const height = size['windowHeight']
            if (width != null) {
                windowWidth.value = parseInt(width.toString())
            }
            if (height != null) {
                windowHeight.value = parseInt(height.toString())
            }
        } else {
            windowWidth.value = uni.getSystemInfoSync().windowWidth
        }
        const newColumnsCount = getColumnsCount()
        const oldColumnsCount = columnList.value.length
        if (newColumnsCount != oldColumnsCount) {
            redistributeData(copyFlowList.value)
        }
    }

    // 清除某一条指定的数据，根据id实现
    const remove = (id: any | null): void => {
        if (id == null) return
        // 遍历所有列查找并删除数据
        for (let i = 0; i < columnList.value.length; i++) {
            const index = (columnList.value[i] as UTSJSONObject[]).findIndex((val: UTSJSONObject) => {
                // @ts-ignore
                return val[props.idKey].toString() == id.toString()
            })
            if (index != -1) {
                columnList.value[i].splice(index, 1)
                break
            }
        }

        // 同时清除父组件的数据中的对应id的条目
        // @ts-ignore
        const modelValueIndex = safeModelValue().findIndex((val: UTSJSONObject) => {
            // @ts-ignore
            return val[props.idKey].toString() == id.toString()
        })
        if (modelValueIndex != -1) {
            const newModelValue = cloneData(safeModelValue())
            newModelValue.splice(modelValueIndex, 1)
            emit('update:modelValue', newModelValue)
        }
    }

    // 修改某条数据的某个属性
    const modify = (id: any, key: string, value: any): void => {
        let found = false
        let targetItem: UTSJSONObject = {}

        // 在所有列中查找数据
        for (let i = 0; i < columnList.value.length; i++) {
            const index = columnList.value[i].findIndex((val: UTSJSONObject) => {
                // @ts-ignore
                return val[props.idKey] != null && val[props.idKey].toString() == id.toString()
            })
            if (index != -1) {
                // 修改对应key的值
                columnList.value[i][index][key] = value
                targetItem = columnList.value[i][index]
                found = true
                break
            }
        }

        // @ts-ignore
        if (found && targetItem != null) {
            // 修改父组件的数据中的对应id的条目
            // @ts-ignore
            const modelValueIndex = safeModelValue().findIndex((val: UTSJSONObject) => {
                // @ts-ignore
                return val[props.idKey] != null && val[props.idKey].toString() == id.toString()
            })
            if (modelValueIndex != -1) {
                let data = cloneData(safeModelValue())
                data[modelValueIndex][key] = value
                emit('update:modelValue', data)
            }
        }
    }

    initColumnList()

    let previousFlowList = [] as UTSJSONObject[]
    watchEffect(() => {
        const nVal = copyFlowList.value
        const oVal = previousFlowList
        previousFlowList = cloneData(nVal)
        nextTick(() => {
            if (nVal.length == 0) {
                clear(false)
            } else {
                if (columnList.value.length == 1) {
                    initColumnList()
                }
                if (!isPureAppend(nVal, oVal)) {
                    redistributeData(nVal)
                    return
                }
                handleData(nVal.slice(oVal.length))
            }
        })
    })

    watch((): any => props.columns, () => {
        if (copyFlowList.value.length > 0) {
            redistributeData(copyFlowList.value)
        } else {
            clear(false)
        }
    })

    onMounted(() => {
        initialized.value = true
        // 添加窗口大小变化监听
        // #ifdef H5
        if (props.columns === 'auto') {
            // @ts-ignore
            uni.onWindowResize(handleWindowResize)
        }
        // #endif
    })

    defineExpose({
        columnList,
        initialized,
        windowWidth,
        windowHeight,
        resizeTimer,
        copyFlowList,
        initColumnList,
        getColumnsCount,
        getColumnStyle,
        handleWindowResize,
        redistributeData,
        handleData,
        cloneData,
        clear,
        remove,
        modify
    })
</script>

<style lang="scss" scoped>
    .up-waterfall {
        @include flex;
        flex-direction: row;
        align-items: flex-start;
    }

    .up-column {
        @include flex;
        flex: 1;
        flex-direction: column;
        overflow: hidden;
        /* #ifndef APP-NVUE */
        height: 100%;
        /* #endif */
    }

    .up-image {
        /* #ifndef APP-NVUE */
        // max-width: 100%;
        /* #endif */
    }
</style>
