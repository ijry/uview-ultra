<template>
    <view class="up-waterfall">
        <!-- 新增支持多列布局 -->
        <view 
            v-for="(column, index) in columnList" 
            :key="index"
            :ref="`up-column-${index}`"
            :id="`up-column-${index}`"
            class="up-column"
            :style="getColumnStyle(index)"
        >
            <slot name="column"
                :colIndex="index" 
                :colList="column">
            </slot>
            <slot name="left"
                :colIndex="index" 
                :leftList="column">
            </slot>
            <template v-if="$slots['left'] == null && $slots['column'] == null"
				v-for="(item, itemIndex) in column" :key="itemIndex">
                <slot :item="item" :itemIndex="itemIndex"></slot>
            </template>
        </view>
    </view>
</template>

<script setup lang="uts">
    /**
     * waterfall 瀑布流
     * @description 这是一个瀑布流形式的组件，对原组件进行升级已经支持自定义列数模式，便于适配不同屏幕。搭配loadMore 加载更多组件，让您开箱即用，眼前一亮。
     * @tutorial https://uview-plus.jiangruyi.com/components/waterfall.html
     * @property {Array} flow-list 用于渲染的数据
     * @property {String Number} add-time 单条数据添加到队列的时间间隔，单位ms，见上方注意事项说明（默认200）
     * @property {String Number} columns 瀑布流列数，默认为2，设置为auto时自动根据屏幕宽度调整列数
     * @example <up-waterfall :flowList="flowList"></up-waterfall>
     */
    import { computed, getCurrentInstance, nextTick, onMounted, ref, watch, watchEffect } from 'vue';
    import defProps from './waterfall.uts';
    import { sleep, upGetRect } from '../../libs/function/index.uts';

    defineOptions({
        styleIsolation: 'app-and-page',
        name: 'up-waterfall'
    })

    const props = defineProps({
        modelValue: {
            // 瀑布流数据
            type: Array<UTSJSONObject>,
            required: true,
            default: (defProps['waterfall'] as UTSJSONObject)['value']
        },
        // 每次向结构插入数据的时间间隔，单位ms
        addTime: {
            type: [Number, String],
            default: (defProps['waterfall'] as UTSJSONObject)['addTime']
        },
        // id值，用于清除某一条数据时，根据此idKey名称找到并移除，如数据为{idx: 22, name: 'lisa'}
        idKey: {
            type: String,
            default: (defProps['waterfall'] as UTSJSONObject)['idKey']
        },
        // 瀑布流列数
        columns: {
            type: [Number, String],
            default: (defProps['waterfall'] as UTSJSONObject)['columns']
        },
        // 瀑布流最小列数
        columnsMin: {
            type: [Number, String],
            default: (defProps['waterfall'] as UTSJSONObject)['columnsMin']
        },
        // 最小列宽
        minColumnWidth: {
            type: Number,
            default: (defProps['waterfall'] as UTSJSONObject)['minColumnWidth']
        }
    })

    const emit = defineEmits(['update:modelValue', 'update:value', 'after-add-one', 'after-add-all'])
    const instance = getCurrentInstance()!.proxy!

    const columnList = ref<UTSJSONObject[][]>([[], []] as UTSJSONObject[][])
    // 用于标记是否已经初始化
    const initialized = ref(false)
    const windowWidth = ref(375)
    const windowHeight = ref(0)
    const resizeTimer = ref(0)
	const safeModelValue = (): UTSJSONObject[] => props.modelValue != null ? props.modelValue : [] as UTSJSONObject[]
	const safeColumnsMin = (): number => {
		const value = props.columnsMin != null ? parseInt(props.columnsMin.toString()) : 2
		return isNaN(value) ? 2 : value
	}
	const safeColumns = (): number => {
		const value = props.columns != null ? parseInt(props.columns.toString()) : 2
		return isNaN(value) ? 2 : value
	}
	const safeMinColumnWidth = (): number => props.minColumnWidth != null ? props.minColumnWidth : 230

    // 复制而不是引用对象和数组
    const cloneData = (data: UTSJSONObject[]): UTSJSONObject[] => {
        return JSON.parse(JSON.stringify(data)) as UTSJSONObject[]
    }

    // 破坏flowList变量的引用，否则watch的结果新旧值是一样的
    const copyFlowList = computed((): UTSJSONObject[] => {
        // @ts-ignore
        if (safeModelValue().length == 0) {
            return [] as UTSJSONObject[]
        }
        return cloneData(safeModelValue())
    })

    // 获取列数，支持auto模式
    const getColumnsCount = (): number => {
        if (props.columns === 'auto') {
            // 列间距为10rpx(约等于7px)
            const columnGap = 7
            // 计算可容纳的列数
            let columnCount = Math.max(1, Math.floor(windowWidth.value / (safeMinColumnWidth() + columnGap)))
			const minColumns = safeColumnsMin()
            if (columnCount < minColumns) {
                columnCount = minColumns
            }
            return columnCount
        }
		return safeColumns()
    }

    // 初始化列数据数组
    const initColumnList = (): void => {
        windowWidth.value = uni.getSystemInfoSync().windowWidth
        const cols = getColumnsCount()
        columnList.value = [] as UTSJSONObject[][]
        for (var index = 0; index < cols; index++) {
            columnList.value.push([] as UTSJSONObject[])
        }
    }

    // 窗口大小变化处理函数
    const getColumnStyle = (index: number): UTSJSONObject => {
        const style = {} as UTSJSONObject
        if (index > 0) {
            style['marginLeft'] = '10rpx'
        }
        return style
    }

    // 处理新增数据
    const handleData = async (newData: UTSJSONObject[]): Promise<void> => {
        // @ts-ignore
        if (newData.length == 0) return

        // 初始化列高度数组
        let columnHeights: Array<number> = []
        for (var index = 0; index < columnList.value.length; index++) {
            columnHeights.push(0)
        }

        // 获取各列当前高度
        for (let i = 0; i < columnList.value.length; i++) {
            // @ts-ignore
            const rect: NodeInfo = await upGetRect(`#up-column-${i}`, false, instance)
            columnHeights[i] = rect.height ?? 0
        }

        // 分配新数据到最短的列
        for (let item of newData) {
            const minHeightIndex = columnHeights.indexOf(Math.min(...columnHeights))
            columnList.value[minHeightIndex].push(item)

            // 获取实际渲染后的元素高度而不是估算
            await sleep(props.addTime as number)
            await nextTick()
            try {
                // @ts-ignore
                const rect: NodeInfo = await upGetRect(`#up-column-${minHeightIndex}`, false, instance)
                if (rect.height != null) {
                    columnHeights[minHeightIndex] = rect.height ?? 0
                    // 加载一个后置事件
                    emit('after-add-one', {
                        ...item,
                        height: rect.height
                    })
                }
            } catch (e) {
                // console.log(e)
            }
        }
        // 加载所有后置事件
        emit('after-add-all', {
            columnHeights: columnHeights,
            newData: newData
        })
    }

    // 重新分配所有数据
    const redistributeData = async (): Promise<void> => {
        // 清空所有列
        initColumnList()
        // 保存所有数据
        const allData = cloneData(copyFlowList.value)
        // 重新分配数据
        handleData(allData)
    }

    const handleWindowResize = (res: UTSJSONObject): void => {
        const size = res['size'] as UTSJSONObject | null
        if (size != null) {
            const width = size['windowWidth']
            const height = size['windowHeight']
            if (width != null) {
                windowWidth.value = parseInt(width.toString())
            }
            if (height != null) {
                windowHeight.value = parseInt(height.toString())
            }
        } else {
            windowWidth.value = uni.getSystemInfoSync().windowWidth
        }
        const newColumnsCount = getColumnsCount()
        const oldColumnsCount = columnList.value.length
        if (newColumnsCount != oldColumnsCount) {
            redistributeData()
        }
    }

    // 清空数据列表
    function clear(bak: boolean = true): void {
        initColumnList()
        // 同时清除父组件列表中的数据
        if (bak) {
            emit('update:modelValue', [] as UTSJSONObject[])
        }
    }

    // 清除某一条指定的数据，根据id实现
    const remove = (id: any | null): void => {
        if (id == null) return
        // 遍历所有列查找并删除数据
        for (let i = 0; i < columnList.value.length; i++) {
            const index = (columnList.value[i] as UTSJSONObject[]).findIndex((val: UTSJSONObject) => {
                // @ts-ignore
                return val[props.idKey].toString() == id.toString()
            })
            if (index != -1) {
                columnList.value[i].splice(index, 1)
                break
            }
        }

        // 同时清除父组件的数据中的对应id的条目
        // @ts-ignore
        const modelValueIndex = safeModelValue().findIndex((val: UTSJSONObject) => {
            // @ts-ignore
            return val[props.idKey].toString() == id.toString()
        })
        if (modelValueIndex != -1) {
            const newModelValue = cloneData(safeModelValue())
            newModelValue.splice(modelValueIndex, 1)
            emit('update:modelValue', newModelValue)
        }
    }

    // 修改某条数据的某个属性
    const modify = (id: any, key: string, value: any): void => {
        let found = false
        let targetItem: UTSJSONObject = {}

        // 在所有列中查找数据
        for (let i = 0; i < columnList.value.length; i++) {
            const index = columnList.value[i].findIndex((val: UTSJSONObject) => {
                // @ts-ignore
                return val[props.idKey] != null && val[props.idKey].toString() == id.toString()
            })
            if (index != -1) {
                // 修改对应key的值
                columnList.value[i][index][key] = value
                targetItem = columnList.value[i][index]
                found = true
                break
            }
        }

        // @ts-ignore
        if (found && targetItem != null) {
            // 修改父组件的数据中的对应id的条目
            // @ts-ignore
            const modelValueIndex = safeModelValue().findIndex((val: UTSJSONObject) => {
                // @ts-ignore
                return val[props.idKey] != null && val[props.idKey].toString() == id.toString()
            })
            if (modelValueIndex != -1) {
                let data = cloneData(safeModelValue())
                data[modelValueIndex][key] = value
                emit('update:modelValue', data)
            }
        }
    }

    initColumnList()

    let previousFlowLength = 0
    watchEffect(() => {
        const nVal = copyFlowList.value
        const startIndex = nVal.length < previousFlowLength ? 0 : previousFlowLength
        previousFlowLength = nVal.length
        const addedData = nVal.slice(startIndex)
        nextTick(() => {
            if (nVal.length == 0) {
                clear(false)
            } else {
                if (columnList.value.length == 1) {
                    initColumnList()
                }
                handleData(addedData)
            }
        })
    })

    watch((): any => props.columns, () => {
        initColumnList()
        // 重新分配数据
        if (copyFlowList.value.length > 0) {
            redistributeData()
        }
    })

    onMounted(() => {
        initialized.value = true
        // 添加窗口大小变化监听
        // #ifdef H5
        if (props.columns === 'auto') {
            // @ts-ignore
            uni.onWindowResize(handleWindowResize)
        }
        // #endif
    })

    defineExpose({
        columnList,
        initialized,
        windowWidth,
        windowHeight,
        resizeTimer,
        copyFlowList,
        initColumnList,
        getColumnsCount,
        getColumnStyle,
        handleWindowResize,
        redistributeData,
        handleData,
        cloneData,
        clear,
        remove,
        modify
    })
</script>

<style lang="scss" scoped>
    .up-waterfall {
        @include flex;
        flex-direction: row;
        align-items: flex-start;
    }

    .up-column {
        @include flex;
        flex: 1;
        flex-direction: column;
        overflow: hidden;
        /* #ifndef APP-NVUE */
        height: 100%;
        /* #endif */
    }

    .up-image {
        /* #ifndef APP-NVUE */
        // max-width: 100%;
        /* #endif */
    }
</style>
