<template>
	<view
	    class="up-tabbar-item"
	    :style="rootStyle"
	    :class="[isMidButton ? 'up-tabbar-item--mid-button' : '']"
	    @tap="clickHandler"
	>
		<view 
			class="up-tabbar-item__icon"
			:class="[isMidButton ? 'up-tabbar-item__icon--mid-button' : '']"
		>
			<view class="up-tabbar-item--mid-button-cover" v-if="isMidButton">
			</view>
			<up-icon
			    v-if="icon"
			    :name="icon"
			    :color="iconColor"
			    :size="isMidButton ? 26 : 20"
			></up-icon>
			<template v-else>
				<slot
				    v-if="isActive"
				    name="active-icon"
				/>
				<slot
				    v-else
				    name="inactive-icon"
				/>
			</template>
			<up-badge
				absolute
				:offset="[0, dot ? '34rpx' : parseInt(badge.toString()) > 9 ? '14rpx' : '20rpx']"
			    :customStyle="badgeStyle"
			    :isDot="dot"
			    :value="badge != null  ? (dot ? 1 : badge) : 0"
			    :show="dot ? dot : parseInt(badge.toString()) > 0"
			></up-badge>
		</view>
		
		<slot name="text">
			<text
			    class="up-tabbar-item__text"
			    :style="textStyle"
			>{{ text }}</text>
		</slot>
	</view>
</template>

<script setup lang="uts">
	import { computed, getCurrentInstance, nextTick, onBeforeUnmount, onMounted, ref } from 'vue';
	import defProps from './tabbarItem.uts';
	import { addStyle, error } from '../../libs/function/index.uts';
	import { useUltraUI } from '../../libs/composable/useUltraUI.uts';
	/**
	 * TabbarItem 底部导航栏子组件
	 * @description 此组件提供了自定义tabbar的能力。
	 * @tutorial https://uview-plus.jiangruyi.com/components/tabbar.html
	 * @property {String | Number}	name		item标签的名称，作为与up-tabbar的value参数匹配的标识符
	 * @property {String}			icon		uView内置图标或者绝对路径的图片
	 * @property {String | Number}	badge		右上角的角标提示信息
	 * @property {Boolean}			dot			是否显示圆点，将会覆盖badge参数（默认 false ）
	 * @property {String}			text		描述文本
	 * @property {Object | String}	badgeStyle	控制徽标的位置，对象或者字符串形式，可以设置top和right属性（默认 'top: 6px;right:2px;' ）
	 * @property {Object}			customStyle	定义需要用到的外部样式
	 * 
	 * @example <up-tabbar :value="value2" :placeholder="false" @change="name => value2 = name" :fixed="false" :safeAreaInsetBottom="false"><up-tabbar-item text="首页" icon="home" dot ></up-tabbar-item></up-tabbar>
	 */
	const { parent, parentData, getParentData } = useUltraUI({
		value: null as string | number | null,
		activeColor: '',
		inactiveColor: ''
	} as UTSJSONObject)
	const instance = getCurrentInstance()!.proxy!

	defineOptions({
		name: 'up-tabbar-item',
		options: {
			virtualHost: true
		}
	})

	const props = defineProps({
		// item标签的名称，作为与u-tabbar的value参数匹配的标识符
		name: {
			type: [String, Number, null],
			default: (defProps['tabbarItem'] as UTSJSONObject)['name']
		},
		// uview-plus内置图标或者绝对路径的图片
		icon: {
			type: String,
			default: (defProps['tabbarItem'] as UTSJSONObject)['icon']
		},
		// 右上角的角标提示信息
		badge: {
			type: [String, Number, null],
			default: (defProps['tabbarItem'] as UTSJSONObject)['badge']
		},
		// 是否显示圆点，将会覆盖badge参数
		dot: {
			type: Boolean,
			default: (defProps['tabbarItem'] as UTSJSONObject)['dot']
		},
		// 描述文本
		text: {
			type: String,
			default: (defProps['tabbarItem'] as UTSJSONObject)['text']
		},
		// 控制徽标的位置，对象或者字符串形式，可以设置top和right属性
		badgeStyle: {
			type: [UTSJSONObject, String],
			default: (defProps['tabbarItem'] as UTSJSONObject)['badgeStyle']
		},
		// 模式，默认普通模式，midButton中间按钮模式
		mode: {
			type: String,
			default: (defProps['tabbarItem'] as UTSJSONObject)['mode']
		},
		customStyle: {
			type: [Object, String],
			default: {}
		}
	})

	const emit = defineEmits(["click", "change"])
	const isActive = ref(false)
	const routeSyncTimer = ref(0 as number)
	const routeSyncLast = ref('')

	// 计算是否为中间按钮
	const isMidButton = computed((): boolean => {
		return props.mode === 'midButton'
	})

	const rootStyle = computed((): UTSJSONObject => {
		return addStyle(props.customStyle) as UTSJSONObject
	})

	const iconColor = computed((): string => {
		const color = isActive.value ? parentData.value['activeColor'] : parentData.value['inactiveColor']
		return color != null ? color.toString() : ''
	})

	const textStyle = computed((): UTSJSONObject => {
		return {
			color: iconColor.value
		} as UTSJSONObject
	})

	const getChildIndexLocal = (): number => {
		if (parent.value == null) return -1
		const list = parent.value.$callMethod('getChildren') as ComponentPublicInstance[]
		for (let i = 0; i < list.length; i++) {
			if (list[i] === instance) {
				return i
			}
		}
		return -1
	}

	const clearRouteSync = (): void => {
		if (routeSyncTimer.value != 0) {
			clearInterval(routeSyncTimer.value)
			routeSyncTimer.value = 0
		}
	}

	const getCurrentRoutePath = (): string => {
		// @ts-ignore
		const pages = getCurrentPages()
		if (pages == null || pages.length == 0) return ''
		const currentPage = pages[pages.length - 1]
		// @ts-ignore
		const route = (currentPage != null && currentPage.route != null) ? currentPage.route.toString() : ''
		if (route == '') return ''
		return route.startsWith('/') ? route : `/${route}`
	}

	const normalizeRoutePath = (path: string): string => {
		return path.replace(/^[#\\/]+/, '')
	}

	const updateParentData = (): void => {
		getParentData('up-tabbar', instance, false)
	}

	const syncActiveByRouteOrValue = (): void => {
		updateParentData()
		const index = getChildIndexLocal()
		const name = props.name != null ? props.name : index
		const routePath = getCurrentRoutePath()
		if (typeof name === 'string' && routePath != '') {
			const isRouteMatch = normalizeRoutePath(name) == normalizeRoutePath(routePath)
			if (isRouteMatch) {
				isActive.value = true
				return
			}
		}
		isActive.value = name === parentData.value['value']
	}

	const startRouteSync = (): void => {
		clearRouteSync()
		if (!(typeof props.name === 'string' && props.name.indexOf('/') > -1)) return
		routeSyncLast.value = getCurrentRoutePath()
		routeSyncTimer.value = setInterval(() => {
			const current = getCurrentRoutePath()
			if (current != routeSyncLast.value) {
				routeSyncLast.value = current
				syncActiveByRouteOrValue()
			}
		}, 200) as number
	}

	const init = (): void => {
		if (parent.value == null) {
			updateParentData()
		}
		if (parent.value == null) {
			error('up-tabbar-item必须搭配up-tabbar组件使用')
		}
		syncActiveByRouteOrValue()
	}

	// 此方法将会被父组件up-tabbar调用
	const updateFromParent = (): void => {
		// 重新初始化
		init()
	}

	const clickHandler = (): void => {
		nextTick(() => {
			const index = getChildIndexLocal()
			const name = props.name != null ? props.name : index
			// 点击的item为非激活的item才发出change事件
			if (parent.value != null && name.toString() != parentData.value['value']?.toString()) {
				parent.value.$callMethod('emitChange', name)
			}
			emit('click', name)
		})
	}

	onMounted(() => {
		init()
		startRouteSync()
	})

	onBeforeUnmount(() => {
		clearRouteSync()
	})

	defineExpose({
		isActive,
		routeSyncTimer,
		routeSyncLast,
		parentData,
		isMidButton,
		rootStyle,
		iconColor,
		textStyle,
		clearRouteSync,
		getCurrentRoutePath,
		normalizeRoutePath,
		syncActiveByRouteOrValue,
		startRouteSync,
		init,
		updateParentData,
		updateFromParent,
		clickHandler
	})
</script>

<style lang="scss" scoped>
	@import '../../libs/css/components.scss';
	
	.up-tabbar-item {
		@include flex(column);
		align-items: center;
		justify-content: center;
		flex: 1;
		/* #ifndef APP-NVUE */
		width: 100%;
		height: 100%;
		/* #endif */
		/* #ifdef H5 */
		cursor: pointer;
		/* #endif */
		
		&__icon {
			@include flex;
			position: relative;
			width: 150rpx;
			justify-content: center;
		}

		&__text {
			margin-top: 2px;
			font-size: 12px;
			color: $up-content-color;
		}
	}
	
	// 中间按钮样式
	.up-tabbar-item--mid-button {
		/* #ifndef APP-NVUE */
		transform: translateY(-10px);
		/* #endif */
	}
	
	.up-tabbar-item--mid-button-cover {
		background-color: #fff;
		position: absolute;
		top: 22px;
		left: -10px;
		// right: -10px;
		width: 90px;
		bottom: 0;
	}
	
	.up-tabbar-item__icon--mid-button {
		width: 70px;
		height: 70px;
		border-radius: 100px;
		background-color: #ffffff;
		box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* #ifdef MP */
	// 由于小程序都使用shadow DOM形式实现，需要给影子宿主设置flex: 1才能让其撑开
	:host {
		flex: 1;
		width: 100%;
	}
	/* #endif */
</style>
