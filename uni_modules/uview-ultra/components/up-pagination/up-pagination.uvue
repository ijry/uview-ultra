<template>
  <view v-if="!hideOnSinglePage || totalPages > 1" class="up-pagination">
    <!-- 上一页按钮 -->
    <view
      :class="[
        'up-pagination-btn',
        { 'up-pagination-btn--disabled': currentPage === 1 }
      ]"
      :style="{ backgroundColor: buttonBgColor, borderColor: buttonBorderColor }"
      @click="prev"
    >
      <template v-if="prevText">
        {{ prevText }}
      </template>
      <up-icon v-else name="arrow-left"></up-icon>
    </view>

    <!-- 页码列表 -->
    <template v-if="showPager">
      <view
        v-for="(page, index) in displayedPages"
        :key="index"
        :class="[
          'up-pagination-item',
          { 'up-pagination-item--active': page === currentPage }
        ]"
        @click="goTo(page)"
      >
        {{ page }}
      </view>
    </template>

    <!-- 总数显示 -->
    <view v-if="total > 0 && showTotal" class="up-pagination-total">
      {{ currentPage }} / {{ totalPages }}
    </view>

    <!-- 每页数量选择器 -->
    <!-- <picker
      v-if="showSizes"
      mode="selector"
      :range="pageSizes"
      range-key="label"
      :value="pageSizeIndex"
      @change="handleSizeChange"
      class="up-pagination-sizes"
    >
      <view>{{ pageSizeLabel }}</view>
    </picker> -->

    <!-- 下一页按钮 -->
    <view
      :class="[
        'up-pagination-btn',
        { 'up-pagination-btn--disabled': currentPage === totalPages }
      ]"
      :style="{ backgroundColor: buttonBgColor, borderColor: buttonBorderColor }"
      @click="next"
    >
      <template v-if="nextText">
        {{ nextText }}
      </template>
      <up-icon v-else name="arrow-right"></up-icon>
    </view>

    <!-- 跳转输入框 -->
    <!-- <view v-if="showJumper">
      <text>鍓嶅線</text>
      <input
        type="number"
        class="up-pagination-jumper"
        :value="currentPageInput"
        @input="onInputPage"
        @confirm="onConfirmPage"
      />
      <text>椤?/text>
    </view> -->
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import type { PropType } from 'vue'
import { t } from '../../libs/i18n'

function createPageSizeOptions(): UTSJSONObject[] {
  const items = [] as UTSJSONObject[]
  const values = [10, 20, 30, 40, 50]
  for (let i = 0; i < values.length; i++) {
    const item = {} as UTSJSONObject
    item['label'] = values[i].toString()
    item['value'] = values[i]
    items.push(item)
  }
  return items
}

function createDisplayedPages(): Array<string | number> {
  return [] as Array<string | number>
}

function normalizeNumber(value: any | null, defaultValue: number = 0): number {
  if (typeof value === 'number') {
    return value
  }
  if (value == null) {
    return defaultValue
  }
  const parsed = parseInt(value.toString())
  return isNaN(parsed) ? defaultValue : parsed
}

function hasLayoutItem(layout: string | null, name: string): boolean {
  if (layout == null || layout == '') return false
  const items = layout.split(',')
  for (let i = 0; i < items.length; i++) {
    if (items[i].trim() == name) {
      return true
    }
  }
  return false
}

function getPageSizeValue(item: UTSJSONObject): number {
  const value = item['value']
  return value == null ? 0 : normalizeNumber(value, 0)
}

function getPageSizeLabel(item: UTSJSONObject): string {
  const label = item['label']
  if (label != null && label.toString() != '') {
    return label.toString()
  }
  return getPageSizeValue(item).toString()
}

defineOptions({
  styleIsolation: 'app-and-page',
  name: 'up-pagination'
})

const props = defineProps({
    // 当前页码
    currentPage: {
      type: Number,
      default: 1
    },
    // 每页条目数
    pageSize: {
      type: Number,
      default: 10
    },
    // 总数据条目数
    total: {
      type: Number,
      default: 0
    },
    // 上一页按钮文案
    prevText: {
      type: String,
      default: ''
    },
    // 下一页按钮文案
    nextText: {
      type: String,
      default: ''
    },
    buttonBgColor: {
      type: String,
      default: '#f5f7fa'
    },
    buttonBorderColor: {
      type: String,
      default: '#dcdfe6'
    },
    // 可选的每页条目数
    pageSizes: {
      type: Array as PropType<UTSJSONObject[]>,
      default(): UTSJSONObject[] {
        return [
          { label: '10', value: 10 },
          { label: '20', value: 20 },
          { label: '30', value: 30 },
          { label: '40', value: 40 },
          { label: '50', value: 50 }
        ] as UTSJSONObject[]
      }
    },
    // 布局方式（类似 el-pagination）
    layout: {
      type: String,
      default: 'prev, pager, next'
    },
    // 是否隐藏只有一个页面时的分页控件
    hideOnSinglePage: {
      type: Boolean,
      default: false
    }
})

const emit = defineEmits(['update:currentPage', 'update:pageSize', 'current-change', 'size-change'])
const currentPageInput = ref(props.currentPage.toString())

const totalPages = computed((): number => {
  return Math.max(1, Math.ceil(props.total / props.pageSize))
})

const showPager = computed((): boolean => {
  return hasLayoutItem(props.layout, 'pager')
})

const showTotal = computed((): boolean => {
  return hasLayoutItem(props.layout, 'total')
})

const showSizes = computed((): boolean => {
  return hasLayoutItem(props.layout, 'sizes')
})

const showJumper = computed((): boolean => {
  return hasLayoutItem(props.layout, 'jumper')
})

const pageSizeIndex = computed((): number => {
  const sizes = props.pageSizes as UTSJSONObject[]
  for (let i = 0; i < sizes.length; i++) {
    if (getPageSizeValue(sizes[i]) == props.pageSize) {
      return i
    }
  }
  return 0
})

const pageSizeLabel = computed((): string => {
  const sizes = props.pageSizes as UTSJSONObject[]
  for (let i = 0; i < sizes.length; i++) {
    if (getPageSizeValue(sizes[i]) == props.pageSize) {
      return getPageSizeLabel(sizes[i])
    }
  }
  return props.pageSize.toString()
})

const displayedPages = computed((): Array<string | number> => {
  const total = totalPages.value
  const current = props.currentPage
  const pages = createDisplayedPages()

  if (total <= 4) {
    for (let i = 1; i <= total; i++) {
      pages.push(i)
    }
    return pages
  }

  // 当前页靠近头部
  if (current <= 2) {
    for (let i = 1; i <= 4; i++) {
      pages.push(i)
    }
    pages.push('...')
    pages.push(total)
    return pages
  }

  // 当前页在尾部附近
  if (current >= total - 1) {
    pages.push(1)
    pages.push('...')
    for (let i = total - 3; i <= total; i++) {
      pages.push(i)
    }
    return pages
  }

  // 中间情况
  pages.push(1)
  pages.push('...')
  pages.push(current - 1)
  pages.push(current)
  pages.push(current + 1)
  pages.push('...')
  pages.push(total)
  return pages
})

watch((): number => props.currentPage, (val: number) => {
  currentPageInput.value = val.toString()
})

const handleSizeChange = (e: UniCustomEvent<UTSJSONObject>): void => {
  let selected = 0
  if (e.detail != null && e.detail['value'] != null) {
    selected = normalizeNumber(e.detail['value'], 0)
  }
  const sizes = props.pageSizes as UTSJSONObject[]
  let size = props.pageSize
  if (selected >= 0 && selected < sizes.length) {
    size = getPageSizeValue(sizes[selected])
  } else if (sizes.length > 0) {
    size = getPageSizeValue(sizes[0])
  }
  emit('update:pageSize', size)
  emit('size-change', size)
}

function goTo(page: string | number): void {
  if (page === '...' || page === props.currentPage) {
    return
  }
  const nextPage = normalizeNumber(page, props.currentPage)
  emit('update:currentPage', nextPage)
  emit('current-change', nextPage)
}

const prev = (): void => {
  if (props.currentPage > 1) {
    goTo(props.currentPage - 1)
  }
}

const next = (): void => {
  if (props.currentPage < totalPages.value) {
    goTo(props.currentPage + 1)
  }
}

const onInputPage = (e: UniCustomEvent<UTSJSONObject>): void => {
  if (e.detail != null && e.detail['value'] != null) {
    currentPageInput.value = e.detail['value'].toString()
  }
}

const onConfirmPage = (e: UniCustomEvent<UTSJSONObject>): void => {
  let num = NaN
  if (e.detail != null && e.detail['value'] != null) {
    num = parseInt(e.detail['value'].toString())
  }
  if (!isNaN(num) && num >= 1 && num <= totalPages.value) {
    goTo(num)
  }
}

defineExpose({
  currentPageInput,
  totalPages,
  showPager,
  showTotal,
  showSizes,
  showJumper,
  pageSizeIndex,
  pageSizeLabel,
  displayedPages,
  handleSizeChange,
  prev,
  next,
  goTo,
  onInputPage,
  onConfirmPage
})
</script>

<style lang="scss" scoped>
.up-pagination {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  font-size: 14px;
  color: #606266;
}

.up-pagination-total {
  margin-right: 10px;
}

.up-pagination-sizes {
  margin-right: 10px;
  padding: 4px 4px;
  border: 1rpx solid #dcdfe6;
  border-radius: 4px;
}

.up-pagination-btn {
  margin: 0 3px;
  padding: 4px 4px;
  border: 1rpx solid #dcdfe6;
  border-radius: 4px;
  background-color: #f5f7fa;
}

.up-pagination-btn--disabled {
  opacity: 0.5;
}

.up-pagination-item {
  margin: 0 2px;
  padding: 4px 8px;
  border-radius: 4px;
}

.up-pagination-item--active {
  background-color: #409eff;
  color: white;
}

.up-pagination-jumper {
  width: 40px;
  height: 28px;
  margin: 0 5px;
  padding: 0 5px;
  border: 1rpx solid #dcdfe6;
  border-radius: 4px;
  font-size: 14px;
}
</style>
