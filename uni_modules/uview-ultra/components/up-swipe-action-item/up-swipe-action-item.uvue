<template>	
	<view class="up-swipe-action-item" ref="up-swipe-action-item">
		<view class="up-swipe-action-item__right">
			<slot name="button">
				<view v-for="(item,index) in options as UPSwipeActionItemOption[]" :key="index" class="up-swipe-action-item__right__button"
					:ref="`up-swipe-action-item__right__button-${index}`" :style="[{
						alignItems: item.style != null && item.style.borderRadius != null ? 'center' : 'stretch'
					}]" @tap="buttonClickHandler(item, index)">
					<view class="up-swipe-action-item__right__button__wrapper" :style="[{
							backgroundColor: item.style != null && item.style.backgroundColor != null ? item.style.backgroundColor : '#C7C6CD',
							borderRadius: item.style != null && item.style.borderRadius != null ? item.style.borderRadius : '0',
							padding: item.style != null && item.style.borderRadius != null ? '0' : '0 15px',
						}, item.style]">
						<up-icon v-if="item.icon" :name="item.icon"
							:color="item.style != null && item.style.color != null ? item.style.color : '#ffffff'"
							:size="item.iconSize != null ? addUnit(item.iconSize.toString()) : item.style != null && item.style.fontSize != null ? parseFloat(getPx(item.style.fontSize.toString())) * 1.2 : 17"
							:customStyle="{
								marginRight: item.text != null ? '2px' : 0
							}"></up-icon>
						<text v-if="item.text" class="up-swipe-action-item__right__button__wrapper__text up-line-1"
							:style="[{
								color: item.style != null && item.style.color != null ? item.style.color : '#ffffff',
								fontSize: item.style != null && item.style.fontSize != null ? item.style.fontSize : '16px',
								lineHeight: item.style != null && item.style.fontSize != null ? item.style.fontSize : '16px',
							}]">{{ item.text }}</text>
					</view>
				</view>
			</slot>
		</view>
		<view class="up-swipe-action-item__content" @click="clickHandler" @touchstart="touchstart" @touchmove="touchmove"
			@touchend="touchend" :style="sliderStyle">
			<slot></slot>
		</view>
	</view>
</template>
<script setup lang="uts">
	import { getCurrentInstance, onBeforeUnmount, onMounted, ref, watch } from 'vue'
	import { UPSwipeActionItemOption } from './types'
	import defProps from './swipeActionItem.uts'
	import { addUnit as addUnitFn, getPx as getPxFn, sleep } from '../../libs/function/index.uts';
	import { useUltraUI } from '../../libs/composable/useUltraUI.uts';
	// import other from './other';

	/**
	 * SwipeActionItem 滑动单元格子组件
	 * @description 该组件一般用于左滑唤出操作菜单的场景，用的最多的是左滑删除操作
	 * @tutorial https://uview-plus.jiangruyi.com/components/swipeAction.html
	 * @property {Boolean}			show			控制打开或者关闭（默认 false ）
	 * @property {String | Number}	index			标识符，如果是v-for，可用index索引
	 * @property {Boolean}			disabled		是否禁用（默认 false ）
	 * @property {Boolean}			autoClose		是否自动关闭其他swipe按钮组（默认 true ）
	 * @property {Number}			threshold		滑动距离阈值，只有大于此值，才被认为是要打开菜单（默认 30 ）
	 * @property {Array}			options			右侧按钮内容
	 * @property {String | Number}	duration		动画过渡时间，单位ms（默认 350 ）
	 * @event {Function(index)}	open	组件打开时触发
	 * @event {Function(index)}	close	组件关闭时触发
	 * @example	<up-swipe-action><up-swipe-action-item :options="options1" ></up-swipe-action-item></up-swipe-action>
	 */
	const { parent, parentData, getParentData } = useUltraUI({
		autoClose: true
	} as UTSJSONObject)
	const instance = getCurrentInstance()!.proxy!

	defineOptions({
		name: 'up-swipe-action-item'
	})

	const props = defineProps({
		// 控制打开或者关闭
		show: {
			type: Boolean,
			default: (defProps['swipeActionItem'] as UTSJSONObject)['show']
		},
		closeOnClick: {
			type: Boolean,
			default: (defProps['swipeActionItem'] as UTSJSONObject)['closeOnClick']
		},
		// 标识符，如果是v-for，可用index索引值
		name: {
			type: [String, Number],
			default: (defProps['swipeActionItem'] as UTSJSONObject)['name']
		},
		// 是否禁用
		disabled: {
			type: Boolean,
			default: (defProps['swipeActionItem'] as UTSJSONObject)['disabled']
		},
		// 是否自动关闭其他swipe按钮组
		autoClose: {
			type: Boolean,
			default: (defProps['swipeActionItem'] as UTSJSONObject)['autoClose']
		},
		// 滑动距离阈值，只有大于此值，才被认为是要打开菜单
		threshold: {
			type: Number,
			default: (defProps['swipeActionItem'] as UTSJSONObject)['threshold']
		},
		// 右侧按钮内容
		options: {
			type: Array<UPSwipeActionItemOption>,
			default: (defProps['swipeActionItem'] as UTSJSONObject)['options']
		},
		// 动画过渡时间，单位ms
		duration: {
			type: [String, Number],
			default: (defProps['swipeActionItem'] as UTSJSONObject)['duration']
		}
	})

	const emit = defineEmits(['click', 'update:show'])
	// 按钮的尺寸信息
	const size = ref<UTSJSONObject>({} as UTSJSONObject)
	// 当前状态，open-打开，close-关闭
	const status = ref('')
	const sliderStyle = ref<UTSJSONObject>({} as UTSJSONObject)
	const state = ref<UTSJSONObject>({
		moving: false,
		startX: 0,
		startY: 0,
		buttonsWidth: 0
	} as UTSJSONObject)

	const addUnit = (e: any): string => {
		return addUnitFn(e)
	}

	function getPx(e: any, s: boolean = false): string {
		return getPxFn(e, s)
	}

	const updateParentData = (): void => {
		getParentData('up-swipe-action', instance, false)
	}

	const queryRect = (): void => {
		// Reserved for nvue compatibility with the original component.
	}

	const init = (): void => {
		// 初始化父组件数据
		updateParentData()
		// #ifndef APP-NVUE
		sleep().then(() => {
			queryRect()
		})
		// #endif
	}

	const clickHandler = (): void => {}

	const setStatus = (statusValue: string): void => {
		status.value = statusValue
	}

	// 获取过渡时间
	const getDuration = (value: any): string => {
		if (value.toString().indexOf('s') >= 0) return value as string
		return parseInt(value.toString()) > 30 ? value.toString() + 'ms' : value.toString() + 's'
	}

	// 一次性展开滑动菜单
	const openSwipeAction = (): void => {
		// 处理duration单位问题
		var duration = getDuration(props.duration)
		// 展开过程中，是向左移动，所以X的偏移应该为负值
		var buttonsWidth = 0 - (state.value['buttonsWidth'] as number)
		sliderStyle.value = {
			'transition': 'transform ' + duration,
			'transform': 'translateX(' + buttonsWidth + 'px)',
			'-webkit-transform': 'translateX(' + buttonsWidth + 'px)',
		} as UTSJSONObject
		setStatus('open')
	}

	// 一次性收起滑动菜单
	const closeSwipeAction = (): void => {
		// 处理duration单位问题
		var duration = getDuration(props.duration)
		sliderStyle.value = {
			'transition': 'transform ' + duration,
			'transform': 'translateX(0px)'
		} as UTSJSONObject
		setStatus('close')
	}

	const closeHandler = (): void => {
		closeSwipeAction()
	}

	// 按钮被点击
	const buttonClickHandler = (_item: UPSwipeActionItemOption, index: number): void => {
		emit('click', {
			index,
			name: props.name
		}, () => {})
		if (props.closeOnClick) {
			closeHandler()
		}
	}

	const getBtnWidth = (): void => {
		let view = uni.createSelectorQuery().in(instance).select(".up-swipe-action-item__right")
		let fields = {
			size: true,
			scrollOffset: true
		} as NodeField
		view.fields(fields, (data: any) => {
			state.value['buttonsWidth'] = (data as NodeInfo).width
		}).exec()
	}

	// 开始触摸
	const touchstart = (event: UniTouchEvent): void => {
		// 标识当前为滑动中状态
		state.value['moving'] = true
		// 记录触摸开始点的坐标值
		var touches = event.touches
		state.value['startX'] = touches[0].pageX
		state.value['startY'] = touches[0].pageY

		// 关闭其它
		if (parent.value != null) {
			parent.value.$callMethod('closeOther', instance)
		}
	}

	const moveSwipeAction = (moveX: number): void => {
		// 设置菜单内容部分的偏移
		sliderStyle.value = {
			'transition': 'none',
			transform: 'translateX(' + moveX + 'px)',
			'-webkit-transform': 'translateX(' + moveX + 'px)'
		} as UTSJSONObject
	}

	const touchmove = (event: UniTouchEvent): void => {
		if (props.disabled || state.value['moving'] == null) return
		var touches = event.touches
		var pageX = touches[0].pageX
		var pageY = touches[0].pageY
		var startX = state.value['startX'] as number
		var startY = state.value['startY'] as number
		var buttonsWidth = state.value['buttonsWidth'] as number
		var moveX = pageX - startX
		var moveY = pageY - startY

		// 移动的X轴距离大于Y轴距离，也即终点与起点位置连线，与X轴夹角小于45度时，禁止页面滚动
		if (Math.abs(moveX) > Math.abs(moveY) || Math.abs(moveX) > props.threshold) {
			event.preventDefault()
			event.stopPropagation()
		}
		// 如果移动的X轴距离小于Y轴距离，也即终点位置与起点位置连线，与Y轴夹角小于45度时，认为是页面上下滑动，而不是左右滑动单元格
		if (Math.abs(moveX) < Math.abs(moveY)) return

		if (status.value === 'open') {
			// 在开启状态下，向左滑动，需忽略
			if (moveX < 0) moveX = 0
			// 想要收起菜单，最大能移动的距离为按钮的总宽度
			if (moveX > buttonsWidth) moveX = buttonsWidth
			// 如果是已经打开了的状态，向左滑动时，移动收起菜单
			moveSwipeAction(0 - buttonsWidth + moveX)
		} else {
			// 关闭状态下，右滑动需忽略
			if (moveX > 0) moveX = 0
			// 滑动的距离不允许超过所有按钮的总宽度，此时只能是左滑，最终设置按钮的总宽度，同时为负数
			if (Math.abs(moveX) > buttonsWidth) moveX = 0 - buttonsWidth
			// 只要是在滑过程中，就不断移动单元格内容部分，从而使隐藏的菜单显示出来
			moveSwipeAction(moveX)
		}
	}

	const touchend = (event: UniTouchEvent): void => {
		if (state.value['moving'] == false || props.disabled) return
		state.value['moving'] = false
		var touches: UniTouch = event.changedTouches[0] as UniTouch
		var pageX = touches.pageX
		var startX = state.value['startX'] as number
		var moveX = pageX - startX
		if (status.value === 'open') {
			// 在展开的状态下，继续左滑，无需操作
			if (moveX < 0) return
			// 在开启状态下，点击一下内容区域，moveX为0，也即没有进行移动，这时执行收起菜单逻辑
			if (moveX == 0) {
				closeSwipeAction()
				return
			}
			// 在开启状态下，滑动距离小于阈值，则默认为不关闭，同时恢复原来的打开状态
			if (Math.abs(moveX) < props.threshold) {
				openSwipeAction()
			} else {
				// 如果滑动距离大于阈值，则执行收起逻辑
				closeSwipeAction()
			}
		} else {
			// 在关闭的状态下，右滑，无需操作
			if (moveX > 0) return
			if (Math.abs(moveX) < props.threshold) {
				closeSwipeAction()
			} else {
				openSwipeAction()
			}
		}
	}

	watch((): boolean => props.show, (newValue: boolean) => {
		if (newValue) {
			status.value = 'open'
		} else {
			status.value = 'close'
		}
	})

	watch(status, (newValue: string) => {
		if (newValue === 'open') {
			emit('update:show', true)
			if (parent.value != null) {
				parent.value.$callMethod('setOpendItem', 1)
			}
		} else {
			emit('update:show', false)
		}
		if (props.disabled) return
		// 打开或关闭单元格。保留原 Options API 中基于当前 status 二次判断的行为。
		if (newValue === 'close' && status.value === 'open') {
			closeSwipeAction()
		} else if (newValue === 'open' && status.value === 'close') {
			openSwipeAction()
		}
	})

	watch((): UPSwipeActionItemOption[] => props.options as UPSwipeActionItemOption[], () => {
		getBtnWidth()
	})

	onMounted(() => {
		init()
		getBtnWidth()
	})

	onBeforeUnmount(() => {
		closeHandler()
	})

	defineExpose({
		size,
		parentData,
		status,
		sliderStyle,
		state,
		addUnit,
		getPx,
		init,
		updateParentData,
		queryRect,
		buttonClickHandler,
		clickHandler,
		closeHandler,
		setStatus,
		getBtnWidth,
		touchstart,
		touchmove,
		touchend,
		openSwipeAction,
		closeSwipeAction,
		moveSwipeAction,
		getDuration
	})
</script>

<style lang="scss" scoped>

	.up-swipe-action-item {
		position: relative;
		overflow: hidden;
		/* #ifndef APP-NVUE || APP-ANDROID || APP-IOS || MP-WEIXIN */
		touch-action: pan-y;
		/* #endif */

		&__content {
            transform: translateX(0px); // 修复某些情况下默认右侧按钮是展开的问题
			background-color: #FFFFFF;
			z-index: 10;
		}

		&__right {
			position: absolute;
			top: 0;
			bottom: 0;
			right: 0;
			@include flex;

			&__button {
				@include flex;
				justify-content: center;
				overflow: hidden;
				align-items: center;

				&__wrapper {
					@include flex;
					align-items: center;
					justify-content: center;
					padding: 0 15px;

					&__text {
						@include flex;
						align-items: center;
						color: #FFFFFF;
						font-size: 15px;
						text-align: center;
						justify-content: center;
					}
				}
			}
		}
	}
</style>
