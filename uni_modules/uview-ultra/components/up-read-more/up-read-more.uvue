<template>
	<view class="up-read-more">
		<view
		    class="up-read-more__content"
		    :style="contentStyle"
		>
			<view
			    class="up-read-more__content__inner"
			    ref="up-read-more__content__inner"
			    :class="[elId]"
			>
				<slot></slot>
			</view>
		</view>
		<view
		    class="up-read-more__toggle"
		    :style="innerShadowStyle"
		    v-if="isLongContent"
		>
			<slot name="toggle">
				<view
				    class="up-read-more__toggle__text"
				    @tap="toggleReadMore"
				>
					<up-text
					    :text="status === 'close' ? closeText : openText"
					    :color="color"
					    :size="fontSize"
					    :lineHeight="fontSize"
					    margin="0 5px 0 0"
					></up-text>
					<view class="up-read-more__toggle__icon">
						<up-icon
						    :color="color"
						    :size="iconSize"
						    :name="status === 'close' ? 'arrow-down' : 'arrow-up'"
						></up-icon>
					</view>
				</view>
			</slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, getCurrentInstance, onBeforeUnmount, onMounted, ref } from 'vue'
	import defProps from './readMore'
	import { addUnit, guid, getPx, sleep, upGetRect } from '../../libs/function/index'

	function createShadowStyle(): UTSJSONObject {
		return {
			backgroundImage: 'linear-gradient(180deg, rgba(255, 255, 255, 0), #ffffff)',
			paddingTop: '100px',
			marginTop: '-100px'
		} as UTSJSONObject
	}

	/**
	 * readMore 阅读更多
	 * @description 该组件一般用于内容较长，预先收起一部分，点击展开全部内容的场景。
	 * @tutorial https://uview-plus.jiangruyi.com/components/readMore.html
	 * @property {String | Number}	showHeight	内容超出此高度才会显示展开全文按钮，单位px（默认 400 ）
	 * @property {Boolean}			toggle		展开后是否显示收起按钮（默认 false ）
	 * @property {String}			closeText	关闭时的提示文字（默认 '展开阅读全文' ）
	 * @property {String}			openText	展开时的提示文字（默认 '收起' ）
	 * @property {String}			color		提示文字的颜色（默认 '#2979ff' ）
	 * @property {String | Number}	fontSize	提示文字的大小，单位px （默认 14 ）
	 * @property {Object}			shadowStyle	显示阴影的样式
	 * @property {String}			textIndent	段落首行缩进的字符个数 （默认 '2em' ）
	 * @property {String | Number}	name		用于在 open 和 close 事件中当作回调参数返回
	 * @event {Function} open 内容被展开时触发
	 * @event {Function} close 内容被收起时触发
	 * @example <up-read-more><rich-text :nodes="content"></rich-text></up-read-more>
	 */
	defineOptions({
		name: 'up-read-more'
	})

	const props = defineProps({
		// 默认的显示占位高度
		showHeight: {
			type: [String, Number],
			default: defProps.getNumber('readMore.showHeight')
		},
		// 展开后是否显示"收起"按钮
		toggle: {
			type: Boolean,
			default: defProps.getBoolean('readMore.toggle')
		},
		// 关闭时的提示文字
		closeText: {
			type: String,
			default: defProps.getString('readMore.closeText')
		},
		// 展开时的提示文字
		openText: {
			type: String,
			default: defProps.getString('readMore.openText')
		},
		// 提示的文字颜色
		color: {
			type: String,
			default: defProps.getString('readMore.color')
		},
		// 提示文字的大小
		fontSize: {
			type: [String, Number],
			default: defProps.getNumber('readMore.fontSize')
		},
		// 是否显示阴影
		shadowStyle: {
			type: Object,
			default(): UTSJSONObject {
				return {
					backgroundImage: 'linear-gradient(180deg, rgba(255, 255, 255, 0), #ffffff)',
					paddingTop: '100px',
					marginTop: '-100px'
				} as UTSJSONObject
			}
		},
		// 段落首行缩进的字符个数
		textIndent: {
			type: String,
			default: defProps.getString('readMore.textIndent')
		},
		// open和close事件时，将此参数返回在回调参数中
		name: {
			type: [String, Number],
			default: defProps.getString('readMore.name')
		}
	})

	const emit = defineEmits(['open', 'close'])
	const instance = getCurrentInstance()!.proxy!

	const isLongContent = ref(false) // 是否需要隐藏一部分内容
	const status = ref('close') // 当前隐藏与显示的状态，close-收起状态，open-展开状态
	const elId = guid() // 生成唯一class
	const contentHeight = ref(100) // 内容高度
	const isUnmounted = ref(false)
	const maxMeasureRetries = 10

	const contentStyle = computed((): UTSJSONObject => {
		const style = {} as UTSJSONObject
		style['height'] = isLongContent.value && status.value === 'close' ? addUnit(props.showHeight) : addUnit(contentHeight.value)
		style['textIndent'] = props.textIndent
		return style
	})

	// 展开后无需阴影，收起时才需要阴影样式
	const innerShadowStyle = computed((): UTSJSONObject => {
		if (status.value === 'open') return {} as UTSJSONObject
		const shadowStyleValue = props.shadowStyle as UTSJSONObject | null
		return shadowStyleValue == null ? createShadowStyle() : shadowStyleValue
	})

	const iconSize = computed((): number => {
		return parseInt(getPx(props.fontSize)) + 2
	})

	const getContentHeight = (): Promise<NodeInfo | null> => {
		return new Promise(resolve => {
			upGetRect('.' + elId, false, instance).then((res: NodeInfo) => {
				resolve(res)
			})
		})
	}

	function measureContent(attempt: number = 0): void {
		if (isUnmounted.value) return
		sleep(150).then(() => {
			if (isUnmounted.value) return
			getContentHeight().then((size: NodeInfo | null) => {
				if (isUnmounted.value) return
				if (size == null) {
					if (attempt < maxMeasureRetries) {
						sleep(200).then(() => {
							if (!isUnmounted.value) measureContent(attempt + 1)
						})
					}
					return
				}
				contentHeight.value = size.height ?? 0
				if (contentHeight.value <= 0) {
					// 安卓上可能还未渲染完，重试
					if (attempt < maxMeasureRetries) {
						sleep(200).then(() => {
							if (!isUnmounted.value) measureContent(attempt + 1)
						})
					}
					return
				}
				// 判断高度，如果真实内容高度大于占位高度，则显示收起与展开的控制按钮
				if (contentHeight.value > parseFloat(getPx(props.showHeight))) {
					isLongContent.value = true
					status.value = 'close'
				} else {
					// https://github.com/ijry/uview-plus/issues/270
					isLongContent.value = false
					status.value = 'close'
				}
			})
		})
	}

	// 展开或者收起
	const toggleReadMore = (): void => {
		status.value = status.value === 'close' ? 'open' : 'close'
		// 如果toggle为false，隐藏"收起"部分的内容
		if (props.toggle == false) isLongContent.value = false
		// 发出打开或者收起的事件
		if (status.value == 'open') {
			emit('open', props.name)
		} else {
			emit('close', props.name)
		}
	}

	onMounted(() => {
		measureContent()
	})

	onBeforeUnmount(() => {
		isUnmounted.value = true
	})
</script>

<style lang="scss" scoped>
.up-read-more {

	&__content {
		overflow: hidden;
		color: $up-content-color;
		font-size: 15px;
		text-align: left;
	}

	&__toggle {
		@include flex;
		justify-content: center;
		position: relative;

		&__text {
			@include flex;
			align-items: center;
			justify-content: center;
			margin-top: 5px;
		}
	}
}
</style>
