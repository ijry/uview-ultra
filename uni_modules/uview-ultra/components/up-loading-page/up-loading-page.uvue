<template>
    <up-transition
        :show="loading"
        :custom-style="transitionStyle"
    >
        <view class="up-loading-page">
            <view class="up-loading-page__warpper">
                <view class="up-loading-page__warpper__loading-icon">
                    <image
                        v-if="image"
                        :src="image"
                        class="up-loading-page__warpper__loading-icon__img"
                        mode="widthFit"
						:style="imageStyle"
                    ></image>
                    <up-loading-icon
                        v-else
                        :mode="loadingMode"
                        :size="iconSizeValue"
                        :color="loadingColor"
                    ></up-loading-icon>
                </view>
                <slot>
                    <text
                        class="up-loading-page__warpper__text"
                        :style="textStyle"
                        >{{ loadingText }}</text
                    >
                </slot>
            </view>
        </view>
    </up-transition>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import defProps from './loadingPage'
import { addStyle, addUnit } from '../../libs/function/index'
/**
 * loadingPage 加载动画
 * @author jry ijry@qq.com
 * @description 警此组件为一个小动画，目前用在uView的loadmore加载更多和switch开关等组件的正在加载状态场景。
 * @tutorial https://ijry.github.io/uview-plus/components/loading.html
 * @property {String | Number}	loadingText		提示内容  (默认 '正在加载' )
 * @property {String}			image			文字上方用于替换loading动画的图片
 * @property {String}			loadingMode		加载动画的模式，circle-圆形，spinner-花朵形，semicircle-半圆形 （默认 'circle' ）
 * @property {Boolean}			loading			是否加载中 （默认 false ）
 * @property {String}			bgColor			背景色 （默认 '#ffffff' ）
 * @property {String}			color			文字颜色 （默认 '#C8C8C8' ）
 * @property {String | Number}	fontSize		文字大小 （默认 19 ）
 * @property {String | Number}	iconSize		图标大小 （默认 28 ）
 * @property {String}			loadingColor	加载中图标的颜色，只能rgb或者十六进制颜色值 （默认 '#C8C8C8' ）
 * @property {Number}			zIndex	        z-index层级 （默认10 ）
 * @property {Object}			customStyle		自定义样式
 * @example <up-loading mode="circle"></up-loading>
 */
defineOptions({
    styleIsolation: 'app-and-page',
    name: 'up-loading-page'
})

const props = defineProps({
    // 提示内容
    loadingText: {
        type: [String, Number],
        default: defProps.getString('loadingPage.loadingText')
    },
    // 文字上方用于替换loading动画的图片
    image: {
        type: String,
        default: defProps.getString('loadingPage.image')
    },
    // 加载动画的模式，circle-圆形，spinner-花朵形，semicircle-半圆形
    loadingMode: {
        type: String,
        default: defProps.getString('loadingPage.loadingMode')
    },
    // 是否加载中
    loading: {
        type: Boolean,
        default: defProps.getBoolean('loadingPage.loading')
    },
    // 背景色
    bgColor: {
        type: String,
        default: defProps.getString('loadingPage.bgColor')
    },
    // 文字颜色
    color: {
        type: String,
        default: defProps.getString('loadingPage.color')
    },
    // 文字大小
    fontSize: {
        type: [String, Number],
        default: defProps.getNumber('loadingPage.fontSize')
    },
    // 图标大小
    iconSize: {
        type: [String, Number],
        default: defProps.getNumber('loadingPage.iconSize')
    },
    // 加载中图标的颜色，只能rgb或者十六进制颜色值
    loadingColor: {
        type: String,
        default: defProps.getString('loadingPage.loadingColor')
    },
    // 层级
    zIndex: {
        type: Number,
        default: defProps.getNumber('loadingPage.zIndex')
    },
    customStyle: {
        type: [Object, String],
        default: () => ({})
    }
})

const customStyleParse = computed((): UTSJSONObject => {
    return addStyle(props.customStyle) as UTSJSONObject
})

const transitionStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject
    style['position'] = 'fixed'
    style['top'] = 0
    style['left'] = 0
    style['right'] = 0
    style['bottom'] = 0
    style['backgroundColor'] = props.bgColor
    style['display'] = 'flex'
    style['zIndex'] = props.zIndex
    const custom = customStyleParse.value
    const keys = UTSJSONObject.keys(custom)
    for (let i = 0; i < keys.length; i++) {
        const key = keys[i]
        style[key] = custom[key]
    }
    return style
})

const iconSizeValue = computed((): string => {
    return addUnit(props.iconSize)
})

const imageStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject
    style['width'] = iconSizeValue.value
    style['height'] = iconSizeValue.value
    return style
})

const textStyle = computed((): UTSJSONObject => {
    const style = {} as UTSJSONObject
    style['fontSize'] = addUnit(props.fontSize)
    style['color'] = props.color
    return style
})
</script>

<style lang="scss" scoped>
@import "../../libs/css/components.scss";

$text-color: rgb(200, 200, 200) !default;
$text-size: 19px !default;
$up-loading-icon-margin-bottom: 10px !default;

.up-loading-page {
    @include flex(column);
    flex: 1;
    align-items: center;
    justify-content: center;

    &__warpper {
        margin-top: -150px;
        justify-content: center;
        align-items: center;
        // color: $text-color;
        // font-size: $text-size;
        @include flex(column);

        &__loading-icon {
            margin-bottom: $up-loading-icon-margin-bottom;

            &__img {
                width: 40px;
                height: 40px;
            }
        }

        &__text {
            font-size: $text-size;
            color: $text-color;
        }
    }
}
</style>
