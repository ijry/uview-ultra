<template>
	<view class="up-navbar-mini" :class="[customClass]">
		<view class="up-navbar-mini__inner" :class="[fixed ? 'up-navbar-mini--fixed' : '']">
			<up-status-bar
				v-if="safeAreaInsetTop"
			></up-status-bar>
			<view
				class="up-navbar-mini__content"
				:style="contentStyle"
			>
				<view
					class="up-navbar-mini__content__left"
					hover-class="up-navbar-mini__content__left--hover"
					hover-start-time="150"
					@tap="leftClick"
				>
					<slot name="left">
						<up-icon
							:name="leftIcon"
							:size="iconSize"
							:color="iconColor"
						></up-icon>
					</slot>
				</view>
				<view style="padding: 10px 10px;">
					<up-line direction="col" color="#fff" length="16px"></up-line>
				</view>
                <view
					class="up-navbar-mini__content__center" @tap="homeClick">
                    <slot name="center">
                        <up-icon name="home" :size="iconSize" :color="iconColor"></up-icon>
                    </slot>
                </view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import defProps from './navbarMini'
	import { addUnit } from '../../libs/function/index'
	/**
	 * NavbarMini 迷你导航栏
	 * @description 此组件一般用于在全屏页面中，典型的如微信小程序左上角。
	 * @tutorial https://uview-plus.jiangruyi.com/components/navbar-mini.html
	 * @property {Boolean}			safeAreaInsetTop	是否开启顶部安全区适配  （默认 true ）
	 * @property {Boolean}			placeholder			固定在顶部时，是否生成一个等高元素，以防止塌陷 （默认 false ）
	 * @property {Boolean}			fixed				导航栏是否固定在顶部 （默认 false ）
	 * @property {String}			leftIcon			左边返回图标的名称，只能为uView自带的图标 （默认 'arrow-left' ）
	 * @property {String}			title				导航栏标题，如设置为空字符，将会隐藏标题占位区域
	 * @property {String}			bgColor				导航栏背景设置 （默认 '#ffffff' ）
	 * @property {String | Number}	height				导航栏高度(不包括状态栏高度在内，内部自动加上)（默认 '44px' ）
	 * @property {String | Number}	iconSize			左侧返回图标的大小（默认 20px ）
	 * @property {String | Number}	leftIconColor		左侧返回图标的颜色（默认 #303133 ）
	 * @property {Boolean}	        autoBack			点击左侧区域(返回图标)，是否自动返回上一页（默认 false ）
	 * @property {Object | String}	titleStyle			标题的样式，对象或字符串
	 * @event {Function} leftClick		点击左侧区域
	 * @event {Function} rightClick		点击右侧区域
	 * @example <up-navbar-mini @click-left="onClickBack"></up-navbar-mini>
	 */
	defineOptions({
		styleIsolation: 'app-and-page',
		name: 'up-navbar-mini'
	})

	const props = defineProps({
		// 是否开启顶部安全区适配
		safeAreaInsetTop: {
			type: Boolean,
			default: defProps.getBoolean('navbarMini.safeAreaInsetTop')
		},
		// 是否固定在顶部
		fixed: {
			type: Boolean,
			default: defProps.getBoolean('navbarMini.fixed')
		},
		// 左边的图标
		leftIcon: {
			type: String,
			default: defProps.getString('navbarMini.leftIcon')
		},
		// 背景颜色
		bgColor: {
			type: String,
			default: defProps.getString('navbarMini.bgColor')
		},
		// 导航栏高度
		height: {
			type: [String, Number],
			default: defProps.getString('navbarMini.height')
		},
		// 图标的大小
		iconSize: {
			type: [String, Number],
			default: defProps.getString('navbarMini.iconSize')
		},
		// 图标的颜色
		iconColor: {
			type: String,
			default: defProps.getString('navbarMini.iconColor')
		},
		// 点击左侧区域(返回图标)，是否自动返回上一页
		autoBack: {
			type: Boolean,
			default: defProps.getBoolean('navbarMini.autoBack')
		},
		// 首页路径
		homeUrl: {
			type: String,
			default: defProps.getString('navbarMini.homeUrl')
		},
		customClass: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits(['leftClick', 'homeClick'])

	const contentStyle = computed((): UTSJSONObject => {
		return {
			height: addUnit(props.height),
			backgroundColor: props.bgColor
		} as UTSJSONObject
	})

	// 点击左侧区域
	const leftClick = (): void => {
		// 如果配置了autoBack，自动返回上一页
		emit('leftClick')
		if (props.autoBack) {
			uni.navigateBack()
		}
	}

	const homeClick = (): void => {
		if (props.homeUrl != '') {
			uni.reLaunch({ url: props.homeUrl })
		}
	}
</script>

<style lang="scss" scoped>
	@import "../../libs/css/components.scss";

	.up-navbar-mini {

        &__inner {
            width: 180rpx;
            overflow: hidden;
        }

		&--fixed {
			position: fixed;
			left: 20px;
			right: 0;
			top: 10px;
			z-index: 11;
		}

		&__content {
			@include flex(row);
            padding: 0 15px;
			border-radius: 20px;
			align-items: center;
			height: 36px;
			background-color: #9acafc;
			position: relative;
			justify-content: space-between;

			&__left {
				@include flex(row);
				align-items: center;
			}

			&__left {
				&--hover {
					opacity: 0.7;
				}
			}
		}
	}
</style>
