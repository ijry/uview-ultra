		display: flex;
		flex-direction: column;
	}

	.up-cropper__panel {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 999;
		background-color: #000000;
	}

	.up-cropper__canvas {
		display: flex;
	}

	.up-cropper__export {
		position: fixed;
		left: -9999px;
		top: -9999px;
	}

	.up-cropper__toolbar {
		height: 70px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-around;
		background-color: #111111;
	}

	.up-cropper__button {
		color: #ffffff;
		font-size: 15px;
		padding: 10px;
	}
</style>
