<template>
  <view class="up-virtual-list" :style="rootStyle" ref="container">
    <scroll-view
      class="virtual-scroll-container"
      :scroll-y="true"
      :scroll-top="scrollTop"
      :style="{ height: '100%' }"
      @scroll="handleScroll"
    >
      <view class="scroll-content">
        <view :style="{ height: topPlaceholderHeight + 'px' }"></view>
        
        <view 
          v-for="item in visibleItems" 
          :key="getItemKey(item)"
          class="list-item"
          :style="{ height: itemHeight + 'px' }"
        >
          <slot :item="item" :index="getItemVirtualIndex(item)"></slot>
        </view>
        
        <view :style="{ height: bottomPlaceholderHeight + 'px' }"></view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import type { PropType } from 'vue'
import { computed, getCurrentInstance, nextTick, onMounted, ref, watch } from 'vue'
import { addUnit, deepMerge, upGetRect } from '../../libs/function/index.uts'

function createListData(): Array<UTSJSONObject> {
  return [] as Array<UTSJSONObject>
}

function createItem(item: UTSJSONObject, virtualIndex: number): UTSJSONObject {
  return deepMerge(item, {
    _virtualIndex: virtualIndex
  } as UTSJSONObject)
}

function valueToString(value: any | null): string {
  return value == null ? '' : value.toString()
}

defineOptions({
  styleIsolation: 'app-and-page',
  name: 'up-virtual-list'
})

const props = defineProps({
  listData: {
    type: Array as PropType<Array<UTSJSONObject>>,
    default(): Array<UTSJSONObject> {
      return [] as Array<UTSJSONObject>
    }
  },
  itemHeight: {
    type: Number,
    default: 50
  },
  height: {
    type: [String, Number],
    default: '100%'
  },
  buffer: {
    type: Number,
    default: 4
  },
  keyField: {
    type: String,
    default: 'id'
  },
  scrollTop: {
    type: Number,
    default: 0
  }
})

const emit = defineEmits(['update:scrollTop', 'scroll'])
const instance = getCurrentInstance()!.proxy!

const startIndex = ref(0)
const containerHeight = ref(0)

const getViewportHeight = (): number => {
  // #ifdef H5
  return window.innerHeight
  // #endif

  // #ifndef H5
  try {
    const res = uni.getSystemInfoSync()
    return res.windowHeight
  } catch (e) {
    return 600
  }
  // #endif
}

const calculateDefaultHeight = (): number => {
  const height = props.height
  if (typeof height === 'number') {
    return height
  }

  if (typeof height === 'string') {
    if (height.indexOf('px') >= 0) {
      const parsed = parseInt(height)
      return isNaN(parsed) ? 500 : parsed
    }
    if (height.indexOf('vh') >= 0) {
      const vh = parseInt(height)
      return isNaN(vh) ? 500 : (vh / 100) * getViewportHeight()
    }
    if (height.indexOf('%') >= 0) {
      return 500
    }
    const num = parseInt(height)
    return isNaN(num) ? 500 : num
  }

  return 500
}

const getListData = (): Array<UTSJSONObject> => {
  return props.listData as Array<UTSJSONObject>
}

const remain = computed((): number => {
  if (containerHeight.value <= 0) {
    const defaultRemain = Math.ceil(500 / props.itemHeight)
    return defaultRemain > 0 ? defaultRemain : 10
  }
  const calculated = Math.ceil(containerHeight.value / props.itemHeight)
  return Math.max(1, calculated)
})

const visibleCount = computed((): number => {
  return remain.value + props.buffer
})

const rootStyle = computed((): UTSJSONObject => {
  const style = {} as UTSJSONObject
  style['height'] = addUnit(props.height)
  return style
})

const visibleItems = computed((): Array<UTSJSONObject> => {
  const list = getListData()
  const start = Math.max(0, startIndex.value - Math.floor(props.buffer / 2))
  const end = Math.min(list.length, start + visibleCount.value)
  const items = [] as Array<UTSJSONObject>
  for (let i = start; i < end; i++) {
    const item = list[i] as UTSJSONObject
    items.push(createItem(item, i))
  }
  return items
})

const topPlaceholderHeight = computed((): number => {
  const start = Math.max(0, startIndex.value - Math.floor(props.buffer / 2))
  return start * props.itemHeight
})

const bottomPlaceholderHeight = computed((): number => {
  const list = getListData()
  const start = Math.max(0, startIndex.value - Math.floor(props.buffer / 2))
  const end = Math.min(list.length, start + visibleCount.value)
  return (list.length - end) * props.itemHeight
})

const measureContainerHeight = (): void => {
  nextTick(() => {
    upGetRect('.up-virtual-list', false, instance).then((rect: NodeInfo) => {
      if (rect.height != null) {
        containerHeight.value = rect.height as number
      } else {
        containerHeight.value = calculateDefaultHeight()
      }
    })
  })
}

const getItemVirtualIndex = (item: UTSJSONObject): number => {
  const index = item['_virtualIndex']
  if (index == null) {
    return 0
  }
  if (typeof index === 'number') {
    return index
  }
  const parsed = parseInt(index.toString())
  return isNaN(parsed) ? 0 : parsed
}

const getItemKey = (item: UTSJSONObject): string => {
  const itemKey = item[props.keyField]
  if (itemKey != null && valueToString(itemKey) != '') {
    return valueToString(itemKey)
  }
  return getItemVirtualIndex(item).toString()
}

const updateVisibleItems = (): void => {
  const index = Math.floor(props.scrollTop / props.itemHeight)
  startIndex.value = Math.max(0, index)
}

const handleScroll = (e: UniScrollEvent): void => {
  const scrollTop = e.detail.scrollTop
  emit('update:scrollTop', scrollTop)
  emit('scroll', scrollTop)
}

const handleTouchMove = (e: UniEvent): void => {
  e.stopPropagation()
}

const getVisibleRange = (): UTSJSONObject => {
  const list = getListData()
  const start = Math.max(0, startIndex.value - Math.floor(props.buffer / 2))
  const end = Math.min(list.length, start + visibleCount.value)
  return {
    start: start,
    end: end
  } as UTSJSONObject
}

watch((): Array<UTSJSONObject> => props.listData as Array<UTSJSONObject>, () => {
  updateVisibleItems()
}, { immediate: true })

watch((): number => props.scrollTop, () => {
  updateVisibleItems()
})

onMounted(() => {
  measureContainerHeight()
})

defineExpose({
  getVisibleRange,
  handleTouchMove
})
</script>

<style scoped lang="scss">
.up-virtual-list {
  position: relative;
  overflow: hidden;
}

.virtual-scroll-container {
  height: 100%;
}

.scroll-content {
  position: relative;
}

.list-item {
}
</style>
