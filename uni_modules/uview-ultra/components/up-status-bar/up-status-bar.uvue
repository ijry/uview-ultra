<template>
	<view
	    :style="[style]"
	    class="up-status-bar"
	>
		<slot />
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import defProps from './statusBar.uts'
	import { addUnit, addStyle, deepMerge } from '../../libs/function/index'
	/**
	 * StatbusBar 状态栏占位
	 * @author jry ijry@qq.com
	 * @description 本组件主要用于状态填充，比如在自定导航栏的时候，它会自动适配一个恰当的状态栏高度。
	 * @tutorial https://uview-plus.jiangruyi.com/components/statusBar.html
	 * @property {String}			bgColor			背景色 (默认 'transparent' )
	 * @property {String | Object}	customStyle		自定义样式 
	 * @example <up-status-bar></up-status-bar>
	 */
	defineOptions({
		name: 'up-status-bar'
	})

	const props = defineProps({
		bgColor: {
			type: String,
			default: defProps.getString('statusBar.bgColor')
		},
		customStyle: {
			type: [Object, String],
			default: () => ({})
		}
	})

	const style = computed((): UTSJSONObject => {
		const style = {} as UTSJSONObject
		// 状态栏高度，由于某些安卓和微信开发工具无法识别css的顶部状态栏变量，所以使用js获取的方式
		style['height'] = addUnit(uni.getSystemInfoSync().statusBarHeight, 'px')
		style['backgroundColor'] = props.bgColor
		return deepMerge(style, addStyle(props.customStyle))
	})
</script>

<style lang="scss" scoped>
	.up-status-bar {
		width: 100%;
	}
</style>
