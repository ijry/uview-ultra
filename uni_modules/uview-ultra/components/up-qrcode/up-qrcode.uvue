<template>
    <view class="up-qrcode" :style="rootStyle" @longpress="longpress" @click="preview">
        <view v-if="error.length > 0" class="up-qrcode__error" :style="matrixStyle">
            <text class="up-qrcode__error-text">{{ error }}</text>
        </view>
        <view v-else class="up-qrcode__matrix" :style="matrixStyle">
            <canvas
                class="up-qrcode__canvas"
                :id="canvasId"
                :canvas-id="canvasId"
                :style="canvasStyle"
            ></canvas>
            <image
                v-if="icon.length > 0"
                class="up-qrcode__icon"
                :src="icon"
                mode="aspectFill"
                :style="iconStyle"
            ></image>
            <view v-if="showLoading && loading" class="up-qrcode__loading">
                <up-loading-icon vertical :text="loadingText" textSize="14px"></up-loading-icon>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import { computed, getCurrentInstance, nextTick, onMounted, ref, watch } from 'vue'
import { createQrCells, getQrRenderCountWithQuietZone } from './qrcode.uts'

function makeId(prefix: string): string {
    return prefix + Date.now().toString()
}

function isEmpty(value: any | null): boolean {
    if (value == null) {
        return true
    }
    const text = value.toString()
    return text.length == 0 || text == 'undefined' || text == 'null' || text == '{}' || text == '[]'
}

function getPixelRatio(): number {
    const info = uni.getSystemInfoSync()
    if (info.pixelRatio > 0) {
        return info.pixelRatio
    }
    return 1
}

defineOptions({
    styleIsolation: 'app-and-page',
    name: 'up-qrcode'
})

const props = defineProps({
        cid: {
            type: String,
            default(): string {
                return 'up-qrcode-' + Date.now().toString()
            }
        },
        size: {
            type: Number,
            default: 200
        },
        unit: {
            type: String,
            default: 'px'
        },
        show: {
            type: Boolean,
            default: true
        },
        val: {
            type: String,
            default: ''
        },
        background: {
            type: String,
            default: '#ffffff'
        },
        foreground: {
            type: String,
            default: '#000000'
        },
        pdground: {
            type: String,
            default: '#000000'
        },
        icon: {
            type: String,
            default: ''
        },
        iconSize: {
            type: Number,
            default: 40
        },
        lv: {
            type: Number,
            default: 3
        },
        quietZone: {
            type: Number,
            default: 0
        },
        onval: {
            type: Boolean,
            default: true
        },
        loadMake: {
            type: Boolean,
            default: true
        },
        usingComponents: {
            type: Boolean,
            default: true
        },
        showLoading: {
            type: Boolean,
            default: true
        },
        loadingText: {
            type: String,
            default: '生成中'
        },
        allowPreview: {
            type: Boolean,
            default: false
        },
        useRootHeightAndWidth: {
            type: Boolean,
            default: false
        }
})

const emit = defineEmits(['result', 'longpressCallback', 'preview', 'error'])
const instance = getCurrentInstance()!.proxy!
const rootId = makeId('rootId-')
const cells = ref<Array<UTSJSONObject>>([] as Array<UTSJSONObject>)
const loading = ref(false)
const result = ref('')
const error = ref('')
const canvasId = makeId('up-qrcode-canvas-')
const canvasContext = ref<CanvasContext | null>(null)
const ctx = ref<CanvasRenderingContext2D | null>(null)

const sizeLocal = computed((): number => {
    return props.size
})

const rootStyle = computed((): UTSJSONObject => {
    return {
        width: props.useRootHeightAndWidth ? '100%' : sizeLocal.value.toString() + props.unit,
        height: props.useRootHeightAndWidth ? '100%' : sizeLocal.value.toString() + props.unit
    } as UTSJSONObject
})

const matrixStyle = computed((): UTSJSONObject => {
    return {
        width: sizeLocal.value.toString() + props.unit,
        height: sizeLocal.value.toString() + props.unit,
        backgroundColor: props.background
    } as UTSJSONObject
})

const iconStyle = computed((): UTSJSONObject => {
    const size = props.iconSize.toString() + props.unit
    return {
        width: size,
        height: size,
        left: ((sizeLocal.value - props.iconSize) / 2).toString() + props.unit,
        top: ((sizeLocal.value - props.iconSize) / 2).toString() + props.unit
    } as UTSJSONObject
})

const cellSize = computed((): number => {
    return sizeLocal.value / getQrRenderCountWithQuietZone(props.val, props.lv, props.quietZone)
})

const canvasStyle = computed((): UTSJSONObject => {
    return {
        width: sizeLocal.value.toString() + props.unit,
        height: sizeLocal.value.toString() + props.unit
    } as UTSJSONObject
})

const emitTempFileSuccess = (options: UTSJSONObject, path: string): void => {
    const success = options['success']
    if (success != null) {
        ;(success as (res: UTSJSONObject) => void)({
            tempFilePath: path
        } as UTSJSONObject)
    }
    const complete = options['complete']
    if (complete != null) {
        ;(complete as (res: UTSJSONObject) => void)({
            tempFilePath: path
        } as UTSJSONObject)
    }
}

const emitTempFileFail = (options: UTSJSONObject, message: string): void => {
    const payload = {
        errMsg: message
    } as UTSJSONObject
    const fail = options['fail']
    if (fail != null) {
        ;(fail as (error: UTSJSONObject) => void)(payload)
    }
    const complete = options['complete']
    if (complete != null) {
        ;(complete as (error: UTSJSONObject) => void)(payload)
    }
}

const initCanvas = (): Promise<void> => {
    return new Promise((resolve, reject) => {
        if (canvasContext.value != null && ctx.value != null) {
            resolve()
            return
        }
        uni.createCanvasContextAsync({
            id: canvasId.toString() as string.IDString,
            component: instance,
            success: (context: CanvasContext) => {
                canvasContext.value = context
                const context2d = context.getContext('2d')
                if (context2d == null) {
                    reject(new Error('Canvas context is not ready'))
                    return
                }
                const canvas = context2d.canvas
                const pixelRatio = getPixelRatio()
                canvas.width = sizeLocal.value * pixelRatio
                canvas.height = sizeLocal.value * pixelRatio
                context2d.scale(pixelRatio, pixelRatio)
                ctx.value = context2d
                resolve()
            },
            fail: (err: UniError) => {
                reject(err)
            }
        })
    })
}

const drawQrToCanvas = (): void => {
    const context = ctx.value
    if (context == null) {
        return
    }
    const drawSize = sizeLocal.value
    context.clearRect(0, 0, drawSize, drawSize)
    context.fillStyle = props.background
    context.fillRect(0, 0, drawSize, drawSize)
    const count = getQrRenderCountWithQuietZone(props.val, props.lv, props.quietZone)
    for (let i = 0; i < cells.value.length; i++) {
        const cell = cells.value[i]
        if (!cell.getBoolean('dark', false)) {
            continue
        }
        const color = cell.getString('color', props.foreground)
        const row = Math.floor(i / count)
        const col = i % count
        const left = Math.floor(col * drawSize / count)
        const top = Math.floor(row * drawSize / count)
        const right = Math.ceil((col + 1) * drawSize / count)
        const bottom = Math.ceil((row + 1) * drawSize / count)
        context.fillStyle = color
        context.fillRect(left, top, right - left, bottom - top)
    }
    context.draw()
}

const renderCanvas = (): Promise<void> => {
    if (error.value.length > 0 || cells.value.length == 0) {
        return Promise.resolve()
    }
    return initCanvas().then(() => {
        drawQrToCanvas()
    })
}

const exportImage = (options: UTSJSONObject): void => {
    renderCanvas().then(() => {
        const canvas = canvasContext.value
        if (canvas == null) {
            emitTempFileFail(options, 'Canvas is not ready')
            return
        }
        const path = canvas.toDataURL('image/png', 1)
        emitTempFileSuccess(options, path)
    }).catch((err: any | null) => {
        const message = err == null ? 'Canvas init failed' : err.toString()
        emitTempFileFail(options, message)
    })
}

const toTempFilePath = (options: UTSJSONObject): void => {
    if (error.value.length > 0 || cells.value.length == 0) {
        emitTempFileFail(options, 'up-qrcode content is not ready')
        return
    }
    exportImage(options)
}

const makeCode = (): void => {
    if (isEmpty(props.val)) {
        error.value = '二维码内容不能为空'
        cells.value = [] as Array<UTSJSONObject>
        emit('error', { message: error.value } as UTSJSONObject)
        return
    }
    try {
        loading.value = true
        error.value = ''
        cells.value = createQrCells(props.val, props.foreground, props.background, props.pdground, props.lv, props.quietZone)
        result.value = props.val
        loading.value = false
        nextTick(() => {
            renderCanvas()
        })
        emit('result', result.value)
    } catch (err) {
        loading.value = false
        const errObj = err as UTSJSONObject
        const message = errObj['message']
        error.value = message == null ? err.toString() : message.toString()
        cells.value = [] as Array<UTSJSONObject>
        emit('error', { message: error.value } as UTSJSONObject)
    }
}

const _makeCode = (): void => {
    makeCode()
}

const _clearCode = (): void => {
    cells.value = [] as Array<UTSJSONObject>
    result.value = ''
}

const preview = (e: UniPointerEvent): void => {
    emit('preview', {
        url: result.value
    } as UTSJSONObject, e)
}

const longpress = (): void => {
    toTempFilePath({
        success: (res: UTSJSONObject) => {
            emit('longpressCallback', res['tempFilePath'])
        },
        fail: (_: UTSJSONObject) => {
            emit('longpressCallback', result.value)
        }
    } as UTSJSONObject)
}

watch((): string => props.val, () => {
    if (props.onval) {
        makeCode()
    }
})
watch((): number => props.size, () => { makeCode() })
watch((): string => props.background, () => { makeCode() })
watch((): string => props.foreground, () => { makeCode() })
watch((): string => props.pdground, () => { makeCode() })

onMounted(() => {
    if (props.loadMake) {
        makeCode()
    }
})

defineExpose({
    rootId,
    cells,
    loading,
    result,
    error,
    canvasId,
    canvasContext,
    ctx,
    sizeLocal,
    rootStyle,
    matrixStyle,
    iconStyle,
    cellSize,
    canvasStyle,
    makeCode,
    _makeCode,
    _clearCode,
    preview,
    longpress,
    toTempFilePath,
    emitTempFileSuccess,
    emitTempFileFail,
    exportImage,
    renderCanvas,
    initCanvas,
    drawQrToCanvas
})
</script>

<style scoped lang="scss">
.up-qrcode {
    display: flex;
    position: relative;
}

.up-qrcode__matrix {
    position: relative;
    overflow: hidden;
}

.up-qrcode__canvas {
    position: absolute;
    left: 0;
    top: 0;
}

.up-qrcode__icon {
    position: absolute;
    border-radius: 4px;
    background-color: #ffffff;
}

.up-qrcode__loading {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.8);
}

.up-qrcode__error {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f8f8;
}

.up-qrcode__error-text {
    color: #fa3534;
    font-size: 14px;
}
</style>
