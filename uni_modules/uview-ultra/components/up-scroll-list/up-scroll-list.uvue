<template>
	<view
		class="up-scroll-list"
		ref="up-scroll-list"
	>
		<!-- #ifdef MP-WEIXIN || MP-QQ -->
		<!-- 以上平台，支持wxs -->
		<scroll-view
			class="up-scroll-list__scroll-view scroll-view-native"
			scroll-x
			enable-flex
			@scroll="wxs.scroll"
			@scrolltoupper="wxs.scrolltoupper"
			@scrolltolower="wxs.scrolltolower"
			:data-scrollWidth="scrollWidth"
			:data-barWidth="getPx(indicatorBarWidth)"
			:data-indicatorWidth="getPx(indicatorWidth)"
			:show-scrollbar="false"
			:upper-threshold="0"
			:lower-threshold="0"
		>
			<!-- #endif -->
			<!-- #ifndef MP-WEIXIN || MP-QQ -->
			<!-- 非以上平台，只能使用普通js实现 -->
			<scroll-view
				class="up-scroll-list__scroll-view scroll-view-js"
				direction="horizontal"
				@scroll="scrollHandler"
				@scrolltoupper="scrolltoupperHandler"
				@scrolltolower="scrolltolowerHandler"
				:show-scrollbar="false"
				:upper-threshold="0"
				:lower-threshold="0"
			>
				<!-- #endif -->
				<view class="up-scroll-list__scroll-view__content">
					<slot />
				</view>
			</scroll-view>
			<view
				class="up-scroll-list__indicator"
				v-if="indicator"
				:style="indicatorRootStyle"
			>
				<view
					class="up-scroll-list__indicator__line"
					:style="lineStyle"
				>
					<view
						class="up-scroll-list__indicator-line-bar"
						:style="barStyle"
						ref="up-scroll-list__indicator-line-bar"
					></view>
				</view>
			</view>
	</view>
</template>

<!-- #ifdef MP-WEIXIN || MP-QQ -->
<script
	src="./scrollWxs.wxs"
	module="wxs"
	lang="wxs"
></script>
<!-- #endif -->

<script setup lang="uts">
/**
 * scrollList 横向滚动列表
 * @description 该组件一般用于同时展示多个商品、分类的场景，也可以完成左右滑动的列表。
 * @tutorial https://uview-plus.jiangruyi.com/components/scrollList.html
 * @property {String | Number}	indicatorWidth			指示器的整体宽度 (默认 50 )
 * @property {String | Number}	indicatorBarWidth		滑块的宽度 (默认 20 )
 * @property {Boolean}			indicator				是否显示面板指示器 (默认 true )
 * @property {String}			indicatorColor			指示器非激活颜色 (默认 '#f2f2f2' )
 * @property {String}			indicatorActiveColor	指示器的激活颜色 (默认 '#3c9cff' )
 * @property {String | Object}	indicatorStyle			指示器样式，可通过bottom，left，right进行定位
 * @event {Function} left	滑动到左边时触发
 * @event {Function} right	滑动到右边时触发
 * @example
 */
import { computed, getCurrentInstance, onMounted, ref } from 'vue'
import defProps from './scrollList.uts'
import { addStyle, addUnit, getPx, sleep, upGetRect } from '../../libs/function/index.uts';

defineOptions({
	styleIsolation: 'app-and-page',
	name: 'up-scroll-list'
})

const props = defineProps({
	// 指示器的整体宽度
	indicatorWidth: {
		type: [String, Number],
		default: defProps.getAny('scrollList.indicatorWidth')
	},
	// 滑块的宽度
	indicatorBarWidth: {
		type: [String, Number],
		default: defProps.getAny('scrollList.indicatorBarWidth')
	},
	// 是否显示面板指示器
	indicator: {
		type: Boolean,
		default: defProps.getBoolean('scrollList.indicator')
	},
	// 指示器非激活颜色
	indicatorColor: {
		type: String,
		default: defProps.getString('scrollList.indicatorColor')
	},
	// 指示器的激活颜色
	indicatorActiveColor: {
		type: String,
		default: defProps.getString('scrollList.indicatorActiveColor')
	},
	// 指示器样式，可通过bottom，left，right进行定位
	indicatorStyle: {
		type: [String, Object],
		default: defProps.getAny('scrollList.indicatorStyle')
	}
})

const emit = defineEmits(['left', 'right'])
const instance = getCurrentInstance()!.proxy!
const scrollInfo = ref({
	scrollLeft: 0,
	scrollWidth: 0
} as UTSJSONObject)
const scrollWidth = ref(0)
const indicatorWidthValue = (): string | number => props.indicatorWidth != null ? props.indicatorWidth : 50
const indicatorBarWidthValue = (): string | number => props.indicatorBarWidth != null ? props.indicatorBarWidth : 20

const indicatorRootStyle = computed((): UTSJSONObject => {
	return addStyle(props.indicatorStyle) as UTSJSONObject
})

// 指示器为线型的样式
const barStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	// #ifndef MP-WEIXIN || MP-QQ
	// 此为普通js方案，只有在非nvue和不支持wxs方案的端才使用、
	// 此处的计算理由为：scroll-view的滚动距离与目标滚动距离(scroll-view的实际宽度减去包裹元素的宽度)之比，等于滑块当前移动距离与总需
	// 滑动距离(指示器的总宽度减去滑块宽度)的比值
	const scrollLeftValue = scrollInfo.value['scrollLeft']
	const scrollWidthInfo = scrollInfo.value['scrollWidth']
	const scrollLeft = scrollLeftValue != null ? parseFloat(scrollLeftValue.toString()) : 0
	const scrollWidthValue = scrollWidthInfo != null ? parseFloat(scrollWidthInfo.toString()) : 0
	const barAllMoveWidth = parseFloat(indicatorWidthValue().toString()) - parseFloat(indicatorBarWidthValue().toString())
	const x = scrollLeft / (scrollWidthValue - scrollWidth.value) * barAllMoveWidth
	style['transform'] = `translateX(${ x }px)`
	// #endif
	// 设置滑块的宽度和背景色，是每个平台都需要的
	style['width'] = addUnit(indicatorBarWidthValue())
	style['backgroundColor'] = props.indicatorActiveColor
	return style
})

const lineStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	// 指示器整体的样式，需要设置其宽度和背景色
	style['width'] = addUnit(indicatorWidthValue())
	style['backgroundColor'] = props.indicatorColor
	return style
})

const scrollEvent = (status: string): void => {
	if (status == 'left') {
		emit('left')
	} else if (status == 'right') {
		emit('right')
	}
}

const getComponentWidth = async (): Promise<void> => {
	// 延时一定时间，以获取dom尺寸
	await sleep(30)
	upGetRect('.up-scroll-list', false, instance).then((size: NodeInfo) => {
		scrollWidth.value = size.width ?? 0
	})
}

const init = (): void => {
	getComponentWidth()
}

// #ifndef APP-NVUE || MP-WEIXIN || H5 || APP-VUE || MP-QQ
// scroll-view触发滚动事件
const scrollHandler = (e: UniScrollEvent): void => {
	scrollInfo.value['scrollLeft'] = e.detail.scrollLeft
	scrollInfo.value['scrollWidth'] = e.detail.scrollWidth
}

const scrolltoupperHandler = (): void => {
	scrollEvent('left')
	scrollInfo.value['scrollLeft'] = 0
}

const scrolltolowerHandler = (): void => {
	scrollEvent('right')
	// 在普通js方案中，滚动到右边时，通过设置scrollInfo，模拟出滚动到右边的情况
	// 因为上方是用过computed计算的，设置后，会自动调整滑块的位置
	scrollInfo.value['scrollLeft'] = parseFloat(getPx(indicatorWidthValue().toString()))
		- parseFloat(getPx(indicatorBarWidthValue()))
}
// #endif

onMounted(() => {
	init()
})

defineExpose({
	scrollInfo,
	scrollWidth,
	indicatorRootStyle,
	barStyle,
	lineStyle,
	init,
	// #ifndef APP-NVUE || MP-WEIXIN || H5 || APP-VUE || MP-QQ
	scrollHandler,
	scrolltoupperHandler,
	scrolltolowerHandler,
	// #endif
	scrollEvent,
	getComponentWidth
})
</script>

<style lang="scss" scoped>
.up-scroll-list {
	padding-bottom: 10px;

	&__scroll-view {
		@include flex;
		// 缺少会在enable-flex模式下高度异常
		align-items: flex-start;

		&__content {
			@include flex;
		}
	}

	&__indicator {
		@include flex;
		justify-content: center;
		margin-top: 15px;

		&__line {
			width: 60px;
			height: 4px;
			border-radius: 100px;
			overflow: hidden;
		}
	}

	&__indicator-line-bar {
		width: 20px;
		height: 4px;
		border-radius: 100px;
	}
}
</style>
